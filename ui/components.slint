// PR Desk 基础组件库 — 纯矢量绘制，无外部资源；颜色全部取自 Theme 令牌
import { Theme } from "theme.slint";

// 圆形头像：img 有效时裁剪为圆形图片；否则显示 login 首字母。
// 无图底色：按 login 长度做稳定伪哈希，从 4 个主题色相中选 1 个，
// 底色为色相 15% 透明、文字为色相本体，明暗主题下均柔和可读。
export component Avatar inherits Rectangle {
    in property <string> login;
    in property <image> img;
    in property <length> size: 20px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    border-width: 1px;
    border-color: Theme.hairline;
    clip: true;

    property <bool> has-img: root.img.width > 0 && root.img.height > 0;
    property <[color]> palette: [Theme.accent, Theme.purple, Theme.good, Theme.mid];
    property <color> tone: root.palette[mod(root.login.character-count, 4)];

    background: root.has-img ? #00000000 : root.tone.with-alpha(0.15);

    if root.has-img: Image {
        width: 100%;
        height: 100%;
        source: root.img;
        image-fit: cover;
    }
    if !root.has-img: Rectangle {
        property <length> fs: root.size * 0.5;
        property <length> gw: fs * 0.62;  // 等宽字体单字宽 ≈ 0.6em，裁剪出首字母
        x: (parent.width - gw) / 2;
        width: gw;
        height: parent.height;
        clip: true;
        Text {
            height: parent.height;
            text: root.login.to-uppercase();
            font-family: "Consolas";
            font-size: fs;
            font-weight: 600;
            color: root.tone;
            wrap: no-wrap;
            vertical-alignment: center;
        }
    }
}

// CI/检查状态点：success 绿 / failure 红 / pending 黄 / 其他灰
export component StatusDot inherits Rectangle {
    in property <string> status;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.status == "success" ? Theme.good
        : root.status == "failure" ? Theme.bad
        : root.status == "pending" ? Theme.mid
        : Theme.text_dim;
}

// 评分徽章：>=8 绿 / >=6 黄 / 否则红；oversized 时显示灰底「超大」
export component ScoreChip inherits Rectangle {
    in property <float> score;
    in property <bool> oversized: false;

    property <color> tone: root.oversized ? Theme.text_dim
        : root.score >= 8 ? Theme.good
        : root.score >= 6 ? Theme.mid
        : Theme.bad;

    height: 18px;
    width: layout.preferred-width;
    border-radius: 9px;
    background: root.tone.with-alpha(0.14);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.35);

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.oversized ? "超大" : "" + (Math.round(root.score * 10) / 10);
            font-size: Theme.fs_xs;
            font-weight: 500;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 标签小胶囊
export component TagChip inherits Rectangle {
    in property <string> label;

    height: 18px;
    width: layout.preferred-width;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.surface2;

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: Theme.fs_xs;
            font-weight: 500;
            color: Theme.text_dim;
            vertical-alignment: center;
        }
    }
}

// PR 体积徽章：XS/S 绿、M 蓝、L 黄、XL 红，柔和底色 + 同色系文字
export component SizeBadge inherits Rectangle {
    in property <string> label;

    property <color> tone: root.label == "XS" || root.label == "S" ? Theme.good
        : root.label == "M" ? Theme.accent
        : root.label == "L" ? Theme.mid
        : Theme.bad;

    height: 18px;
    width: layout.preferred-width;
    border-radius: 9px;
    background: root.tone.with-alpha(0.14);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.35);

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: Theme.fs_xs;
            font-weight: 500;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 优先级标记：1 红 / 2 黄 / 3 蓝感叹号，0 不显示（且不占布局宽度）
export component PriorityDot inherits Text {
    in property <int> priority: 0;

    text: root.priority > 0 ? "!" : "";
    width: root.priority > 0 ? 10px : 0px;
    font-size: Theme.fs_sm;
    font-weight: 800;
    horizontal-alignment: center;
    vertical-alignment: center;
    color: root.priority == 1 ? Theme.bad
        : root.priority == 2 ? Theme.mid
        : Theme.accent;
}

// 图标按钮：28x28，圆角 6px，hover 用 Theme.hover（100ms 过渡），tooltip 悬停 450ms 后浮现。
// 注意：tooltip 画在组件自身上方（y 为负），依赖祖先不 clip，且可能被后绘制的同级覆盖。
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.r_md;
    background: touch.has-hover ? Theme.hover : #00000000;
    animate background { duration: 100ms; }

    property <bool> show-tip: false;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (!self.has-hover) { root.show-tip = false; }
        }
    }

    Text {
        text: root.icon;
        font-size: Theme.fs_md;
        color: touch.has-hover ? Theme.text : Theme.text_dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 100ms; }
    }

    tip-timer := Timer {
        interval: 450ms;
        running: touch.has-hover && root.tooltip != "" && !root.show-tip;
        triggered => { root.show-tip = true; }
    }

    if root.show-tip && touch.has-hover: Rectangle {
        x: (root.width - tip.preferred-width) / 2;
        y: -30px;
        width: tip.preferred-width;
        height: 22px;
        border-radius: Theme.r_sm;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        tip := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: root.tooltip;
                font-size: Theme.fs_xs;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
    }
}

// 胶囊分段控件单元：active 用 Theme.sel 底 + sel_text 字，否则透明底 dim 字，hover 微亮
export component PillTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 24px;
    width: layout.preferred-width;
    border-radius: 12px;
    background: root.active ? Theme.sel : touch.has-hover ? Theme.hover : #00000000;
    animate background { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: Theme.fs_sm;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.sel_text : touch.has-hover ? Theme.text : Theme.text_dim;
            vertical-alignment: center;
            animate color { duration: 100ms; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Markdown 结构化块：Rust 端把评论正文解析成块数组，MarkdownBlocks 逐块渲染。
// kind 取值："h1".."h6" | "p" | "code" | "bullet" | "num" | "table" | "quote" | "hr"
export struct MdBlock {
    kind: string,
    text: string,      // 段落/代码/列表项/引用 的文字
    lang: string,      // code 的语言标注
    depth: int,        // 列表嵌套层级（0 起）
    cols: int,         // table 列数
    cells: [string],   // table：先 cols 个表头，再逐行扁平化
}

// Markdown 块流式渲染：VerticalLayout 逐块排布（块间 8px），宽度铺满父级、高度取内容。
// 供放进现有 Flickable/ScrollView/ListView 代理内使用，自身不产生纵向滚动。
export component MarkdownBlocks inherits VerticalLayout {
    in property <[MdBlock]> blocks;
    // 可用宽度：所有换行 Text 的宽度必须来自显式属性绑定而不是布局求解器分配，
    // 否则 preferred-height 会在宽度未约束时被缓存，导致外层条目高度算小、内容溢出重叠。
    in property <length> w: 100px;

    spacing: 8px;
    alignment: start;

    for b in root.blocks: VerticalLayout {
        alignment: start;

        // h1/h2：15/14px 加粗 + 底部 hairline
        if b.kind == "h1" || b.kind == "h2": VerticalLayout {
            spacing: 4px;
            alignment: start;
            Text {
                text: b.text;
                width: root.w;
                font-size: b.kind == "h1" ? 15px : 14px;
                font-weight: 700;
                color: Theme.text;
                wrap: word-wrap;
            }
            Rectangle {
                height: 1px;
                background: Theme.hairline;
            }
        }

        // h3-h6：13px 加粗
        if b.kind == "h3" || b.kind == "h4" || b.kind == "h5" || b.kind == "h6": Text {
            text: b.text;
            width: root.w;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }

        // 段落：13px，必须换行（此前裸文本不换行被裁的 bug 由此修复）
        if b.kind == "p": Text {
            text: b.text;
            width: root.w;
            font-size: 13px;
            color: Theme.text;
            wrap: word-wrap;
        }

        // 代码块：surface2 底 + 圆角 + 内边距，等宽 12px，不换行、横向可滚动
        if b.kind == "code": Rectangle {
            border-radius: Theme.r_md;
            background: Theme.surface2;
            clip: true;
            height: code_txt.preferred-height + 16px;

            Flickable {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                content-width: max(code_txt.preferred-width, self.width);
                content-height: code_txt.preferred-height;

                code_txt := Text {
                    text: b.text;
                    font-family: "Consolas";
                    font-size: 12px;
                    color: Theme.text;
                }
            }

            // 语言标注（右上角 dim 小字）
            if b.lang != "": Text {
                x: parent.width - self.preferred-width - 10px;
                y: 5px;
                text: b.lang;
                font-size: Theme.fs_xs;
                color: Theme.text_faint;
            }
        }

        // 无序/有序列表项：按 depth 每级缩进 16px；bullet 前缀 "•"，num 编号已含在 text 里
        if b.kind == "bullet" || b.kind == "num": Rectangle {
            height: item_row.preferred-height;
            item_row := HorizontalLayout {
                padding-left: b.depth * 16px;
                spacing: 6px;
                alignment: start;
                bull := Text {
                    text: b.kind == "bullet" ? "•" : "";
                    width: b.kind == "bullet" ? self.preferred-width : 0px;
                    font-size: 13px;
                    color: Theme.text_dim;
                }
                Text {
                    text: b.text;
                    width: max(0px, root.w - b.depth * 16px - (b.kind == "bullet" ? bull.preferred-width + 6px : 0px));
                    font-size: 13px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }

        // 表格：cells 先 cols 个表头再逐行扁平化；等宽单元格 + hairline 分隔，表头 surface2 底加粗
        if b.kind == "table" && b.cols > 0: Rectangle {
            property <int> tcols: max(1, b.cols);
            property <int> trows: b.cells.length / tcols;

            border-radius: Theme.r_md;
            border-width: 1px;
            border-color: Theme.hairline;
            background: Theme.card;
            clip: true;
            height: tbl.preferred-height;

            tbl := VerticalLayout {
                alignment: start;
                for r in trows: Rectangle {
                    height: trow.preferred-height;
                    background: r == 0 ? Theme.surface2 : transparent;

                    trow := HorizontalLayout {
                        for c in tcols: Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            VerticalLayout {
                                padding: 6px;
                                Text {
                                    text: b.cells[r * tcols + c];
                                    width: max(0px, root.w / tcols - 12px);
                                    font-size: 12px;
                                    font-weight: r == 0 ? 600 : 400;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                            // 单元格右缘分隔线（末列不画）
                            if c < tcols - 1: Rectangle {
                                x: parent.width - 1px;
                                y: 0;
                                width: 1px;
                                height: 100%;
                                background: Theme.hairline;
                            }
                        }
                    }

                    // 行间分隔线（末行不画）
                    if r < trows - 1: Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Theme.hairline;
                    }
                }
            }
        }

        // 引用：左缘 3px accent 竖条 + 缩进，文字弱化
        if b.kind == "quote": Rectangle {
            height: quote_txt.preferred-height;
            Rectangle {
                x: 0;
                y: 0;
                width: 3px;
                height: 100%;
                border-radius: 1.5px;
                background: Theme.accent;
            }
            quote_txt := Text {
                x: 12px;
                y: 0;
                width: max(0px, root.w - 12px);
                text: b.text;
                font-size: 13px;
                color: Theme.text_faint;
                wrap: word-wrap;
            }
        }

        // 水平分割线
        if b.kind == "hr": Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
    }
}

// 空状态：居中图标字符 + 主文案 + 副提示（占满父级区域）
export component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> hint;

    background: #00000000;

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 24px;
        Text {
            text: root.icon;
            font-size: 28px;
            color: Theme.text_dim;
            horizontal-alignment: center;
        }
        Text {
            text: root.title;
            font-size: Theme.fs_md;
            font-weight: 500;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            font-size: Theme.fs_sm;
            color: Theme.text_dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
