// PR Desk 基础组件库 — GitHub Dark 风格，纯矢量绘制，无外部资源
import { Theme } from "theme.slint";

// 圆形头像：img 有效时裁剪为圆形图片；否则显示 login 首字母的彩色字母头像。
// 注：Slint 无字符串索引/子串，首字母用「单字宽裁剪窗 + Consolas 等宽字体」实现，
// 色相用 login.character-count 做稳定伪哈希（同一 login 颜色固定）。
export component Avatar inherits Rectangle {
    in property <string> login;
    in property <image> img;
    in property <length> size: 20px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    clip: true;

    property <bool> has-img: root.img.width > 0 && root.img.height > 0;
    // GitHub 深色系高饱和底色，白字对比度好
    property <[color]> palette: [#1f6feb, #8957e5, #bf3989, #cf222e, #9a6700, #1a7f37, #0969da, #8250df];
    background: root.has-img ? #00000000 : root.palette[mod(root.login.character-count, 8)];

    if root.has-img: Image {
        width: 100%;
        height: 100%;
        source: root.img;
        image-fit: cover;
    }
    if !root.has-img: Rectangle {
        property <length> fs: root.size * 0.5;
        property <length> gw: fs * 0.62;  // Consolas 单字宽 ≈ 0.6em
        x: (parent.width - gw) / 2;
        width: gw;
        height: parent.height;
        clip: true;
        Text {
            height: parent.height;
            text: root.login.to-uppercase();
            font-family: "Consolas";
            font-size: fs;
            font-weight: 700;
            color: #ffffff;
            wrap: no-wrap;
            vertical-alignment: center;
        }
    }
}

// CI/检查状态点：success 绿 / failure 红 / pending 黄 / 其他灰
export component StatusDot inherits Rectangle {
    in property <string> status;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.status == "success" ? Theme.good
        : root.status == "failure" ? Theme.bad
        : root.status == "pending" ? Theme.mid
        : #6e7681;
}

// 评分徽章：>=8 绿 / >=6 黄 / 否则红；oversized 时显示灰底「超大」
export component ScoreChip inherits Rectangle {
    in property <float> score;
    in property <bool> oversized: false;

    property <color> tone: root.oversized ? #6e7681
        : root.score >= 8 ? Theme.good
        : root.score >= 6 ? Theme.mid
        : Theme.bad;

    height: 18px;
    width: layout.preferred-width;
    border-radius: 9px;
    background: root.tone.with-alpha(0.15);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);

    layout := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.oversized ? "超大" : "" + (Math.round(root.score * 10) / 10);
            font-size: 11px;
            font-weight: 700;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 标签小胶囊
export component TagChip inherits Rectangle {
    in property <string> label;

    height: 18px;
    width: layout.preferred-width;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: 11px;
            color: Theme.text_dim;
            vertical-alignment: center;
        }
    }
}

// PR 体积徽章：XS/S 绿、M 蓝、L 黄、XL 红，彩底白字
export component SizeBadge inherits Rectangle {
    in property <string> label;

    property <color> tone: root.label == "XS" || root.label == "S" ? Theme.good
        : root.label == "M" ? Theme.accent
        : root.label == "L" ? Theme.mid
        : Theme.bad;

    height: 16px;
    width: layout.preferred-width;
    border-radius: 3px;
    background: root.tone;

    layout := HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 700;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}

// 优先级标记：1 红 / 2 黄 / 3 蓝感叹号，0 不显示（且不占布局宽度）
export component PriorityDot inherits Text {
    in property <int> priority: 0;

    text: root.priority > 0 ? "!" : "";
    width: root.priority > 0 ? 10px : 0px;
    font-size: 12px;
    font-weight: 800;
    horizontal-alignment: center;
    vertical-alignment: center;
    color: root.priority == 1 ? Theme.bad
        : root.priority == 2 ? Theme.mid
        : Theme.accent;
}
