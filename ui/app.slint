// PR Desk — 主窗口（组装 theme/components/pr_list/drawer/diff_view）
// 键盘：PrListView 自带 j/k/↑↓/Enter/Esc；外层 FocusScope 只处理 p/1/2/3
// （事件先到 PrListView，reject 后冒泡到外层）。
import { Button, LineEdit, TextEdit, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PrListView, PrListRow, PrGroup } from "pr_list.slint";
import { DetailDrawer } from "drawer.slint";
import { DiffView, DiffFile, DiffLine } from "diff_view.slint";

// 类型再导出：slint-build 从本文件生成 Rust 绑定
export { PrListRow, PrGroup, DiffFile, DiffLine }

export component MainWindow inherits Window {
    title: "PR Desk";
    preferred-width: 1150px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 480px;

    in property <[PrListRow]> rows: [];
    in-out property <[PrGroup]> groups: [];
    in property <string> status_text: "就绪";
    // 抽屉
    in property <bool> d_open: false;
    in property <string> d_title: "";
    in property <string> d_subtitle: "";
    in property <string> d_body: "";
    in property <string> d_convo: "";
    in property <string> d_checks: "";
    in property <string> d_files: "";
    in property <int> d_priority: 0;
    // diff
    in property <[DiffFile]> diff_files: [];
    in property <string> diff_hint: "选择 PR 后在此查看 diff";

    callback refresh();
    callback sync_now();
    callback row_activated(int);
    callback row_pin(int);
    callback row_reject(int);
    callback row_board(int);
    callback drawer_close();
    callback drawer_requeue();
    callback drawer_reject();
    callback drawer_set_priority(int);
    callback diff_file_toggled(int);
    callback key_pin();
    callback key_priority(int);
    // 设置页
    callback open_settings();
    callback save_settings(string, string, string, string, string);
    in-out property <bool> settings_open: false;
    in-out property <string> s_server: "";
    in-out property <string> s_sync_token: "";
    in-out property <string> s_gh_token: "";
    in-out property <string> s_repos: "";
    in-out property <int> s_poll: 5;
    in property <bool> onboarding: false;   // 未配置（首启引导）
    in property <bool> gh_token_from_env: false;  // GITHUB_TOKEN 环境变量优先提示

    forward-focus: keys;

    VerticalLayout {
        // 顶栏
        Rectangle {
            height: 38px;
            background: Theme.card;
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                Text {
                    text: "PR Desk";
                    color: Theme.text;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { width: 8px; }
                Button { text: "刷新 GitHub"; clicked => { root.refresh(); } }
                Button { text: "同步服务器"; clicked => { root.sync_now(); } }
                Button { text: "⚙ 设置"; clicked => { root.open_settings(); } }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.status_text;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // 主区：左列表 + 右 diff（抽屉打开时覆盖右侧）
        keys := FocusScope {
            key-pressed(event) => {
                if (event.text == "p") { root.key_pin(); return accept; }
                if (event.text == "1") { root.key_priority(1); return accept; }
                if (event.text == "2") { root.key_priority(2); return accept; }
                if (event.text == "3") { root.key_priority(3); return accept; }
                reject
            }

            HorizontalLayout {
                list := PrListView {
                    width: 58%;
                    rows: root.rows;
                    groups: root.groups;
                    row_activated(i) => { root.row_activated(i); }
                    row_pin(i) => { root.row_pin(i); }
                    row_reject(i) => { root.row_reject(i); }
                    row_board(i) => { root.row_board(i); }
                    dismissed => { root.drawer_close(); }
                }
                Rectangle { width: 1px; background: Theme.border; }
                DiffView {
                    files: root.diff_files;
                    file_toggled(i) => { root.diff_file_toggled(i); }
                }
            }
        }
    }

    // 详情抽屉：窗口顶层直接子元素、位于其它内容之后（不放进 Layout）
    DetailDrawer {
        open: root.d_open;
        title: root.d_title;
        subtitle: root.d_subtitle;
        body_html_free_text: root.d_body;
        convo_text: root.d_convo;
        checks_text: root.d_checks;
        files_text: root.d_files;
        current_priority: root.d_priority;
        close => { root.drawer_close(); }
        action_requeue => { root.drawer_requeue(); }
        action_toggle_reject => { root.drawer_reject(); }
        action_set_priority(p) => { root.drawer_set_priority(p); }
    }

    // 首启引导：未配置时盖住列表区，引导打开设置
    if root.onboarding && !root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg.with-alpha(0.96);
        TouchArea {}  // 拦截点击
        Rectangle {
            width: 460px;
            height: 240px;
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 28px;
                spacing: 12px;
                alignment: center;
                Text {
                    text: "👋 欢迎使用 PR Desk";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "还没有配置服务器与仓库。\n打开设置，填入服务器地址、token 和要关注的仓库即可开始。";
                    color: Theme.text-dim;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Button {
                    text: "打开设置";
                    clicked => { root.open_settings(); }
                }
            }
        }
    }

    // 设置页（模态，顶层）
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea {}  // 拦截点击穿透
        Rectangle {
            width: 520px;
            height: 470px;
            background: Theme.card;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: "设置";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text { text: "服务器地址"; color: Theme.text-dim; font-size: 12px; }
                LineEdit {
                    text <=> root.s_server;
                    placeholder-text: "http://127.0.0.1:6185（AstrBot 地址）";
                }
                Text { text: "sync_token（插件配置里的同步令牌）"; color: Theme.text-dim; font-size: 12px; }
                LineEdit {
                    text <=> root.s_sync_token;
                    input-type: password;
                    placeholder-text: "留空 = 同步关闭";
                }
                Text {
                    text: root.gh_token_from_env
                        ? "GitHub token（已检测到 GITHUB_TOKEN 环境变量，环境变量优先）"
                        : "GitHub token";
                    color: Theme.text-dim;
                    font-size: 12px;
                }
                LineEdit {
                    text <=> root.s_gh_token;
                    input-type: password;
                    placeholder-text: root.gh_token_from_env ? "环境变量生效中，此处可留空" : "公开仓库可留空（限速更低）";
                }
                Text { text: "仓库列表（每行一个 owner/repo）"; color: Theme.text-dim; font-size: 12px; }
                TextEdit {
                    text <=> root.s_repos;
                    min-height: 90px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "轮询间隔（分钟）"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    SpinBox { value <=> root.s_poll; minimum: 1; maximum: 120; }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => { root.settings_open = false; }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.save_settings(root.s_server, root.s_sync_token, root.s_gh_token, root.s_repos, "" + root.s_poll);
                            root.settings_open = false;
                        }
                    }
                }
            }
        }
    }
}
