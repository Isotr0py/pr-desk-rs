// PR Desk — 主窗口（组装 topbar/pr_list/detail_panel/diff_view + 设置弹窗/首启引导）
// 键盘：PrListView 管 j/k/↑↓/Enter/Esc（reject 冒泡）；外层 FocusScope 接 p/1/2/3 和 /。
// Esc 语义（见 dismissed）：详情开着 → 关详情；否则取消选中。
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";
import { TopBar, StatusBar } from "topbar.slint";
import { PrListView, PrListRow, PrGroup } from "pr_list.slint";
import { DetailPanel, ConvoEntry, CheckRun, FileChange, OcrComment, DimScore } from "detail_panel.slint";
import { DiffFile, DiffLine } from "diff_view.slint";
import { InboxView, NotifRow, NotifPreview } from "inbox.slint";
import { MdBlock } from "components.slint";

// 类型再导出：slint-build 从本文件生成 Rust 绑定
export { PrListRow, PrGroup, ConvoEntry, CheckRun, FileChange, DiffFile, DiffLine, NotifRow, OcrComment, DimScore, MdBlock }

// ── 表单输入框：30px 高、surface2 底无边框，聚焦时 accent 描边 ──
component FormField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    in property <bool> password: false;
    in property <bool> enabled: true;   // false = 禁用（本地档案时锁服务器字段）
    callback accepted();                // Enter 确认（新档案名输入用）
    public function focus_input() { input.focus(); }

    height: 30px;
    border-radius: Theme.r_md;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: root.enabled ? Theme.surface2 : Theme.surface2.with-alpha(0.5);
    animate border-width { duration: 120ms; }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        font-size: Theme.fs_md;
        color: root.enabled ? Theme.text : Theme.text_faint;
        enabled: root.enabled;
        input-type: root.password ? InputType.password : InputType.text;
        accepted => { root.accepted(); }
    }

    // 占位提示（空内容时显示，不拦截点击）
    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.placeholder;
        color: Theme.text_faint;
        font-size: Theme.fs_md;
        vertical-alignment: center;
    }
}

// ── 多行输入框（仓库列表），样式与 FormField 对齐 ──
component FormArea inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";

    height: 88px;
    border-radius: Theme.r_md;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: Theme.surface2;
    clip: true;
    animate border-width { duration: 120ms; }

    Flickable {
        x: 10px;
        y: 7px;
        width: parent.width - 20px;
        height: parent.height - 14px;
        viewport-width: self.width;
        viewport-height: input.preferred-height;
        input := TextInput {
            width: parent.width;
            wrap: word-wrap;
            font-size: Theme.fs_md;
            color: Theme.text;
        }
    }

    if root.text == "": Text {
        x: 10px;
        y: 7px;
        width: parent.width - 20px;
        text: root.placeholder;
        color: Theme.text_faint;
        font-size: Theme.fs_md;
        wrap: word-wrap;
    }
}

// ── 表单分组：11px faint 小字标签在上，控件在下，间距 4px ──
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text {
        text: root.label;
        color: Theme.text_faint;
        font-size: Theme.fs_xs;
    }
    @children
}

// ── 对话框按钮：primary = accent 实心白字（主按钮唯一例外），否则幽灵按钮（透明底、无描边、hover surface2）──
component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <length> button-width: 72px;
    callback clicked();

    width: root.button-width;
    height: 30px;
    border-radius: Theme.r_md;
    background: root.primary
        ? (ta.has-hover ? Theme.accent.darker(1.08) : Theme.accent)
        : (ta.has-hover ? Theme.surface2 : transparent);
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        color: root.primary ? #ffffff : Theme.text;
        font-size: Theme.fs_md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── 数字步进器：自绘（SpinBox 在本环境的样式下不渲染，故不用它）──
component NumStepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 1;
    in property <int> maximum: 99;

    width: 108px;
    height: 30px;
    border-radius: Theme.r_md;
    background: Theme.surface2;
    clip: true;

    Rectangle {
        x: 0; y: 0; width: 32px; height: 100%;
        background: ta_minus.has-hover && root.value > root.minimum ? Theme.hover : transparent;
        ta_minus := TouchArea {
            mouse-cursor: root.value > root.minimum ? pointer : default;
            clicked => { root.value = max(root.minimum, root.value - 1); }
        }
        Text {
            text: "-";
            color: root.value > root.minimum ? Theme.text : Theme.text_faint;
            font-size: Theme.fs_md;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 32px; width: parent.width - 64px; height: 100%;
        text: root.value;
        color: Theme.text;
        font-size: Theme.fs_md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 32px; y: 0; width: 32px; height: 100%;
        background: ta_plus.has-hover && root.value < root.maximum ? Theme.hover : transparent;
        ta_plus := TouchArea {
            mouse-cursor: root.value < root.maximum ? pointer : default;
            clicked => { root.value = min(root.maximum, root.value + 1); }
        }
        Text {
            text: "+";
            color: root.value < root.maximum ? Theme.text : Theme.text_faint;
            font-size: Theme.fs_md;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // 中缝分隔线
    Rectangle { x: 32px; y: 6px; width: 1px; height: parent.height - 12px; background: Theme.hairline; }
    Rectangle { x: parent.width - 33px; y: 6px; width: 1px; height: parent.height - 12px; background: Theme.hairline; }
}

export component MainWindow inherits Window {
    title: I18n.app_name;
    // 窗口图标：内嵌 SVG（默认图标在本机字体环境下标题栏显示为豆腐块）
    icon: @image-url("icons/app.svg");
    // 中英混排字体：雅黑 UI（中英都覆盖，CJK 渲染稳定清晰）。
    // 注意 Slint 的 default-font-family 只支持单一字体名（不支持逗号分隔的 fallback 列表，
    // 写列表会被当成一个字面字体名去查找、查不到就走系统兜底，CJK 字宽全乱）
    default-font-family: "Microsoft YaHei UI";
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 480px;
    background: Theme.bg;

    // ── 主题（dark_mode 写回 Theme 并通知 Rust 持久化）──
    in-out property <bool> dark_mode: Theme.dark;
    callback theme_toggled(bool);
    changed dark_mode => {
        Theme.dark = root.dark_mode;
        root.theme_toggled(root.dark_mode);
    }

    // ── 语言（language 写回 I18n 并通知 Rust 持久化，仿 dark_mode）──
    in-out property <string> language: "zh";   // "zh" | "en"
    callback language_changed(string);
    changed language => {
        I18n.lang = root.language;
        root.language_changed(root.language);
    }

    // ── 字号档位（写回 Theme.fs_scale 并通知 Rust 持久化，仿 language）──
    in-out property <float> font_scale: 1.0;   // 0.9 小 / 1.0 标准 / 1.15 大
    callback font_scale_changed(float);
    changed font_scale => {
        Theme.fs_scale = root.font_scale;
        root.font_scale_changed(root.font_scale);
    }

    // ── 列表 ──
    in property <[PrListRow]> rows: [];
    // 选中行身份（repo#number）：Rust 侧重建列表后回写，高亮跟随 PR 而非下标
    in-out property <string> selected_key: "";
    in-out property <[PrGroup]> groups: [];
    in-out property <string> filter_text: "";
    in-out property <int> view_mode: 0;      // 0=列表 1=Inbox（TopBar 分段控件，唯一一套视图切换）
    in-out property <string> sort_mode: "updated";   // 组内排序：updated / score / changes
    in-out property <bool> high_score_only: false;   // true = 只看评分 ≥8.0
    // ── 状态栏 ──
    in property <string> sb_sync: "";
    in property <string> sb_quota: "";
    in property <int> sb_total: 0;
    // ── 详情面板 ──
    in property <bool> d_open: false;
    in property <string> d_title: "";
    in property <string> d_author: "";
    in property <image> d_avatar;
    in property <string> d_state: "open";
    in property <string> d_ci: "";
    in property <string> d_opened: "";
    in property <string> d_updated: "";
    in property <string> d_body: "";
    in property <int> d_priority: 0;
    in property <bool> d_pinned: false;
    in property <bool> d_on_board: false;
    in property <[ConvoEntry]> d_convo: [];
    in property <[CheckRun]> d_checks: [];
    in property <[FileChange]> d_files: [];
    in property <[DiffFile]> diff_files: [];
    // ── 详情面板·评审报告 ──
    in property <string> d_review_status: "";          // "" / running / done / failed
    in property <string> d_review_progress: "";
    in property <bool> d_review_has: false;
    in property <float> d_review_score: 0;
    in property <[DimScore]> d_review_dimensions: [];
    in property <string> d_review_size_line: "";
    in property <string> d_review_summary: "";
    in property <[MdBlock]> d_review_summary_blocks: [];
    in property <[string]> d_review_flagged: [];
    in property <string> d_review_reviewed_at: "";
    in property <[OcrComment]> d_review_comments: [];   // OCR 行级评论明细
    // ── Inbox（GitHub 通知）──
    in property <[NotifRow]> inbox_rows: [];
    in property <bool> inbox_needs_token: false;
    in-out property <bool> inbox_unread_only: false;
    // 仓库过滤：repos 由 Rust 侧按当前通知去重给出；repo_filter "" = 全部
    in property <[string]> inbox_repos: [];
    in-out property <string> inbox_repo_filter: "";
    // 分页：还有下一页 / 下一页加载中
    in property <bool> inbox_has_more: false;
    in property <bool> inbox_loading_more: false;
    // ── Inbox 预览面板 ──
    in property <bool> inbox_detail_open: false;
    in property <string> nd_title: "";
    in property <string> nd_kind: "";
    in property <string> nd_state: "";
    in property <bool> nd_added: false;
    in property <bool> nd_loading: false;
    in property <[ConvoEntry]> nd_convo: [];
    in property <[FileChange]> nd_files: [];
    in property <[DiffFile]> nd_diff_files: [];

    callback refresh();
    callback sync_now();
    callback open_settings();
    callback filter_changed(string);
    callback sort_changed(string);          // 组内排序方式变化（updated/score/changes）
    callback high_score_toggled(bool);      // 高分快筛开关（只看 ≥8.0）
    callback row_activated(int);
    callback row_pin(int);
    callback row_reject(int);
    callback row_board(int);
    callback row_open(int);         // 行内外链按钮：浏览器打开
    callback key_open();            // o 快捷键：浏览器打开选中 PR
    callback panel_tab_changed(int);   // 详情面板 tab 切换（惰性拉取对应数据）
    callback panel_close();
    callback panel_board();
    callback panel_set_priority(int);
    callback panel_toggle_pin();
    callback action_run_review();
    callback action_copy_review();
    callback diff_file_toggled(int);
    callback inbox_activated(int);
    callback inbox_add_review(int);
    callback inbox_mark_all_read();
    callback inbox_filter_toggled(bool);
    callback inbox_open_browser();
    callback inbox_close_detail();
    callback inbox_diff_toggled(int);
    callback inbox_load_more();         // 「加载更多」：拉下一页通知追加
    callback fetch_inbox();             // 切到 Inbox 分段时拉取通知
    callback key_pin();
    callback key_priority(int);
    // 设置页（顺序：server_url, sync_token, github_token, repos, poll_interval, llm_base_url, llm_api_key, llm_model, ocr_path, review_concurrency, astrbot_api_key）
    callback save_settings(string, string, string, string, string, string, string, string, string, string, string);
    // 设置页「获取」模型列表（参数为弹窗里正在编辑的 base_url / api_key）
    callback fetch_models(string, string);
    // 拉取到的模型 id 列表（非空时模型名下方出现选择列表）
    in property <[string]> model_list: [];
    // 模型选择列表展开状态（拉取成功默认展开，可折叠）
    in-out property <bool> model_list_open: true;
    in-out property <bool> settings_open: false;
    in-out property <int> settings_tab: 0;   // 0=数据源 1=通用 2=LLM 预评审
    in-out property <string> s_server: "";
    in-out property <string> s_sync_token: "";
    in-out property <string> s_ak: "";
    in-out property <string> s_gh_token: "";
    in-out property <string> s_repos: "";
    in-out property <int> s_poll: 5;
    in-out property <int> s_review_concurrency: 3;
    in-out property <string> s_review_prompt: "";
    in-out property <string> s_llm_base: "";
    in-out property <string> s_llm_key: "";
    in-out property <string> s_llm_model: "";
    in-out property <string> s_ocr_path: "";
    in property <bool> onboarding: false;   // 未配置（首启引导）
    in property <bool> gh_token_from_env: false;  // GITHUB_TOKEN 环境变量优先提示

    // ── 数据源档案（本地 / 多远程服务器）──
    in property <[string]> profile_names: [];    // 第一个恒为 "local"，然后 "default"、自定义名
    in-out property <string> active_profile: "local";
    callback switch_profile(string);
    callback profile_add(string);      // 参数为新档案名（Rust 侧校验）
    callback profile_remove(string);
    // 设置弹窗当前编辑的档案：变化时回调 settings_profile_focus，
    // Rust 把该档案的值回填进 s_server / s_sync_token / s_ak；save_settings 按当前档案写回。
    // Rust 侧可在 profile_add / profile_remove 后直接写本属性（in-out），changed 会自动触发回填。
    in-out property <string> settings_profile: "local";
    callback settings_profile_focus(string);
    // 正在编辑 local 档案（锁服务器三字段）
    property <bool> editing_local: root.settings_profile == "local";
    // 档案选择行的「+」输入模式（内联输入新档案名）
    property <bool> adding_profile: false;

    // 顶栏搜索框内容变化（双向绑定）→ 通知 Rust 重建过滤视图
    changed filter_text => { root.filter_changed(root.filter_text); }
    // 切到 Inbox 分段时拉一次通知
    changed view_mode => { if (root.view_mode == 1) { root.fetch_inbox(); } }
    // 档案选择器切换 → 通知 Rust 回填该档案的服务器字段
    changed settings_profile => { root.settings_profile_focus(root.settings_profile); }

    VerticalLayout {
        topbar := TopBar {
            filter_text <=> root.filter_text;
            view_mode <=> root.view_mode;
            profile_names: root.profile_names;
            active_profile <=> root.active_profile;
            switch_profile(n) => { root.switch_profile(n); }
            sort_mode <=> root.sort_mode;
            high_score_only <=> root.high_score_only;
            sort_changed(m) => { root.sort_changed(m); }
            high_score_toggled(on) => { root.high_score_toggled(on); }
            refresh => { root.refresh(); }
            sync => { root.sync_now(); }
            open_settings => { root.open_settings(); }
        }

        keys := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                if (event.text == "p") { root.key_pin(); return accept; }
                if (event.text == "o") { root.key_open(); return accept; }
                if (event.text == "1") { root.key_priority(1); return accept; }
                if (event.text == "2") { root.key_priority(2); return accept; }
                if (event.text == "3") { root.key_priority(3); return accept; }
                if (event.text == "/") { topbar.focus_search(); return accept; }
                reject  // j/k/Enter/Esc 冒泡给 PrListView 内部处理
            }

            if root.view_mode == 0: HorizontalLayout {
                list := PrListView {
                    horizontal-stretch: 1;
                    rows: root.rows;
                    groups: root.groups;
                    selected_key <=> root.selected_key;
                    row_activated(i) => { root.row_activated(i); }
                    row_pin(i) => { root.row_pin(i); }
                    row_reject(i) => { root.row_reject(i); }
                    row_board(i) => { root.row_board(i); }
                    row_open(i) => { root.row_open(i); }
                    dismissed => {
                        if (root.d_open) { root.panel_close(); } else { self.selected_index = -1; self.selected_key = ""; }
                    }
                }
                DetailPanel {
                    visible: root.d_open;
                    max_panel_width: root.width * 0.6;
                    title: root.d_title;
                    author: root.d_author;
                    avatar: root.d_avatar;
                    state: root.d_state;
                    ci: root.d_ci;
                    opened: root.d_opened;
                    updated: root.d_updated;
                    body: root.d_body;
                    priority: root.d_priority;
                    pinned: root.d_pinned;
                    on_board: root.d_on_board;
                    convo_entries: root.d_convo;
                    check_runs: root.d_checks;
                    files: root.d_files;
                    diff_files: root.diff_files;
                    review_status: root.d_review_status;
                    review_progress: root.d_review_progress;
                    review_has: root.d_review_has;
                    review_score: root.d_review_score;
                    review_dimensions: root.d_review_dimensions;
                    review_size_line: root.d_review_size_line;
                    review_summary: root.d_review_summary;
                    review_summary_blocks: root.d_review_summary_blocks;
                    review_flagged: root.d_review_flagged;
                    review_reviewed_at: root.d_review_reviewed_at;
                    review_comments: root.d_review_comments;
                    close => { root.panel_close(); }
                    action_board => { root.panel_board(); }
                    action_set_priority(p) => { root.panel_set_priority(p); }
                    action_toggle_pin => { root.panel_toggle_pin(); }
                    action_run_review => { root.action_run_review(); }
                    action_copy_review => { root.action_copy_review(); }
                    diff_file_toggled(i) => { root.diff_file_toggled(i); }
                    tab_changed(t) => { root.panel_tab_changed(t); }
                }
            }
            if root.view_mode == 1: HorizontalLayout {
                inbox := InboxView {
                    horizontal-stretch: 1;
                    rows: root.inbox_rows;
                    needs_token: root.inbox_needs_token;
                    detail_open: root.inbox_detail_open;
                    unread_only <=> root.inbox_unread_only;
                    repos: root.inbox_repos;
                    repo_filter <=> root.inbox_repo_filter;
                    has_more: root.inbox_has_more;
                    loading_more: root.inbox_loading_more;
                    row_activated(i) => { root.inbox_activated(i); }
                    row_add_review(i) => { root.inbox_add_review(i); }
                    open_browser => { root.inbox_open_browser(); }
                    close_detail => { root.inbox_close_detail(); }
                    mark_all_read => { root.inbox_mark_all_read(); }
                    filter_toggled(v) => { root.inbox_filter_toggled(v); }
                    load_more => { root.inbox_load_more(); }
                }
                NotifPreview {
                    visible: root.inbox_detail_open;
                    title: root.nd_title;
                    kind: root.nd_kind;
                    state: root.nd_state;
                    added: root.nd_added;
                    loading: root.nd_loading;
                    convo_entries: root.nd_convo;
                    files: root.nd_files;
                    diff_files: root.nd_diff_files;
                    close => { root.inbox_close_detail(); }
                    open_browser => { root.inbox_open_browser(); }
                    add_review => { root.inbox_add_review(inbox.selected_index); }
                    diff_file_toggled(i) => { root.inbox_diff_toggled(i); }
                }
            }
        }

        StatusBar {
            sync_text: root.sb_sync;
            quota_text: root.sb_quota;
            total_count: root.sb_total;
        }
    }

    // 首启引导：未配置时盖住主区，引导打开设置
    if root.onboarding && !root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg.with-alpha(0.96);
        TouchArea {}  // 拦截点击

        // 引导卡片：420px 宽、12px 圆角，背后一层偏移半透明矩形模拟柔和投影
        Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - card.height) / 2 + 2px;
            width: 420px;
            height: card.height;
            border-radius: Theme.r_lg;
            background: #00000033;
        }
        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: welcome-col.preferred-height;
            background: Theme.card;
            border-radius: Theme.r_lg;
            border-width: 1px;
            border-color: Theme.hairline;

            welcome-col := VerticalLayout {
                padding: 28px;
                spacing: 14px;

                Text {
                    text: I18n.welcome_title;
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: I18n.welcome_hint;
                    color: Theme.text_dim;
                    font-size: Theme.fs_md;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    DialogButton {
                        text: I18n.welcome_open_settings;
                        primary: true;
                        button-width: 120px;
                        clicked => { root.open_settings(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }

    // 设置弹窗（模态，顶层）：480px 宽，分组表单
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        TouchArea {}  // 拦截点击穿透

        dialog := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            // 分 tab 后内容变短：固定 560px（窗口太矮则收缩 + 滚动兜底）
            height: min(560px, parent.height - 64px);
            background: Theme.card;
            border-radius: Theme.r_lg;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: I18n.settings_title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }

                // 功能分 tab（macOS 风格分段控件，与顶栏同款）：数据源 / 通用 / LLM 预评审
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 340px;
                        height: 26px;
                        border-radius: Theme.r_md;
                        background: Theme.surface2;

                        Rectangle {
                            x: 2px + root.settings_tab * 112px;
                            y: 2px;
                            width: 112px;
                            height: parent.height - 4px;
                            border-radius: Theme.r_sm;
                            background: Theme.card;
                            animate x { duration: 150ms; easing: ease-out; }
                        }
                        stab0 := TouchArea {
                            x: 0; width: 112px; height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.settings_tab = 0; }
                        }
                        Text {
                            x: 0; width: 112px; height: 100%;
                            text: I18n.settings_tab_source;
                            font-size: Theme.fs_sm;
                            color: root.settings_tab == 0 ? Theme.text : Theme.text_dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        stab1 := TouchArea {
                            x: 112px; width: 112px; height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.settings_tab = 1; }
                        }
                        Text {
                            x: 112px; width: 112px; height: 100%;
                            text: I18n.settings_tab_general;
                            font-size: Theme.fs_sm;
                            color: root.settings_tab == 1 ? Theme.text : Theme.text_dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        stab2 := TouchArea {
                            x: 224px; width: 112px; height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.settings_tab = 2; }
                        }
                        Text {
                            x: 224px; width: 112px; height: 100%;
                            text: I18n.settings_tab_llm;
                            font-size: Theme.fs_sm;
                            color: root.settings_tab == 2 ? Theme.text : Theme.text_dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: fields.preferred-height;

                    fields := VerticalLayout {
                        width: 100%;
                        spacing: 14px;

                // ── tab 0：连接与同步 ──
                if root.settings_tab == 0: VerticalLayout {
                    spacing: 14px;

                // ── 数据源档案选择行：以下服务器地址 / sync_token / AstrBot Key 三字段按档案独立保存 ──
                // 切换档案只写 settings_profile（changed 触发 settings_profile_focus → Rust 回填三字段）；
                // 表单字段仍绑定 s_server / s_sync_token / s_ak，保存仍走 save_settings（Rust 按当前档案写回）。
                Field {
                    label: I18n.settings_profile_label;
                    HorizontalLayout {
                        spacing: 8px;

                        // 当前编辑档案（下拉浮层用 PopupWindow，不被弹窗 clip 裁切）
                        profile-btn := Rectangle {
                            width: 160px;
                            height: 30px;
                            border-radius: Theme.r_md;
                            background: profile-ta.has-hover ? Theme.hover : Theme.surface2;
                            animate background { duration: 120ms; }

                            profile-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { profile-popup.show(); }
                            }
                            Image {
                                x: 10px;
                                y: (parent.height - 12px) / 2;
                                width: 12px;
                                height: 12px;
                                source: @image-url("icons/database.svg");
                                image-fit: contain;
                                colorize: Theme.text_dim;
                            }
                            Text {
                                x: 28px;
                                width: parent.width - 52px;
                                height: 100%;
                                text: root.settings_profile == "local" ? I18n.source_local : root.settings_profile;
                                font-size: Theme.fs_md;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                x: parent.width - 20px;
                                y: (parent.height - 10px) / 2;
                                width: 10px;
                                height: 10px;
                                source: @image-url("icons/chevron-down.svg");
                                image-fit: contain;
                                colorize: Theme.text_faint;
                            }

                            profile-popup := PopupWindow {
                                x: 0;
                                y: parent.height + 4px;
                                width: max(180px, parent.width);
                                height: root.profile_names.length * 26px + 8px;
                                close-policy: close-on-click-outside;

                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: Theme.r_lg;
                                    background: Theme.card;
                                    border-width: 1px;
                                    border-color: Theme.hairline;

                                    VerticalLayout {
                                        x: 0;
                                        y: 4px;
                                        width: 100%;
                                        spacing: 0;

                                        for p in root.profile_names: Rectangle {
                                            height: 26px;
                                            // 与顶栏下拉同款修复：sel 优先 + 显式 card 底，避免 PopupWindow 下发淡
                                            background: p == root.settings_profile ? Theme.sel
                                                : pi-ta.has-hover ? Theme.hover : Theme.card;

                                            pi-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.settings_profile = p;
                                                    profile-popup.close();
                                                }
                                            }
                                            Image {
                                                visible: p == root.settings_profile;
                                                x: 8px;
                                                y: (parent.height - 10px) / 2;
                                                width: 10px;
                                                height: 10px;
                                                source: @image-url("icons/check.svg");
                                                image-fit: contain;
                                                colorize: Theme.sel_text;
                                            }
                                            Text {
                                                x: 24px;
                                                width: parent.width - 32px;
                                                height: 100%;
                                                text: p == "local" ? I18n.source_local : p;
                                                font-size: Theme.fs_sm;
                                                color: p == root.settings_profile ? Theme.sel_text : Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 「+」新档案：点击后在选择行内联展开输入框（避免 PopupWindow 内部元素外部不可达的限制），
                        // Enter 确认 → profile_add(name)（Rust 侧校验并更新 profile_names），✕ 取消
                        add-input := FormField {
                            width: 160px;
                            visible: root.adding_profile;
                            placeholder: I18n.profile_add_hint;
                            accepted => {
                                if (self.text != "") {
                                    root.profile_add(self.text);   // Rust 校验；新档案复制 default 档服务器配置起步
                                    // 即时切到新档案并聚焦 Server URL（非法名由 Rust 回写 settings_profile 纠正）
                                    root.settings_profile = self.text;
                                    server-field.focus_input();
                                }
                                self.text = "";
                                root.adding_profile = false;
                            }
                        }
                        if !root.adding_profile: add-btn := Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: Theme.r_md;
                            background: add-ta.has-hover ? Theme.hover : transparent;
                            animate background { duration: 120ms; }

                            add-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.adding_profile = true;
                                    add-input.text = "";
                                    add-input.focus_input();
                                }
                            }
                            Image {
                                x: (parent.width - 14px) / 2;
                                y: (parent.height - 14px) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("icons/plus.svg");
                                image-fit: contain;
                                colorize: add-ta.has-hover ? Theme.text : Theme.text_dim;
                            }
                            if add-ta.has-hover: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.height + 4px;
                                width: add-tip.preferred-width + 12px;
                                height: 20px;
                                border-radius: Theme.r_sm;
                                background: Theme.card;
                                border-width: 1px;
                                border-color: Theme.hairline;
                                add-tip := Text {
                                    text: I18n.profile_add_tooltip;
                                    font-size: Theme.fs_xs;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // 输入模式下的取消按钮
                        if root.adding_profile: Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: Theme.r_md;
                            background: cancel-ta.has-hover ? Theme.hover : transparent;
                            animate background { duration: 120ms; }

                            cancel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.adding_profile = false; }
                            }
                            Image {
                                x: (parent.width - 12px) / 2;
                                y: (parent.height - 12px) / 2;
                                width: 12px;
                                height: 12px;
                                source: @image-url("icons/x.svg");
                                image-fit: contain;
                                colorize: cancel-ta.has-hover ? Theme.text : Theme.text_dim;
                            }
                        }

                        // 删除当前档案（local 不可删；Rust 侧删除后负责回写 settings_profile / profile_names）
                        if !root.adding_profile && root.settings_profile != "local": Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: Theme.r_md;
                            background: del-ta.has-hover ? Theme.hover : transparent;
                            animate background { duration: 120ms; }

                            del-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.profile_remove(root.settings_profile); }
                            }
                            Image {
                                x: (parent.width - 12px) / 2;
                                y: (parent.height - 12px) / 2;
                                width: 12px;
                                height: 12px;
                                source: @image-url("icons/x.svg");
                                image-fit: contain;
                                colorize: del-ta.has-hover ? Theme.bad : Theme.text_dim;
                            }
                            if del-ta.has-hover: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.height + 4px;
                                width: del-tip.preferred-width + 12px;
                                height: 20px;
                                border-radius: Theme.r_sm;
                                background: Theme.card;
                                border-width: 1px;
                                border-color: Theme.hairline;
                                del-tip := Text {
                                    text: I18n.profile_delete_tooltip;
                                    font-size: Theme.fs_xs;
                                    color: Theme.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Field {
                    label: I18n.settings_server_url;
                    server-field := FormField {
                        enabled: !root.editing_local;
                        placeholder: I18n.settings_server_placeholder;
                        text <=> root.s_server;
                    }
                }
                Field {
                    label: I18n.settings_sync_token;
                    FormField {
                        enabled: !root.editing_local;
                        password: true;
                        placeholder: I18n.settings_sync_token_placeholder;
                        text <=> root.s_sync_token;
                    }
                }
                Field {
                    label: I18n.settings_astrbot_key;
                    FormField {
                        enabled: !root.editing_local;
                        password: true;
                        placeholder: I18n.settings_astrbot_key_placeholder;
                        text <=> root.s_ak;
                    }
                }
                if root.editing_local: Text {
                    text: I18n.source_local_hint;
                    color: Theme.text_faint;
                    font-size: Theme.fs_xs;
                }
                }

                // ── tab 1：通用（GitHub token / 仓库列表 / 轮询间隔 / 语言，全局不随档案）──
                if root.settings_tab == 1: VerticalLayout {
                    spacing: 14px;

                Field {
                    label: root.gh_token_from_env
                        ? I18n.settings_gh_token_env
                        : I18n.settings_gh_token;
                    FormField {
                        password: true;
                        placeholder: root.gh_token_from_env ? I18n.settings_gh_token_placeholder_env : I18n.settings_gh_token_placeholder;
                        text <=> root.s_gh_token;
                    }
                }
                Field {
                    label: I18n.settings_repos;
                    FormArea {
                        placeholder: "owner/repo";
                        text <=> root.s_repos;
                    }
                }
                Field {
                    label: I18n.settings_poll_interval;
                    HorizontalLayout {
                        spacing: 8px;
                        NumStepper {
                            value <=> root.s_poll;
                            minimum: 1;
                            maximum: 120;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Field {
                    label: I18n.settings_language;
                    HorizontalLayout {
                        spacing: 8px;
                        // 分段控件（与设置页 tab 切换同款样式）；切换即时生效并持久化
                        Rectangle {
                            width: 152px;
                            height: 26px;
                            border-radius: Theme.r_md;
                            background: Theme.surface2;

                            Rectangle {
                                x: 2px + (root.language == "en" ? 1 : 0) * 72px;
                                y: 2px;
                                width: 72px;
                                height: parent.height - 4px;
                                border-radius: Theme.r_sm;
                                background: Theme.card;
                                animate x { duration: 150ms; easing: ease-out; }
                            }
                            lang-zh := TouchArea {
                                x: 0; width: 72px; height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.language = "zh"; }
                            }
                            Text {
                                x: 0; width: 72px; height: 100%;
                                text: I18n.lang_name_zh;
                                font-size: Theme.fs_sm;
                                color: root.language == "zh" ? Theme.text : Theme.text_dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            lang-en := TouchArea {
                                x: 72px; width: 72px; height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.language = "en"; }
                            }
                            Text {
                                x: 72px; width: 72px; height: 100%;
                                text: I18n.lang_name_en;
                                font-size: Theme.fs_sm;
                                color: root.language == "en" ? Theme.text : Theme.text_dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                Field {
                    label: I18n.settings_font_size;
                    HorizontalLayout {
                        spacing: 8px;
                        // 三档分段控件（小/标准/大，与语言切换同款样式）；切换即时生效并持久化
                        Rectangle {
                            width: 176px;
                            height: 26px;
                            border-radius: Theme.r_md;
                            background: Theme.surface2;

                            Rectangle {
                                x: 2px + (root.font_scale < 0.95 ? 0 : (root.font_scale > 1.07 ? 2 : 1)) * 58px;
                                y: 2px;
                                width: 56px;
                                height: parent.height - 4px;
                                border-radius: Theme.r_sm;
                                background: Theme.card;
                                animate x { duration: 150ms; easing: ease-out; }
                            }
                            fs-s := TouchArea {
                                x: 0; width: 58px; height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.font_scale = 0.9; }
                            }
                            Text {
                                x: 0; width: 58px; height: 100%;
                                text: I18n.font_size_small;
                                font-size: Theme.fs_sm;
                                color: root.font_scale < 0.95 ? Theme.text : Theme.text_dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            fs-m := TouchArea {
                                x: 58px; width: 58px; height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.font_scale = 1.0; }
                            }
                            Text {
                                x: 58px; width: 58px; height: 100%;
                                text: I18n.font_size_normal;
                                font-size: Theme.fs_sm;
                                color: root.font_scale >= 0.95 && root.font_scale <= 1.07 ? Theme.text : Theme.text_dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            fs-l := TouchArea {
                                x: 116px; width: 58px; height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.font_scale = 1.15; }
                            }
                            Text {
                                x: 116px; width: 58px; height: 100%;
                                text: I18n.font_size_large;
                                font-size: Theme.fs_sm;
                                color: root.font_scale > 1.07 ? Theme.text : Theme.text_dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                }

                // ── tab 2：LLM 预评审 ──
                if root.settings_tab == 2: VerticalLayout {
                    spacing: 14px;

                Field {
                    label: "API Base URL";
                    FormField {
                        placeholder: "https://api.openai.com/v1";
                        text <=> root.s_llm_base;
                    }
                }
                Field {
                    label: "API Key";
                    FormField {
                        password: true;
                        placeholder: "sk-...";
                        text <=> root.s_llm_key;
                    }
                }
                Field {
                    label: I18n.settings_model_name;
                    HorizontalLayout {
                        spacing: 8px;
                        FormField {
                            horizontal-stretch: 1;
                            placeholder: "gpt-4o-mini";
                            text <=> root.s_llm_model;
                        }
                        DialogButton {
                            text: I18n.settings_fetch_models;
                            clicked => { root.fetch_models(root.s_llm_base, root.s_llm_key); }
                        }
                    }
                    // 拉取成功后出现模型选择列表（自绘：std ComboBox 在本环境样式坏掉）
                    // 选中即填入输入框（输入框仍可手输）；标题行可折叠
                    if root.model_list.length > 0: Rectangle {
                        border-radius: Theme.r_md;
                        background: Theme.surface2;
                        clip: true;
                        height: root.model_list_open ? 178px : 30px;
                        animate height { duration: 120ms; easing: ease-out; }

                        // 标题行：「选择模型（N 个）」点击折叠/展开，右侧 chevron 指示展开态
                        TouchArea {
                            x: 0; y: 0; width: 100%; height: 30px;
                            mouse-cursor: pointer;
                            clicked => { root.model_list_open = !root.model_list_open; }
                        }
                        Text {
                            x: 10px; y: 0; height: 30px;
                            text: I18n.settings_model_list_pre + root.model_list.length + I18n.settings_model_list_post;
                            color: Theme.text_dim;
                            font-size: Theme.fs_sm;
                            vertical-alignment: center;
                        }
                        Image {
                            x: parent.width - 24px; y: 9px; width: 12px; height: 12px;
                            source: root.model_list_open
                                ? @image-url("icons/chevron-up.svg")
                                : @image-url("icons/chevron-down.svg");
                            image-fit: contain;
                            colorize: Theme.text_faint;
                        }

                        // 列表区（展开时可见；标题行以下，含分隔线）
                        Rectangle {
                            x: 0; y: 30px; width: 100%; height: 1px;
                            background: Theme.hairline;
                        }
                        Flickable {
                            x: 0; y: 31px;
                            width: 100%;
                            height: max(0px, parent.height - 31px);
                            content-width: self.width;
                            content-height: ml_layout.preferred-height;

                            ml_layout := VerticalLayout {
                                width: 100%;
                                alignment: start;

                                for m in root.model_list: Rectangle {
                                    height: 28px;
                                    background: mi_ta.has-hover ? Theme.hover
                                        : (m == root.s_llm_model ? Theme.sel : transparent);

                                    mi_ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.s_llm_model = m; }
                                    }
                                    Text {
                                        x: 10px; width: parent.width - 20px; height: 100%;
                                        text: m;
                                        color: m == root.s_llm_model ? Theme.sel_text : Theme.text;
                                        font-size: Theme.fs_sm;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                Field {
                    label: I18n.settings_ocr_path;
                    FormField {
                        placeholder: "ocr";
                        text <=> root.s_ocr_path;
                    }
                }
                Field {
                    label: I18n.settings_review_concurrency;
                    HorizontalLayout {
                        spacing: 8px;
                        NumStepper {
                            value <=> root.s_review_concurrency;
                            minimum: 1;
                            maximum: 8;
                        }
                        Text {
                            text: I18n.settings_concurrency_hint;
                            color: Theme.text_faint;
                            font-size: Theme.fs_xs;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
                Field {
                    label: I18n.settings_review_prompt;
                    FormArea {
                        placeholder: I18n.settings_review_prompt_hint;
                        text <=> root.s_review_prompt;
                    }
                }
                }
                }
                }

                // 底部按钮：右对齐，保存为主色实心
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    DialogButton {
                        text: I18n.cancel;
                        clicked => { root.settings_open = false; }
                    }
                    DialogButton {
                        text: I18n.save;
                        primary: true;
                        clicked => {
                            root.save_settings(root.s_server, root.s_sync_token, root.s_gh_token, root.s_repos, "" + root.s_poll, root.s_llm_base, root.s_llm_key, root.s_llm_model, root.s_ocr_path, "" + root.s_review_concurrency, root.s_ak);
                            root.settings_open = false;
                        }
                    }
                }
            }
        }
    }
}
