// PR Desk — 主窗口（组装 theme/components/pr_list/drawer/diff_view）
// 键盘：PrListView 自带 j/k/↑↓/Enter/Esc；外层 FocusScope 只处理 p/1/2/3
// （事件先到 PrListView，reject 后冒泡到外层）。
import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PrListView, PrListRow, PrGroup } from "pr_list.slint";
import { DetailDrawer } from "drawer.slint";
import { DiffView, DiffFile, DiffLine } from "diff_view.slint";

// 类型再导出：slint-build 从本文件生成 Rust 绑定
export { PrListRow, PrGroup, DiffFile, DiffLine }

export component MainWindow inherits Window {
    title: "PR Desk";
    preferred-width: 1150px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 480px;

    in property <[PrListRow]> rows: [];
    in-out property <[PrGroup]> groups: [];
    in property <string> status_text: "就绪";
    // 抽屉
    in property <bool> d_open: false;
    in property <string> d_title: "";
    in property <string> d_subtitle: "";
    in property <string> d_body: "";
    in property <string> d_convo: "";
    in property <string> d_checks: "";
    in property <string> d_files: "";
    in property <int> d_priority: 0;
    // diff
    in property <[DiffFile]> diff_files: [];
    in property <string> diff_hint: "选择 PR 后在此查看 diff";

    callback refresh();
    callback sync_now();
    callback row_activated(int);
    callback row_pin(int);
    callback row_reject(int);
    callback row_board(int);
    callback drawer_close();
    callback drawer_requeue();
    callback drawer_reject();
    callback drawer_set_priority(int);
    callback diff_file_toggled(int);
    callback key_pin();
    callback key_priority(int);

    forward-focus: keys;

    VerticalLayout {
        // 顶栏
        Rectangle {
            height: 38px;
            background: Theme.card;
            HorizontalLayout {
                padding: 6px;
                spacing: 8px;
                Text {
                    text: "PR Desk";
                    color: Theme.text;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { width: 8px; }
                Button { text: "刷新 GitHub"; clicked => { root.refresh(); } }
                Button { text: "同步服务器"; clicked => { root.sync_now(); } }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.status_text;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // 主区：左列表 + 右 diff（抽屉打开时覆盖右侧）
        keys := FocusScope {
            key-pressed(event) => {
                if (event.text == "p") { root.key_pin(); return accept; }
                if (event.text == "1") { root.key_priority(1); return accept; }
                if (event.text == "2") { root.key_priority(2); return accept; }
                if (event.text == "3") { root.key_priority(3); return accept; }
                reject
            }

            HorizontalLayout {
                list := PrListView {
                    width: 58%;
                    rows: root.rows;
                    groups: root.groups;
                    row_activated(i) => { root.row_activated(i); }
                    row_pin(i) => { root.row_pin(i); }
                    row_reject(i) => { root.row_reject(i); }
                    row_board(i) => { root.row_board(i); }
                    dismissed => { root.drawer_close(); }
                }
                Rectangle { width: 1px; background: Theme.border; }
                DiffView {
                    files: root.diff_files;
                    file_toggled(i) => { root.diff_file_toggled(i); }
                }
            }
        }
    }

    // 详情抽屉：窗口顶层直接子元素、位于其它内容之后（不放进 Layout）
    DetailDrawer {
        open: root.d_open;
        title: root.d_title;
        subtitle: root.d_subtitle;
        body_html_free_text: root.d_body;
        convo_text: root.d_convo;
        checks_text: root.d_checks;
        files_text: root.d_files;
        current_priority: root.d_priority;
        close => { root.drawer_close(); }
        action_requeue => { root.drawer_requeue(); }
        action_toggle_reject => { root.drawer_reject(); }
        action_set_priority(p) => { root.drawer_set_priority(p); }
    }
}
