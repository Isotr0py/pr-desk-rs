// PR Desk — 分区 PR 列表组件（GPLv3）
// GitHub 风格精致列表：11px 表头 + 30px 紧凑行 + 左侧 accent 选中指示条。
// 依赖共享契约：theme.slint 的 global Theme（sel/sel_text/hover/hairline/fs_*/r_*），
// components.slint 的 Avatar / StatusDot / ScoreChip / SizeBadge / PriorityDot / TagChip。
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";
import { Avatar, StatusDot, ScoreChip, SizeBadge, PriorityDot, TagChip, VScrollBar } from "components.slint";

// 单行 PR 数据（分组头不在此数组里，见 PrGroup）
export struct PrListRow {
    key: string,
    number: int,
    title: string,
    priority: int,      // 0 未排 / 1 高 / 2 中 / 3 低
    author: string,
    avatar: image,      // Rust 侧传入的头像
    initial: string,    // 头像缺失时的降级单字母（Rust 侧 avatar_initial 算好）
    org1: image,        // 作者公开组织的图标（最多 3 个；无则空 image）
    org2: image,
    org3: image,
    org1_name: string,  // 对应的 org 名（hover tooltip 用）
    org2_name: string,
    org3_name: string,
    turn: string,       // me / them / ""
    review: string,     // approved / changes_requested / commented / review_required / ""
    ci: string,         // success / failure / pending / none / ""
    size: string,       // XS / S / M / L / XL / ""
    additions: int,
    deletions: int,
    score: float,       // 0 表示未评分（不显示 ScoreChip）
    age: string,        // 创建至今相对时间，如 "3d"
    updated: string,    // 最近更新相对时间，如 "2h"（优先于 age 显示）
    activity_text: string,  // 最近活动摘要，如 "author pushed 33m"（标题右侧 dim 拼接）
    pinned: bool,
    on_board: bool,
}

// 分组元数据（仅 GroupHeader 组件内部使用；列表模型已摊平为 PrListItem，见下）
export struct PrGroup {
    key: string,        // pinned / board / needs-review / reviewed / rejected / closed
    name: string,       // 显示名（Pinned / 看板 / 待评审 / 已评审 / 不采纳 / 已合入关闭）
    start: int,         // 未使用（兼容字段）
    count: int,         // 本组行数（徽章）
    collapsed: bool,
}

// 摊平后的列表项：组头（is_header）与数据行混排进同一个 ListView（虚拟化）。
// 折叠组的行不进模型；ridx 是该行在「完整行序列」（含折叠组的行，即 Rust 侧
// view_keys 序）中的下标——点击/快捷操作回调都传它，与折叠状态解耦。
export struct PrListItem {
    is_header: bool,
    ridx: int,
    // 多选标记（Ctrl/Shift 点选进入多选集合的行；弱一档底色高亮）
    multi_selected: bool,
    // ── 组头字段（is_header=true 时有效）──
    gkey: string,
    gname: string,
    gcount: int,
    gcollapsed: bool,
    // ── 数据行字段（is_header=false 时有效）──
    row: PrListRow,
}

// 列宽契约（表头与数据行共用，保持一致）。in-out：表头拖拽手柄可改列宽。
//   P 12px / # 56px / Title 弹性 / Author 116px / Turn 40px
//   Review 24px / CI 24px / Size 30px / Age 40px / Updated 40px
global Cols {
    in-out property <length> priority: 12px;
    in-out property <length> number: 56px;
    in-out property <length> author: 116px;
    in-out property <length> turn: 40px;
    in-out property <length> review: 24px;
    in-out property <length> ci: 24px;
    in-out property <length> size: 30px;
    in-out property <length> age: 40px;
    in-out property <length> updated: 40px;
    out property <length> row-pad-l: 10px;
    out property <length> row-pad-r: 8px;
    // 全部固定列 + 列间隙 + 两侧 padding + Title 列最小宽（60px）：
    // 视口窄于此时列表允许横向滚动，右侧 Age/Upd 列不被裁掉
    out property <length> min-total: priority + number + author + turn + review + ci + size
        + DiffCol.width + age + updated + 6px * 10 + row-pad-l + row-pad-r + 60px;
}

// 增删行数列宽（表头拖拽手柄可调）
global DiffCol {
    in-out property <length> width: 72px;
}

// ── org 图标（13px 圆角方形）+ hover tooltip 显示组织名 ──
// tooltip 画在图标上方（y 负值）：Slint 按声明顺序绘制，本行在上行之后绘制，
// 所以向上的 tooltip 能盖住上一行；不要用 PopupWindow（show 会抢走 hover 状态导致抖动），
// 也不要画在图标下方（会被下一行盖住）。
// 边界情况：第一行的 tooltip 顶部会被列表视口裁掉一点，可接受。
component OrgIcon inherits Rectangle {
    in property <image> icon;
    in property <string> name;

    visible: root.icon.width > 0;
    width: 13px;
    height: 13px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 3px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.icon;
            image-fit: cover;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
    }
    if ta.has-hover: Rectangle {
        x: (parent.width - (tip.preferred-width + 14px)) / 2;
        y: -28px;
        width: tip.preferred-width + 14px;
        height: 22px;
        border-radius: Theme.r_md;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.hairline;
        tip := Text {
            text: root.name;
            font-size: Theme.fs_xs;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ── 可排序表头单元格：点击排序（同列再点反向），当前列高亮 + 方向箭头 ──
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> sort_key;
    in property <bool> active: false;
    in property <bool> asc: true;
    callback clicked();

    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: Theme.fs_xs;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.text : Theme.text_faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.active: Image {
        x: parent.width - 12px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        source: root.asc ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
        image-fit: contain;
        colorize: Theme.text_dim;
    }
}

// ── 表头列宽拖拽手柄：8px 宽热区，拖动列分界线调整该列（弹性标题列吸收余量）──
// dragged 回调收到的是鼠标在表头坐标系下的绝对 x——用手柄自身 x + 相对位移算出，
// 与列宽解耦，避免「手柄跟随列宽移动导致相对位移漂移」的反馈回路。
component ColHandle inherits Rectangle {
    callback dragged(length);

    // 拖拽期间「左列 + 右列」宽度之和不变，每次事件先暂存再分配
    //（in-out：回调处理器编译在父组件作用域，跨组件访问需要可见性）
    in-out property <length> pair-total;

    width: 8px;

    // 常显细分隔线（居中 1px），hover/拖拽时整根手柄显示 accent 色条
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        height: 12px;
        y: (parent.height - self.height) / 2;
        background: ta.has-hover || ta.pressed ? Theme.accent : Theme.text_faint;
    }
    background: ta.pressed ? Theme.accent.with-alpha(0.25) : transparent;

    ta := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(root.x + self.mouse-x);
            }
        }
    }
}

// ── 表头行：11px / 500 / text_faint，底部 hairline；列分界处有拖拽手柄 ──
// 与 PrRowItem 共用同一套列坐标公式（绝对定位），保证任何宽度下逐像素对齐
component ListHeader inherits Rectangle {
    // 排序状态（当前列 + 方向）+ 点击回调（Excel 式点列标题排序）
    in property <string> sort_col: "upd";
    in property <bool> sort_asc: false;
    callback col_clicked(string);

    height: 26px;

    // 列 x 坐标：左锚定链式计算，Title 弹性吸收剩余宽度（PrRowItem 里有一套相同的）
    property <length> x-p: Cols.row-pad-l;
    property <length> x-num: x-p + Cols.priority + 6px;
    property <length> x-title: x-num + Cols.number + 6px;
    property <length> fixed-sum: Cols.priority + Cols.number + Cols.author + Cols.turn + Cols.review + Cols.ci + Cols.size + DiffCol.width + Cols.age + Cols.updated;
    property <length> title-w: max(60px, root.width - fixed-sum - 6px * 10 - Cols.row-pad-l - Cols.row-pad-r);
    property <length> x-author: x-title + title-w + 6px;
    property <length> x-turn: x-author + Cols.author + 6px;
    property <length> x-rev: x-turn + Cols.turn + 6px;
    property <length> x-ci: x-rev + Cols.review + 6px;
    property <length> x-size: x-ci + Cols.ci + 6px;
    property <length> x-diff: x-size + Cols.size + 6px;
    property <length> x-age: x-diff + DiffCol.width + 6px;
    property <length> x-upd: x-age + Cols.age + 6px;

    HeaderCell { x: root.x-p; width: Cols.priority; label: "P"; sort_key: "priority"; active: root.sort_col == "priority"; asc: root.sort_asc; clicked => { root.col_clicked("priority"); } }
    HeaderCell { x: root.x-num; width: Cols.number; label: "#"; sort_key: "num"; active: root.sort_col == "num"; asc: root.sort_asc; clicked => { root.col_clicked("num"); } }
    HeaderCell { x: root.x-title; width: root.title-w; label: I18n.col_title; sort_key: "title"; active: root.sort_col == "title"; asc: root.sort_asc; clicked => { root.col_clicked("title"); } }
    HeaderCell { x: root.x-author; width: Cols.author; label: I18n.col_author; sort_key: "author"; active: root.sort_col == "author"; asc: root.sort_asc; clicked => { root.col_clicked("author"); } }
    HeaderCell { x: root.x-turn; width: Cols.turn; label: I18n.col_turn; sort_key: "turn"; active: root.sort_col == "turn"; asc: root.sort_asc; clicked => { root.col_clicked("turn"); } }
    HeaderCell { x: root.x-rev; width: Cols.review; label: I18n.col_review; sort_key: "review"; active: root.sort_col == "review"; asc: root.sort_asc; clicked => { root.col_clicked("review"); } }
    HeaderCell { x: root.x-ci; width: Cols.ci; label: "CI"; sort_key: "ci"; active: root.sort_col == "ci"; asc: root.sort_asc; clicked => { root.col_clicked("ci"); } }
    HeaderCell { x: root.x-size; width: Cols.size; label: I18n.col_size; sort_key: "size"; active: root.sort_col == "size"; asc: root.sort_asc; clicked => { root.col_clicked("size"); } }
    HeaderCell { x: root.x-diff; width: DiffCol.width; label: "+/-"; sort_key: "changes"; active: root.sort_col == "changes"; asc: root.sort_asc; clicked => { root.col_clicked("changes"); } }
    HeaderCell { x: root.x-age; width: Cols.age; label: I18n.col_age; sort_key: "age"; active: root.sort_col == "age"; asc: root.sort_asc; clicked => { root.col_clicked("age"); } }
    HeaderCell { x: root.x-upd; width: Cols.updated; label: I18n.col_updated; sort_key: "upd"; active: root.sort_col == "upd"; asc: root.sort_asc; clicked => { root.col_clicked("upd"); } }

    // 列宽拖拽手柄：拖分界线 = 相邻两列宽度互转（左列 + 右列 = 常量），
    // 其它列位置/宽度完全不动。手柄中心 = 间隙中心（右列左缘 - 3px）。
    // Title 是弹性列：与 # 或 Author 互转时由它吸收差值。
    // P | #
    ColHandle {
        x: root.x-num - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.priority + Cols.number;
            Cols.priority = min(self.pair-total - 40px, max(8px, hx - 3px - root.x-p));
            Cols.number = self.pair-total - Cols.priority;
        }
    }
    // # | Title（# 变宽，Title 吸收）
    ColHandle {
        x: root.x-title - 7px;
        height: parent.height;
        dragged(hx) => { Cols.number = min(120px, max(40px, hx - 3px - root.x-num)); }
    }
    // Title | Author（Author 变宽，Title 吸收）
    ColHandle {
        x: root.x-author - 7px;
        height: parent.height;
        dragged(hx) => { Cols.author = min(400px, max(70px, Cols.author + root.x-author - 3px - hx)); }
    }
    // Author | Turn
    ColHandle {
        x: root.x-turn - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.author + Cols.turn;
            Cols.author = min(self.pair-total - 36px, max(70px, hx - 3px - root.x-author));
            Cols.turn = self.pair-total - Cols.author;
        }
    }
    // Turn | Rev
    ColHandle {
        x: root.x-rev - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.turn + Cols.review;
            Cols.turn = min(self.pair-total - 16px, max(36px, hx - 3px - root.x-turn));
            Cols.review = self.pair-total - Cols.turn;
        }
    }
    // Rev | CI
    ColHandle {
        x: root.x-ci - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.review + Cols.ci;
            Cols.review = min(self.pair-total - 16px, max(16px, hx - 3px - root.x-rev));
            Cols.ci = self.pair-total - Cols.review;
        }
    }
    // CI | Size
    ColHandle {
        x: root.x-size - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.ci + Cols.size;
            Cols.ci = min(self.pair-total - 28px, max(16px, hx - 3px - root.x-ci));
            Cols.size = self.pair-total - Cols.ci;
        }
    }
    // Size | +/-
    ColHandle {
        x: root.x-diff - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.size + DiffCol.width;
            Cols.size = min(self.pair-total - 48px, max(28px, hx - 3px - root.x-size));
            DiffCol.width = self.pair-total - Cols.size;
        }
    }
    // +/- | Age
    ColHandle {
        x: root.x-age - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = DiffCol.width + Cols.age;
            DiffCol.width = min(self.pair-total - 32px, max(48px, hx - 3px - root.x-diff));
            Cols.age = self.pair-total - DiffCol.width;
        }
    }
    // Age | Upd
    ColHandle {
        x: root.x-upd - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = Cols.age + Cols.updated;
            Cols.age = min(self.pair-total - 32px, max(32px, hx - 3px - root.x-age));
            Cols.updated = self.pair-total - Cols.age;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 组头：小号大写感（11px/600/dim）+ 右侧数量徽章（surface2 胶囊），26px 行高 ──
component GroupHeader inherits Rectangle {
    in property <PrGroup> group;
    callback toggled();

    height: 26px;
    background: head-ta.has-hover ? Theme.hover : transparent;

    animate background { duration: 100ms; }

    head-ta := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;

        Rectangle {
            width: 12px;
            Image {
                source: root.group.collapsed
                    ? @image-url("icons/chevron-right.svg")
                    : @image-url("icons/chevron-down.svg");
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: Theme.text_dim;
            }
        }
        // 置顶/看板组名前画 pin.svg（组标题已不含 📌 字形，见 lib.rs build_sections）
        if root.group.key == "pinned" || root.group.key == "board": Rectangle {
            width: 12px;
            Image {
                source: @image-url("icons/pin.svg");
                width: 11px;
                height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: root.group.key == "pinned" ? Theme.bad : Theme.text_dim;
            }
        }
        Text {
            text: root.group.name.to-uppercase();
            color: Theme.text_dim;
            font-size: Theme.fs_xs;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        // 数量徽章：surface2 底胶囊
        Rectangle {
            width: badge-text.preferred-width + 14px;
            height: 16px;
            border-radius: 8px;
            background: Theme.surface2;
            badge-text := Text {
                width: 100%;
                height: 100%;
                text: root.group.count;
                color: Theme.text_dim;
                font-size: Theme.fs_xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── hover 快捷操作按钮 ──
component QuickAction inherits Rectangle {
    in property <string> glyph;
    in property <image> icon;   // 优先于 glyph（内嵌 SVG，规避字形缺失豆腐块）
    in property <string> tooltip: "";   // 悬停 450ms 后浮现（复用 components.slint 的延迟 tooltip 模式）
    out property <bool> hovered: qa-ta.has-hover;   // 暴露给父级：并入行 hover 条件，防覆盖层抖动
    callback activated();

    width: 24px;
    height: 22px;
    border-radius: Theme.r_sm;
    background: qa-ta.has-hover ? Theme.hover : transparent;

    property <bool> show-tip: false;

    qa-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        changed has-hover => {
            if (!self.has-hover) { root.show-tip = false; }
        }
    }

    tip-timer := Timer {
        interval: 450ms;
        running: qa-ta.has-hover && root.tooltip != "" && !root.show-tip;
        triggered => { root.show-tip = true; }
    }

    if root.show-tip && qa-ta.has-hover: Rectangle {
        // 右对齐于图标（行右端紧邻视口边缘，居中会被裁掉右半）；
        // 画在行的上方，依赖祖先不 clip（首行顶部可能被 Flickable 视口裁切，可接受）
        x: parent.width - self.width;
        y: -26px;
        width: qa-tip.preferred-width + 12px;
        height: 20px;
        border-radius: Theme.r_sm;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.hairline;
        qa-tip := Text {
            text: root.tooltip;
            font-size: Theme.fs_xs;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.icon.width > 0: Image {
        source: root.icon;
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: Theme.text_dim;
    }
    if root.icon.width == 0: Text {
        text: root.glyph;
        color: Theme.text_dim;
        font-size: Theme.fs_xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── Turn 标记：me accent 高亮 / them 灰 ──
component TurnChip inherits Rectangle {
    in property <string> turn;  // me / them

    property <bool> mine: root.turn == "me";

    height: 16px;
    width: layout.preferred-width;
    border-radius: 8px;
    background: root.mine ? Theme.accent.with-alpha(0.12) : Theme.text_dim.with-alpha(0.12);

    layout := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.mine ? I18n.turn_me : I18n.turn_them;
            color: root.mine ? Theme.accent : Theme.text_dim;
            font-size: Theme.fs_xs;
            font-weight: root.mine ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

// ── 紧凑数据行（30px）──
// 选中：sel 底 + sel_text 字 + 左侧 2px accent 竖条；多选：sel 弱底 + 半透明竖条（不变字色）；
// hover：Theme.hover。两种高亮叠加时当前行（selected）优先。
// 点击统一走 pointer-event（clicked 拿不到修饰键）：左键按下派发 clicked(ctrl, shift)，
// 右键按下派发 context_menu（行内坐标，由外层换算 + clamp 后开 PopupWindow）。
component PrRowItem inherits Rectangle {
    in property <PrListRow> pr;
    in property <bool> selected: false;
    in property <bool> multi_selected: false;
    callback clicked(bool, bool);
    callback context_menu(length, length);
    callback pin();
    callback board();
    callback reject();
    callback open_browser();

    // 选中行上所有文字统一用 sel_text（选中态前景色）
    property <color> fg: root.selected ? Theme.sel_text : Theme.text;
    property <color> fg-dim: root.selected ? Theme.sel_text.with-alpha(0.75) : Theme.text_dim;
    // 高优先级行提升视觉层级
    property <bool> hot: root.pr.priority == 1;

    height: 30px * Theme.fs_scale;
    background: root.selected ? Theme.sel
        : (root.multi_selected ? Theme.sel.with-alpha(0.5)
        : (row-ta.has-hover ? Theme.hover : transparent));

    animate background { duration: root.selected ? 150ms : 100ms; }

    row-ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.right) {
                    root.context_menu(self.mouse-x, self.mouse-y);
                } else if (e.button == PointerEventButton.left) {
                    root.clicked(e.modifiers.control, e.modifiers.shift);
                }
            }
        }
    }

    // 选中指示条：左侧 2px accent 竖条
    Rectangle {
        x: 0;
        y: 0;
        width: 2px;
        height: parent.height;
        background: Theme.accent;
        visible: root.selected;
    }

    // 多选指示条：同一位置半透明 accent 竖条（当前行优先，不叠加）
    Rectangle {
        x: 0;
        y: 0;
        width: 2px;
        height: parent.height;
        background: Theme.accent.with-alpha(0.55);
        visible: root.multi_selected && !root.selected;
    }

    // 列 x 坐标：左锚定链式计算，Title 弹性吸收剩余宽度（与 ListHeader 相同）
    property <length> x-p: Cols.row-pad-l;
    property <length> x-num: x-p + Cols.priority + 6px;
    property <length> x-title: x-num + Cols.number + 6px;
    property <length> fixed-sum: Cols.priority + Cols.number + Cols.author + Cols.turn + Cols.review + Cols.ci + Cols.size + DiffCol.width + Cols.age + Cols.updated;
    property <length> title-w: max(60px, root.width - fixed-sum - 6px * 10 - Cols.row-pad-l - Cols.row-pad-r);
    property <length> x-author: x-title + title-w + 6px;
    property <length> x-turn: x-author + Cols.author + 6px;
    property <length> x-rev: x-turn + Cols.turn + 6px;
    property <length> x-ci: x-rev + Cols.review + 6px;
    property <length> x-size: x-ci + Cols.ci + 6px;
    property <length> x-diff: x-size + Cols.size + 6px;
    property <length> x-age: x-diff + DiffCol.width + 6px;
    property <length> x-upd: x-age + Cols.age + 6px;

    // 固定优先级列宽：无优先级时也占位，否则整行后续列左移
    Rectangle {
        x: root.x-p;
        width: Cols.priority;
        height: parent.height;
        PriorityDot {
            priority: root.pr.priority;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            color: root.selected ? root.fg : (root.pr.priority == 1 ? Theme.bad
                : root.pr.priority == 2 ? Theme.mid : Theme.accent);
        }
    }

    // PR 号即超链接（hover 高亮+手型，点击浏览器打开，不触发选中/详情）
    Rectangle {
        x: root.x-num;
        width: Cols.number;
        height: parent.height;

        num-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open_browser(); }
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: "#" + root.pr.number;
            color: num-ta.has-hover ? Theme.accent : root.fg-dim;
            font-size: Theme.fs_xs;
            horizontal-alignment: center;
            overflow: elide;
            vertical-alignment: center;
        }
        // hover 时下划线，链接语义一眼可辨
        Rectangle {
            x: 0;
            y: parent.height - 6px;
            width: parent.width;
            height: 1px;
            background: Theme.accent;
            visible: num-ta.has-hover;
        }
    }

    // 标题区：标题吃剩余空间并 elide；活动文本/评分徽章右端对齐
    Rectangle {
        x: root.x-title;
        width: root.title-w;
        height: parent.height;
        clip: true;

        property <length> act-w: act.visible ? act.preferred-width : 0px;
        property <length> chip-w: chip.visible ? chip.preferred-width + 6px : 0px;

        Text {
            x: 0;
            width: max(20px, parent.width - parent.act-w - parent.chip-w - (parent.act-w > 0px ? 8px : 0px));
            height: parent.height;
            text: root.pr.title;
            color: root.fg;
            font-size: Theme.fs_sm;
            font-weight: root.hot ? 700 : 500;
            overflow: elide;
            vertical-alignment: center;
        }
        act := Text {
            visible: root.pr.activity_text != "";
            x: parent.width - parent.act-w - parent.chip-w;
            width: self.preferred-width;
            height: parent.height;
            text: root.pr.activity_text;
            color: root.fg-dim;
            font-size: Theme.fs_xs;
            vertical-alignment: center;
        }
        // 评分徽章放标题区最右，避免占用列位顶歪后续列
        chip := ScoreChip {
            visible: root.pr.score > 0;
            x: parent.width - parent.chip-w + 6px;
            y: (parent.height - self.height) / 2;
            score: root.pr.score;
        }
    }

    // 作者：Avatar + 名字 + 组织图标（右对齐，真实 org 头像，插件 web UI 同款）
    // 纯 Rectangle + 手动居中：HorizontalLayout 设 alignment 后子元素垂直方向不再居中
    // 注意：作者单元格不开 clip（名字有 elide 兜底），org 图标的 hover tooltip 需要溢出单元格
    Rectangle {
        x: root.x-author;
        width: Cols.author;
        height: parent.height;

        Avatar {
            img: root.pr.avatar;
            login: root.pr.author;
            initial: root.pr.initial;
            size: 16px;
            x: 0;
            y: (parent.height - 16px) / 2;
        }
        name-txt := Text {
            x: 20px;
            // 名字取自然宽（超长才省略），org 图标紧跟其后
            width: min(self.preferred-width, parent.width - 20px - org-icons.width - 6px);
            height: parent.height;
            text: root.pr.author;
            color: root.fg-dim;
            font-size: Theme.fs_xs;
            overflow: elide;
            vertical-alignment: center;
        }
        // 组织图标行：org1 最左，org2/org3 依次往右
        org-icons := Rectangle {
            property <int> n: (root.pr.org1.width > 0 ? 1 : 0) + (root.pr.org2.width > 0 ? 1 : 0) + (root.pr.org3.width > 0 ? 1 : 0);
            width: n > 0 ? n * 17px - 4px : 0px;
            height: parent.height;
            x: name-txt.x + name-txt.width + 6px;

            OrgIcon { x: 0px; y: (parent.height - 13px) / 2; icon: root.pr.org1; name: root.pr.org1_name; }
            OrgIcon { x: 17px; y: (parent.height - 13px) / 2; icon: root.pr.org2; name: root.pr.org2_name; }
            OrgIcon { x: 34px; y: (parent.height - 13px) / 2; icon: root.pr.org3; name: root.pr.org3_name; }
        }
    }

    Rectangle {
        x: root.x-turn;
        width: Cols.turn;
        height: parent.height;
        if root.pr.turn != "": TurnChip {
            turn: root.pr.turn;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    // Review 状态符号：全部用内嵌 SVG + colorize（✓/✗/○/💬 字形在本机字体下都会豆腐块）
    Rectangle {
        x: root.x-rev;
        width: Cols.review;
        height: parent.height;
        Image {
            source: root.pr.review == "approved" ? @image-url("icons/check.svg")
                : (root.pr.review == "changes_requested" ? @image-url("icons/x.svg")
                : (root.pr.review == "commented" ? @image-url("icons/comment.svg")
                : @image-url("icons/circle.svg")));
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: root.selected ? root.fg
                : (root.pr.review == "approved" ? Theme.good
                : (root.pr.review == "changes_requested" ? Theme.bad
                : (root.pr.review == "commented" ? Theme.text : Theme.text_dim)));
        }
    }

    Rectangle {
        x: root.x-ci;
        width: Cols.ci;
        height: parent.height;
        StatusDot {
            status: root.pr.ci;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    Rectangle {
        x: root.x-size;
        width: Cols.size;
        height: parent.height;
        if root.pr.size != "": SizeBadge {
            label: root.pr.size;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    // 增删行数：右对齐，绿加红减
    Rectangle {
        x: root.x-diff;
        width: DiffCol.width;
        height: parent.height;
        clip: true;
        adds := Text {
            x: (parent.width - self.preferred-width - 6px - dels.preferred-width) / 2;
            width: self.preferred-width;
            height: parent.height;
            text: "+" + root.pr.additions;
            color: root.selected ? root.fg-dim : Theme.good;
            font-size: Theme.fs_xs;
            vertical-alignment: center;
        }
        dels := Text {
            x: adds.x + adds.preferred-width + 6px;
            width: self.preferred-width;
            height: parent.height;
            text: "-" + root.pr.deletions;
            color: root.selected ? root.fg-dim : Theme.bad;
            font-size: Theme.fs_xs;
            vertical-alignment: center;
        }
    }

    Text {
        x: root.x-age;
        width: Cols.age;
        height: parent.height;
        text: root.pr.age;
        color: root.fg-dim;
        font-size: Theme.fs_xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: root.x-upd;
        width: Cols.updated;
        height: parent.height;
        text: root.pr.updated != "" ? root.pr.updated : root.pr.age;
        color: root.fg-dim;
        font-size: Theme.fs_xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // hover 快捷操作：浏览器打开 / 置顶 / 加看板 / 不采纳（浮现于行右端）。
    // 常驻元素 + visible 切换（不用 if 销毁重建）；可见性同时看行 hover 与覆盖层自身 hover，
    // 否则鼠标移上按钮时遮住 row-ta → has-hover 变 false → 覆盖层消失 → 无限抖动点不中。
    actions-overlay := Rectangle {
        x: parent.width - self.width - 4px;
        y: 3px;
        width: 112px;
        height: parent.height - 6px;
        visible: row-ta.has-hover || actions-ta.has-hover || qa-open.hovered || qa-pin.hovered || qa-board.hovered || qa-reject.hovered;
        border-radius: Theme.r_sm;
        background: root.selected ? Theme.sel : Theme.card;

        // 整条覆盖层的 TouchArea：保持 hover 存活，也挡住穿透到行上的误点
        actions-ta := TouchArea { }

        HorizontalLayout {
            x: 4px;
            y: (parent.height - self.preferred-height) / 2;
            spacing: 4px;
            qa-open := QuickAction { icon: @image-url("icons/open.svg"); tooltip: I18n.inbox_open_browser; activated => { root.open_browser(); } }
            qa-pin := QuickAction { icon: @image-url("icons/pin.svg"); tooltip: I18n.tip_pin; activated => { root.pin(); } }
            qa-board := QuickAction { icon: @image-url("icons/plus.svg"); tooltip: I18n.detail_add_board; activated => { root.board(); } }
            qa-reject := QuickAction { icon: @image-url("icons/x.svg"); tooltip: I18n.tip_reject; activated => { root.reject(); } }
        }
    }

    // 行底 hairline
    Rectangle {
        x: Cols.row-pad-l;
        y: parent.height - 1px;
        width: parent.width - Cols.row-pad-l;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 右键菜单项 / 分隔线（ContextMenu 与操作条优先级下拉共用）──
component CtxItem inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";    // 右侧快捷键提示（对齐参考版菜单）
    in property <bool> danger: false;
    callback activated();

    height: 26px;
    background: ta.has-hover ? Theme.hover : transparent;

    Text {
        x: 12px;
        width: parent.width - 12px - 44px;
        height: 100%;
        text: root.label;
        font-size: Theme.fs_sm;
        color: root.danger ? Theme.bad : Theme.text;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.hint != "": Text {
        x: parent.width - self.preferred-width - 10px;
        width: self.preferred-width;
        height: 100%;
        text: root.hint;
        font-size: Theme.fs_xs;
        color: Theme.text_faint;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component CtxSep inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 多选操作条按钮（小号幽灵按钮，同 inbox ToolButton 风格）──
component BarButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 22px;
    width: layout.preferred-width;
    border-radius: Theme.r_sm;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: Theme.fs_xs;
            color: ta.has-hover ? Theme.text : Theme.text_dim;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── 分区列表（扁平化模型 + 单 ListView 虚拟化）──
// items 为组头/数据行混排的摊平模型（Rust 侧 build_items 装配；折叠组的行不在模型里）。
// 行回调传 ridx = 该行在完整行序列（含折叠组的行）中的下标，与折叠状态解耦。
// 折叠状态在 Rust 侧（App.collapsed），组头点击经 group_toggled 回调翻转后整体重建模型。
// 键盘导航（j/k/Enter）也下沉到 Rust 侧（Slint 回调语言没有循环，无法跳组头扫描），
// 行序与扁平化后的视觉顺序天然一致（同一份 view_visible）。
// 横向滚动：内容窄于视口时铺满；视口比全部固定列还窄时（最小窗口 + 详情面板开着）
// 允许横向拖拽滚动，表头与行同步横滚，右侧 Age/Upd 列不被裁掉。
export component PrListView inherits FocusScope {
    in property <[PrListItem]> items: [];
    // 选中行身份（PrListRow.key = repo#number）。高亮以它为准——刷新重建行后
    // 下标会漂移，身份不会。由点击/Rust 侧（键盘导航、rebuild 后回写）共同维护。
    in-out property <string> selected_key: "";
    // 排序状态（表头高亮用；点击排序逻辑在集成方）
    in property <string> sort_col: "upd";
    in property <bool> sort_asc: false;
    // 弹窗/首启引导打开时锁键盘：key-pressed 全部 reject 放行给外层（外层负责 Esc 关弹窗）
    in property <bool> keys_locked: false;
    // ── 多选状态（Rust 侧 push_selection_ui 回写；驱动操作条与右键菜单动态项）──
    in property <int> sel_count: 0;
    in property <bool> sel_all_pinned: false;
    in property <bool> sel_all_on_board: false;
    in property <bool> sel_all_rejected: false;

    callback header_clicked(string);    // 表头点击排序（传列 key）
    callback group_toggled(string);     // 组头点击折叠/展开（传组 key）
    callback row_activated(int);        // 点击行：打开详情（传 ridx）
    // 左键点击（带修饰键）：ridx + ctrl + shift。选中语义在 Rust 侧
    //（无修饰=单选+开详情，Ctrl=toggle 多选，Shift=锚点范围选）
    callback row_clicked(int, bool, bool);
    callback row_context(int);          // 右键：Rust 侧先把该行并入多选（不在则单选）
    callback row_pin(int);
    callback row_reject(int);
    callback row_board(int);
    callback row_open(int);             // 行内外链按钮：浏览器打开（传 ridx）
    callback key_move(int);             // j/k/↑/↓：在可见行上移动选中（Rust 侧实现）
    callback key_enter();               // Enter：打开当前选中（Rust 侧按身份解析）
    callback dismissed();               // Esc
    // ── 批量操作（作用于多选集合；为空时 Rust 侧回退主选中行）──
    callback batch_set_priority(int);   // 0/1/2/3
    callback batch_toggle_pin();
    callback batch_toggle_board();
    callback batch_set_status(string);  // "rejected" / "pending"
    callback batch_run_review();
    callback batch_copy_links();
    callback batch_open_browser();
    callback clear_multi_selection();

    // 多选操作条占位（列表顶部，0 或 32px；手动偏移体系，不走 stretch 布局）
    property <length> top-off: root.sel_count > 0 ? 32px : 0px;
    // 右键菜单高：行数（单选多一行 Open in Browser）×26 + 3 条分隔线 ×9 + 上下 padding 8
    property <length> ctx-menu-h: (root.sel_count <= 1 ? 11 : 10) * 26px + 35px;

    // 内容宽：视口宽与「固定列合计 + 最小标题列」取大（小于视口时铺满，大于时可横滚）
    property <length> content-w: max(root.width, Cols.min-total);

    // 打开右键菜单：Rust 同步修正多选（sel_count 等立即生效）后 clamp 到窗口内再弹出
    //（PopupWindow 的 x/y 不允许外部事后改写，经 root 属性声明期绑定）
    property <length> ctx-x: 0px;
    property <length> ctx-y: 0px;
    function open_ctx(ridx: int, x: length, y: length) {
        root.row_context(ridx);
        root.ctx-x = min(max(0px, x), max(0px, root.width - 230px - 4px));
        root.ctx-y = min(max(0px, y), max(0px, root.height - root.ctx-menu-h - 4px));
        ctx-popup.show();
    }

    // PageUp/PageDown 翻页滚动（由外层 FocusScope 调用；ListView 自己不认键盘）
    public function page_scroll(dir: int) {
        if (dir > 0) {
            lv.content-y = max(lv.height - lv.content-height, lv.content-y - lv.height * 0.9);
        } else {
            lv.content-y = min(0px, lv.content-y + lv.height * 0.9);
        }
    }

    // 键盘导航：j/k 或 ↑/↓ 移动（Rust 侧跳组头），Enter 打开，Esc 取消
    key-pressed(event) => {
        if (root.keys_locked) { return reject; }
        if (event.text == "j" || event.text == Key.DownArrow) {
            root.key_move(1);
            return accept;
        }
        if (event.text == "k" || event.text == Key.UpArrow) {
            root.key_move(-1);
            return accept;
        }
        if (event.text == Key.Return) {
            root.key_enter();
            return accept;
        }
        if (event.text == Key.Escape) {
            root.dismissed();
            return accept;
        }
        reject
    }

    Rectangle {
        background: Theme.bg;
        clip: true;

        // ── 多选操作条：selection 非空时出现在列表顶部（右键菜单的发现性兜底入口）──
        selbar := Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 32px;
            visible: root.sel_count > 0;
            background: Theme.card;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 2px;

                Text {
                    text: I18n.selbar_count_pre + root.sel_count + I18n.selbar_count_post;
                    color: Theme.accent;
                    font-size: Theme.fs_sm;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                // 优先级下拉：小弹窗右对齐锚在按钮下（左向展开，不溢出右缘）
                Rectangle {
                    width: prio-btn.width;
                    prio-btn := BarButton {
                        label: I18n.ctx_priority;
                        clicked => { prio-popup.show(); }
                    }
                    prio-popup := PopupWindow {
                        x: parent.width - self.width;
                        y: parent.height + 2px;
                        width: 170px;
                        height: 4 * 26px + 8px;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: Theme.r_lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.hairline;
                            VerticalLayout {
                                x: 0;
                                y: 4px;
                                width: 100%;
                                spacing: 0;
                                CtxItem { label: I18n.ctx_priority_high; hint: "1"; activated => { root.batch_set_priority(1); prio-popup.close(); } }
                                CtxItem { label: I18n.ctx_priority_medium; hint: "2"; activated => { root.batch_set_priority(2); prio-popup.close(); } }
                                CtxItem { label: I18n.ctx_priority_low; hint: "3"; activated => { root.batch_set_priority(3); prio-popup.close(); } }
                                CtxItem { label: I18n.ctx_priority_clear; hint: "0"; activated => { root.batch_set_priority(0); prio-popup.close(); } }
                            }
                        }
                    }
                }
                BarButton {
                    label: root.sel_all_pinned ? I18n.ctx_unpin : I18n.tip_pin;
                    clicked => { root.batch_toggle_pin(); }
                }
                BarButton {
                    label: root.sel_all_on_board ? I18n.ctx_remove_board : I18n.detail_add_board;
                    clicked => { root.batch_toggle_board(); }
                }
                BarButton {
                    label: root.sel_all_rejected ? I18n.ctx_restore : I18n.ctx_skip;
                    clicked => { root.batch_set_status(root.sel_all_rejected ? "pending" : "rejected"); }
                }
                BarButton {
                    label: I18n.review_start;
                    clicked => { root.batch_run_review(); }
                }
                BarButton {
                    label: I18n.ctx_copy_links;
                    clicked => { root.batch_copy_links(); }
                }
                BarButton {
                    label: I18n.ctx_clear_selection;
                    clicked => { root.clear_multi_selection(); }
                }
            }

            // 操作条底 hairline
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // 表头：纵向固定，横向随列表滚动（x 绑 content-x 反向偏移）
        header-clip := Rectangle {
            x: 0;
            y: root.top-off;
            width: 100%;
            height: 26px;
            clip: true;

            ListHeader {
                x: flick.content-x;
                y: 0;
                width: root.content-w;
                sort_col: root.sort_col;
                sort_asc: root.sort_asc;
                col_clicked(c) => { root.header_clicked(c); }
            }
        }

        // 空态
        if root.items.length == 0: Text {
            y: 26px + root.top-off;
            width: 100%;
            height: 48px;
            text: I18n.empty_no_pr;
            color: Theme.text_dim;
            font-size: Theme.fs_md;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // 横向 Flickable 包 ListView：横向滚这层，纵向滚 ListView（标准嵌套）
        flick := Flickable {
            y: 26px + root.top-off;
            width: 100%;
            height: parent.height - 26px - root.top-off;
            content-width: root.content-w;
            content-height: self.height;

            lv := ListView {
                x: 0;
                y: 0;
                width: root.content-w;
                height: parent.height;

                for it in root.items: row-wrap := Rectangle {
                    height: it.is_header ? 26px : 30px * Theme.fs_scale;
                    width: root.content-w;

                    if it.is_header: GroupHeader {
                        width: 100%;
                        group: { key: it.gkey, name: it.gname, start: 0, count: it.gcount, collapsed: it.gcollapsed };
                        toggled => { root.group_toggled(it.gkey); }
                    }

                    if !it.is_header: PrRowItem {
                        width: 100%;
                        pr: it.row;
                        multi_selected: it.multi_selected;
                        selected: root.selected_key != "" && it.row.key == root.selected_key;
                        clicked(ctrl, shift) => {
                            root.selected_key = it.row.key;
                            root.row_clicked(it.ridx, ctrl, shift);
                        }
                        // 鼠标坐标（行内）→ PrListView 坐标：加回横向滚动偏移与
                        // 表头/操作条纵向偏移 + 行在 ListView 里的 y（clamp 在 open_ctx 里做）
                        context_menu(mx, my) => {
                            root.open_ctx(it.ridx, flick.content-x + mx, flick.y + row-wrap.y + my);
                        }
                        pin => { root.row_pin(it.ridx); }
                        board => { root.row_board(it.ridx); }
                        reject => { root.row_reject(it.ridx); }
                        open_browser => { root.row_open(it.ridx); }
                    }
                }
            }
        }

        // 垂直滚动指示条：贴视口右缘（不随横向滚动——它在 flick 之外），
        // 覆盖表头以下的列表区；横向滚动不设指示条（横滚是窄窗口+详面并开的边缘场景，
        // 底部横条会与状态栏挤占同一视觉带，收益低）
        VScrollBar {
            x: parent.width - 6px;
            y: 26px + root.top-off;
            width: 6px;
            height: parent.height - 26px - root.top-off;
            viewport-h: lv.height;
            content-h: lv.content-height;
            value: -lv.content-y;
            scrolled_to(y) => { lv.content-y = max(lv.height - lv.content-height, min(0px, -y)); }
        }
    }

    // ── 右键菜单（PopupWindow；坐标在 open_ctx 里 clamp 到窗口内，防右缘/下缘溢出）──
    // 菜单项随多选状态动态：单选才显示「浏览器打开」；Pin/看板/跳过按集合状态翻转文案。
    ctx-popup := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        width: 230px;
        height: root.ctx-menu-h;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.r_lg;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.hairline;

            VerticalLayout {
                x: 0;
                y: 4px;
                width: 100%;
                spacing: 0;

                if root.sel_count <= 1: CtxItem {
                    label: I18n.inbox_open_browser;
                    hint: "o";
                    activated => { root.batch_open_browser(); ctx-popup.close(); }
                }
                CtxSep {}
                CtxItem { label: I18n.ctx_priority_high; hint: "1"; activated => { root.batch_set_priority(1); ctx-popup.close(); } }
                CtxItem { label: I18n.ctx_priority_medium; hint: "2"; activated => { root.batch_set_priority(2); ctx-popup.close(); } }
                CtxItem { label: I18n.ctx_priority_low; hint: "3"; activated => { root.batch_set_priority(3); ctx-popup.close(); } }
                CtxItem { label: I18n.ctx_priority_clear; hint: "0"; activated => { root.batch_set_priority(0); ctx-popup.close(); } }
                CtxItem {
                    label: root.sel_all_pinned ? I18n.ctx_unpin : I18n.tip_pin;
                    hint: "p";
                    activated => { root.batch_toggle_pin(); ctx-popup.close(); }
                }
                CtxItem {
                    label: root.sel_all_on_board ? I18n.ctx_remove_board : I18n.detail_add_board;
                    activated => { root.batch_toggle_board(); ctx-popup.close(); }
                }
                CtxItem {
                    label: root.sel_all_rejected ? I18n.ctx_restore : I18n.ctx_skip;
                    danger: !root.sel_all_rejected;
                    activated => { root.batch_set_status(root.sel_all_rejected ? "pending" : "rejected"); ctx-popup.close(); }
                }
                CtxSep {}
                CtxItem {
                    label: I18n.review_start;
                    activated => { root.batch_run_review(); ctx-popup.close(); }
                }
                CtxItem {
                    label: I18n.ctx_copy_links;
                    activated => { root.batch_copy_links(); ctx-popup.close(); }
                }
                CtxSep {}
                CtxItem {
                    label: I18n.ctx_clear_selection;
                    hint: "Esc";
                    activated => { root.clear_multi_selection(); ctx-popup.close(); }
                }
            }
        }
    }
}
