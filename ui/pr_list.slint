// PR Desk — 分区 PR 列表组件（GPLv3）
// GitHub Dark / PR Desk 风格：表头行 + 28px 紧凑行 + 整行选中 + hover 快捷操作。
// 依赖共享契约：theme.slint 的 global Theme（含 sel/sel_text/hover/hairline），
// components.slint 的 Avatar / StatusDot / ScoreChip / SizeBadge / PriorityDot / TagChip。
import { Theme } from "theme.slint";
import { Avatar, StatusDot, ScoreChip, SizeBadge, PriorityDot, TagChip } from "components.slint";

// 单行 PR 数据（分组头不在此数组里，见 PrGroup）
export struct PrListRow {
    key: string,
    number: int,
    title: string,
    priority: int,      // 0 未排 / 1 高 / 2 中 / 3 低
    author: string,
    avatar: image,      // Rust 侧传入的头像
    is_org: bool,       // 作者是组织（显示组织图标占位）
    turn: string,       // me / them / ""
    review: string,     // approved / changes_requested / commented / review_required / ""
    ci: string,         // success / failure / pending / none / ""
    size: string,       // XS / S / M / L / XL / ""
    additions: int,
    deletions: int,
    score: float,       // 0 表示未评分（不显示 ScoreChip）
    age: string,        // 创建至今相对时间，如 "3d"
    updated: string,    // 最近更新相对时间，如 "2h"（优先于 age 显示）
    activity_text: string,  // 最近活动摘要，如 "author pushed 33m"（标题右侧 dim 拼接）
    pinned: bool,
    on_board: bool,
}

// 分组元数据：rows 按组顺序扁平排列，start/count 切片出本组行
export struct PrGroup {
    key: string,        // pinned / board / needs-review / reviewed / rejected / closed
    name: string,       // 显示名（Pinned / 看板 / 待评审 / 已评审 / 不采纳 / 已合入关闭）
    start: int,         // 在 rows 中的起始下标
    count: int,         // 本组行数
    collapsed: bool,
}

// 列宽契约（表头与数据行共用，保持一致）
//   P 12px / # 56px / Title 弹性 / Author 116px / Turn 40px
//   Review 24px / CI 24px / Size 30px / Age 40px / Updated 40px
global Cols {
    out property <length> priority: 12px;
    out property <length> number: 56px;
    out property <length> author: 116px;
    out property <length> turn: 40px;
    out property <length> review: 24px;
    out property <length> ci: 24px;
    out property <length> size: 30px;
    out property <length> age: 40px;
    out property <length> updated: 40px;
    out property <length> row-pad-l: 10px;
    out property <length> row-pad-r: 8px;
}

// ── 表头行：dim 小字 + 底部 hairline ──
component ListHeader inherits Rectangle {
    height: 26px;

    HorizontalLayout {
        padding-left: Cols.row-pad-l;
        padding-right: Cols.row-pad-r;
        spacing: 6px;
        alignment: center;

        Text { text: "P"; width: Cols.priority; font-size: 10px; color: Theme.text_dim; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: "#"; width: Cols.number; font-size: 10px; color: Theme.text_dim; vertical-alignment: center; }
        Text { text: "Title"; font-size: 10px; color: Theme.text_dim; horizontal-stretch: 1; vertical-alignment: center; }
        Text { text: "Author"; width: Cols.author; font-size: 10px; color: Theme.text_dim; vertical-alignment: center; }
        Text { text: "Turn"; width: Cols.turn; font-size: 10px; color: Theme.text_dim; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: "Rev"; width: Cols.review; font-size: 10px; color: Theme.text_dim; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: "CI"; width: Cols.ci; font-size: 10px; color: Theme.text_dim; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: "Size"; width: Cols.size; font-size: 10px; color: Theme.text_dim; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: "Age"; width: Cols.age; font-size: 10px; color: Theme.text_dim; horizontal-alignment: right; vertical-alignment: center; }
        Text { text: "Upd"; width: Cols.updated; font-size: 10px; color: Theme.text_dim; horizontal-alignment: right; vertical-alignment: center; }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 组头：小字 dim + 数量，hairline 分隔，更轻量 ──
component GroupHeader inherits Rectangle {
    in property <PrGroup> group;
    callback toggled();

    height: 24px;
    background: head-ta.has-hover ? Theme.hover : transparent;

    animate background { duration: 100ms; }

    head-ta := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.group.collapsed ? "▸" : "▾";
            color: Theme.text_dim;
            font-size: 10px;
            width: 12px;
            vertical-alignment: center;
        }
        Text {
            text: root.group.name;
            color: Theme.text_dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.group.count;
            color: Theme.text_dim;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── hover 快捷操作按钮 ──
component QuickAction inherits Rectangle {
    in property <string> glyph;
    callback activated();

    width: 22px;
    height: 20px;
    border-radius: 6px;
    background: qa-ta.has-hover ? Theme.border.with-alpha(0.8) : transparent;

    qa-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    Text {
        text: root.glyph;
        color: Theme.text_dim;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── Turn 标记：me accent 高亮 / them 灰 ──
component TurnChip inherits Rectangle {
    in property <string> turn;  // me / them

    property <bool> mine: root.turn == "me";

    height: 16px;
    width: layout.preferred-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.mine ? Theme.accent.with-alpha(0.5) : Theme.border;
    background: root.mine ? Theme.accent.with-alpha(0.18) : transparent;

    layout := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.mine ? "me" : "them";
            color: root.mine ? Theme.accent : Theme.text_dim;
            font-size: 10px;
            font-weight: root.mine ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

// ── 紧凑数据行（28px）──
// 选中：整行 accent 底 + 白字（PR Desk 风格）；hover：浅底 + 快捷操作浮现。
component PrRowItem inherits Rectangle {
    in property <PrListRow> pr;
    in property <bool> selected: false;
    in property <bool> zebra: false;   // 偶数行斑马纹
    callback clicked();
    callback pin();
    callback board();
    callback reject();

    // 选中行上所有文字统一用 sel_text（选中态前景色）
    property <color> fg: root.selected ? Theme.sel_text : Theme.text;
    property <color> fg-dim: root.selected ? Theme.sel_text.with-alpha(0.75) : Theme.text_dim;

    height: 28px;
    background: root.selected ? Theme.sel
        : (row-ta.has-hover ? Theme.hover
        : (root.zebra ? Theme.text.with-alpha(0.03) : transparent));

    animate background { duration: root.selected ? 150ms : 100ms; }

    row-ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Cols.row-pad-l;
        padding-right: Cols.row-pad-r;
        spacing: 6px;
        alignment: center;

        PriorityDot {
            priority: root.pr.priority;
            color: root.selected ? root.fg : (root.pr.priority == 1 ? Theme.bad
                : root.pr.priority == 2 ? Theme.mid : Theme.accent);
        }

        Text {
            text: "#" + root.pr.number;
            color: root.fg-dim;
            font-size: 11px;
            width: Cols.number;
            overflow: elide;
            vertical-alignment: center;
        }

        // 标题 + dim 最近活动文本（标题右侧拼接）
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            alignment: start;
            Text {
                text: root.pr.title;
                color: root.fg;
                font-size: 12px;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.pr.activity_text != "": Text {
                text: root.pr.activity_text;
                color: root.fg-dim;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // 作者：Avatar + 名字 + 组织图标占位
        HorizontalLayout {
            spacing: 4px;
            width: Cols.author;
            alignment: center;
            Avatar {
                img: root.pr.avatar;
                login: root.pr.author;
                size: 16px;
            }
            Text {
                text: root.pr.author;
                color: root.fg-dim;
                font-size: 11px;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.pr.is_org: TagChip { label: "org"; }
        }

        HorizontalLayout {
            width: Cols.turn;
            alignment: center;
            if root.pr.turn != "": TurnChip { turn: root.pr.turn; }
        }

        // Review 状态符号
        Text {
            text: root.pr.review == "approved" ? "✓"
                : (root.pr.review == "changes_requested" ? "✗"
                : (root.pr.review == "commented" ? "💬" : "○"));
            color: root.selected ? root.fg
                : (root.pr.review == "approved" ? Theme.good
                : (root.pr.review == "changes_requested" ? Theme.bad
                : (root.pr.review == "commented" ? Theme.text : Theme.text_dim)));
            font-size: 11px;
            width: Cols.review;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        HorizontalLayout {
            width: Cols.ci;
            alignment: center;
            StatusDot { status: root.pr.ci; }
        }

        HorizontalLayout {
            width: Cols.size;
            alignment: center;
            if root.pr.size != "": SizeBadge { label: root.pr.size; }
        }
        if root.pr.score > 0: ScoreChip { score: root.pr.score; }

        Text {
            text: root.pr.age;
            color: root.fg-dim;
            font-size: 11px;
            width: Cols.age;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            text: root.pr.updated != "" ? root.pr.updated : root.pr.age;
            color: root.fg-dim;
            font-size: 11px;
            width: Cols.updated;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // hover 快捷操作：pin / 看板 / 不采纳（浮现于行右端）
    if row-ta.has-hover: Rectangle {
        x: parent.width - self.width - 6px;
        width: actions.preferred-width + 8px;
        height: parent.height;
        background: root.selected ? Theme.sel : Theme.card;
        actions := HorizontalLayout {
            y: (parent.height - self.preferred-height) / 2;
            spacing: 2px;
            QuickAction { glyph: "📌"; activated => { root.pin(); } }
            QuickAction { glyph: "▦"; activated => { root.board(); } }
            QuickAction { glyph: "✕"; activated => { root.reject(); } }
        }
    }

    // 行底 hairline
    Rectangle {
        x: Cols.row-pad-l;
        y: parent.height - 1px;
        width: parent.width - Cols.row-pad-l;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 分区列表 ──
// rows 为扁平数据行（不含组头），groups 以 start/count 切片；groups 为空时退化为扁平列表。
// 折叠状态直接写在 groups[i].collapsed（in-out，集成方可用 VecModel 持久化）。
// 斑马纹下标基于「本组内可见行序」，折叠的组不参与。
export component PrListView inherits FocusScope {
    in property <[PrListRow]> rows: [];
    in-out property <[PrGroup]> groups: [];
    in-out property <int> selected_index: -1;   // in-out：集成方 Esc 取消选中时需要写

    callback row_activated(int);    // 点击或 Enter：打开详情（传 rows 下标）
    callback row_pin(int);
    callback row_reject(int);
    callback row_board(int);
    callback dismissed();           // Esc

    function move_selection(delta: int) {
        if (root.rows.length == 0) { return; }
        if (root.selected_index < 0 || root.selected_index >= root.rows.length) {
            root.selected_index = delta > 0 ? 0 : root.rows.length - 1;
            return;
        }
        root.selected_index = Math.min(root.rows.length - 1, Math.max(0, root.selected_index + delta));
    }

    // 键盘导航：j/k 或 ↑/↓ 移动，Enter 打开，Esc 取消
    key-pressed(event) => {
        if (event.text == "j" || event.text == Key.DownArrow) {
            root.move_selection(1);
            return accept;
        }
        if (event.text == "k" || event.text == Key.UpArrow) {
            root.move_selection(-1);
            return accept;
        }
        if (event.text == Key.Return) {
            if (root.selected_index >= 0 && root.selected_index < root.rows.length) {
                root.row_activated(root.selected_index);
            }
            return accept;
        }
        if (event.text == Key.Escape) {
            root.dismissed();
            return accept;
        }
        reject
    }

    Rectangle {
        background: Theme.bg;

        VerticalLayout {
            alignment: start;

            ListHeader {}

            Flickable {
                vertical-stretch: 1;
                content-height: list_col.preferred-height;

                list_col := VerticalLayout {
                    alignment: start;

                    // 空态
                    if root.rows.length == 0: Text {
                        text: "没有 PR";
                        color: Theme.text_dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        height: 48px;
                        vertical-alignment: center;
                    }

                    // 退化模式：未提供分组时扁平渲染
                    if root.rows.length > 0 && root.groups.length == 0: VerticalLayout {
                        alignment: start;
                        for r[i] in root.rows: PrRowItem {
                            pr: r;
                            selected: i == root.selected_index;
                            zebra: mod(i, 2) == 1;
                            clicked => {
                                root.selected_index = i;
                                root.row_activated(i);
                            }
                            pin => { root.row_pin(i); }
                            board => { root.row_board(i); }
                            reject => { root.row_reject(i); }
                        }
                    }

                    // 分组模式
                    for group[gi] in root.groups: VerticalLayout {
                        alignment: start;

                        GroupHeader {
                            group: group;
                            toggled => { root.groups[gi].collapsed = !root.groups[gi].collapsed; }
                        }

                        if !group.collapsed: VerticalLayout {
                            alignment: start;
                            for ri in group.count: PrRowItem {
                                private property <int> idx: group.start + ri;
                                pr: root.rows[self.idx];
                                selected: self.idx == root.selected_index;
                                zebra: mod(ri, 2) == 1;
                                clicked => {
                                    root.selected_index = self.idx;
                                    root.row_activated(self.idx);
                                }
                                pin => { root.row_pin(self.idx); }
                                board => { root.row_board(self.idx); }
                                reject => { root.row_reject(self.idx); }
                            }
                        }
                    }
                }
            }
        }
    }
}
