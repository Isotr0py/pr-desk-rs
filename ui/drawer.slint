// PR Desk — 详情抽屉（GitHub Dark 风格骨架）。
// 右侧固定宽度（父级 42%，下限 360px），open 时从右边缘滑入。
// 用法注意：作为窗口顶层直接子元素放置（不要放进 Layout，否则 x/width 会被布局接管），
// 并放在其他内容之后以保证层级在最上；遮罩层由集成方按需自加。
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// 幽灵按钮：hover 淡底色，active 时描边与文字着 tint 色
component GhostBtn inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.accent;
    in property <bool> active: false;
    callback clicked();

    width: t.preferred-width + 20px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? root.tint : Theme.border;
    background: root.active ? root.tint.transparentize(0.85)
        : (ta.has-hover ? root.tint.transparentize(0.92) : transparent);

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    t := Text {
        text: root.label;
        color: root.active || ta.has-hover ? root.tint : Theme.text;
        font-size: 12px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 空状态占位：图标 + 标题 + 提示，居中
component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> heading;
    in property <string> hint;

    VerticalLayout {
        padding: 24px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.icon;
            font-size: 26px;
            color: Theme.purple;
            horizontal-alignment: center;
        }
        Text {
            text: root.heading;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            font-size: 12px;
            color: Theme.text-dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component DetailDrawer inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> subtitle;              // repo#number · 作者 · 状态
    in property <string> body_html_free_text;   // 评审摘要纯文本（已服务端转义）
    in property <[string]> tabs: ["评审", "会话", "Checks", "Files"];
    // 会话/Checks/Files 的简易文本渲染（集成方填充；空串 → 空状态占位）
    in property <string> convo_text: "";
    in property <string> checks_text: "";
    in property <string> files_text: "";
    in-out property <int> current_tab: 0;
    // 可选增强：当前优先级（0 未排 1 高 2 中 3 低），仅用于高亮 1/2/3 分段按钮
    in property <int> current_priority: 0;

    callback close();
    callback action_requeue();
    callback action_toggle_reject();
    callback action_set_priority(int);

    // 根元素透明铺满父级（不拦截输入），面板在内部滑动
    background: transparent;

    panel := Rectangle {
        width: max(360px, parent.width * 0.42);
        height: parent.height;
        x: root.open ? parent.width - panel.width : parent.width;
        background: Theme.card;
        drop-shadow-color: #00000099;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: -6px;
        clip: true;

        animate x { duration: 240ms; easing: ease-out-quad; }

        // 左缘 hairline
        Rectangle {
            x: 0;
            y: 0;
            width: 1px;
            height: 100%;
            background: Theme.border;
        }

    VerticalLayout {
        // ── 标题区 ──
        Rectangle {
            background: Theme.card;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.title == "" ? "未选择 PR" : root.title;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    // 关闭按钮
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: close_ta.has-hover ? Theme.border.transparentize(0.6) : transparent;
                        close_ta := TouchArea {
                            clicked => { root.close(); }
                        }
                        Text {
                            text: "✕";
                            color: close_ta.has-hover ? Theme.text : Theme.text-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.subtitle;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }

                // ── 操作按钮行 ──
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    GhostBtn {
                        label: "↻ 重新评审";
                        tint: Theme.accent;
                        clicked => { root.action_requeue(); }
                    }
                    GhostBtn {
                        label: "不采纳";
                        tint: Theme.bad;
                        clicked => { root.action_toggle_reject(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "优先级";
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    GhostBtn {
                        width: 28px;
                        label: "1";
                        tint: Theme.bad;
                        active: root.current_priority == 1;
                        clicked => { root.action_set_priority(1); }
                    }
                    GhostBtn {
                        width: 28px;
                        label: "2";
                        tint: Theme.mid;
                        active: root.current_priority == 2;
                        clicked => { root.action_set_priority(2); }
                    }
                    GhostBtn {
                        width: 28px;
                        label: "3";
                        tint: Theme.text-dim;
                        active: root.current_priority == 3;
                        clicked => { root.action_set_priority(3); }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── 标签页切换条（当前标签下划线 accent 高亮）──
        Rectangle {
            height: 36px;
            background: Theme.card;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                for tab[i] in root.tabs: Rectangle {
                    width: tab_label.preferred-width + 20px;
                    tab_ta := TouchArea {
                        clicked => { root.current_tab = i; }
                    }
                    tab_label := Text {
                        text: tab;
                        color: root.current_tab == i || tab_ta.has-hover ? Theme.text : Theme.text-dim;
                        font-size: 13px;
                        font-weight: root.current_tab == i ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: 6px;
                        y: parent.height - 2px;
                        width: parent.width - 12px;
                        height: 2px;
                        border-radius: 1px;
                        background: root.current_tab == i ? Theme.accent : transparent;
                        animate background { duration: 150ms; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── 内容区（骨架 + 空状态占位；真实数据渲染由集成方填充）──
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            // 评审：有摘要时滚动展示纯文本，否则空状态
            if root.current_tab == 0: Rectangle {
                if root.body_html_free_text != "": ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        Text {
                            text: root.body_html_free_text;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.body_html_free_text == "": EmptyState {
                    icon: "✦";
                    heading: "暂无评审内容";
                    hint: "点击上方「重新评审」，让评审服务重新分析这个 PR";
                }
            }

            if root.current_tab == 1: Rectangle {
                if root.convo_text != "": ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        Text {
                            text: root.convo_text;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.convo_text == "": EmptyState {
                    icon: "💬";
                    heading: "暂无会话记录";
                    hint: "提交与评审活动将显示在这里";
                }
            }
            if root.current_tab == 2: Rectangle {
                if root.checks_text != "": ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        Text {
                            text: root.checks_text;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.checks_text == "": EmptyState {
                    icon: "✓";
                    heading: "暂无 Checks";
                    hint: "这个 PR 还没有关联的 CI 检查记录";
                }
            }
            if root.current_tab == 3: Rectangle {
                if root.files_text != "": ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        Text {
                            text: root.files_text;
                            color: Theme.text;
                            font-size: 13px;
                            font-family: "Consolas";
                            wrap: word-wrap;
                        }
                    }
                }
                if root.files_text == "": EmptyState {
                    icon: "📄";
                    heading: "暂无文件变更";
                    hint: "Diff 文件列表将显示在这里";
                }
            }
            if root.current_tab < 0 || root.current_tab > 3: EmptyState {
                icon: "🚧";
                heading: "即将推出";
                hint: "这个标签页还没有实现";
            }
        }
    }
    }
}
