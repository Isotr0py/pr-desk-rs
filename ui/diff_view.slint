// PR Desk — Diff 查看器组件（GitHub Dark 视觉基准，GPLv3）
//
// 设计说明：
// - 纯 Slint 表达式不支持数组 fold，文件头的增删行数由隐藏的零尺寸计数
//   repeater 在 init 时累加得到。因此集成方必须用「整体替换 files 模型」
//   的方式更新（set_files(ModelRc::new(...))），不要原地修改某一行，
//   否则计数会重复累加。
// - 折叠状态以数据为准（DiffFile.expanded），点击头部只发 file_toggled(i)，
//   由 Rust 侧翻转后重建模型。
// - 每个文件最多渲染 max-render-lines 行，超出显示截断提示。
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct DiffLine {
    kind: string,   // add / del / hunk / meta / ctx
    text: string,
}

export struct DiffFile {
    path: string,
    lines: [DiffLine],
    expanded: bool,
}

export component DiffView inherits Rectangle {
    in property <[DiffFile]> files: [];
    // 前 N 个文件默认展开——供 Rust 侧构建模型时读取（Slint 侧不消费）
    in-out property <int> expanded_count_init: 3;
    callback file_toggled(int);

    // 单文件渲染行数上限
    in property <int> max_render_lines: 2000;

    property <length> header-h: 30px;
    property <length> line-h: 18px;
    property <length> trunc-h: 24px;

    background: Theme.bg;
    clip: true;

    if root.files.length == 0: Text {
        text: "无 diff 内容";
        color: Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ListView {
        width: 100%;
        height: 100%;

        for file[fi] in root.files: file-block := Rectangle {
            property <int> adds: 0;
            property <int> dels: 0;
            property <int> shown: min(file.lines.length, root.max-render-lines);
            property <bool> truncated: file.lines.length > root.max-render-lines;
            property <length> body-h: file.expanded
                ? shown * root.line-h + (truncated ? root.trunc-h : 0px)
                : 0px;

            height: root.header-h + body-h;
            background: transparent;

            // 隐藏计数器：随委托重建重新累加（前提：模型整体替换）
            for line in file.lines: Rectangle {
                width: 0px;
                height: 0px;
                visible: false;
                init => {
                    if line.kind == "add" {
                        adds += 1;
                    }
                    if line.kind == "del" {
                        dels += 1;
                    }
                }
            }

            // ── 文件头：折叠箭头 + 路径 + 增删统计 ──
            header := Rectangle {
                y: 0px;
                width: 100%;
                height: root.header-h - 4px;
                border-radius: 6px;
                background: header-touch.has-hover ? #ffffff0d : Theme.card;
                border-width: 1px;
                border-color: header-touch.has-hover ? Theme.border : transparent;

                header-touch := TouchArea {
                    clicked => { root.file_toggled(fi); }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        width: 14px;
                        text: file.expanded ? "▾" : "▸";
                        color: Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: file.path;
                        color: Theme.accent;
                        font-family: "Consolas";
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "+" + adds;
                        color: Theme.good;
                        font-family: "Consolas";
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "−" + dels;
                        color: Theme.bad;
                        font-family: "Consolas";
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: file.lines.length + " 行";
                        color: Theme.text-dim;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // 文件之间的 hairline 分隔线
            Rectangle {
                y: root.header-h - 2px;
                width: 100%;
                height: 1px;
                background: Theme.border;
            }

            // ── 行区（仅展开时）──
            if file.expanded: Rectangle {
                y: root.header-h;
                width: 100%;
                height: file-block.body-h;
                clip: true;

                for line[li] in file.lines: Rectangle {
                    y: li * root.line-h;
                    width: 100%;
                    height: root.line-h;
                    visible: li < root.max-render-lines;
                    background: line.kind == "add" ? #3fb95026
                        : (line.kind == "del" ? #f8514926
                        : (line.kind == "hunk" ? Theme.card : transparent));

                    // read-only TextInput：行内文本可选中复制
                    TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        read-only: true;
                        single-line: true;
                        enabled: true;
                        text: line.text;
                        font-family: "Consolas";
                        font-size: 12px;
                        font-weight: (line.kind == "hunk" || line.kind == "meta") ? 700 : 400;
                        color: line.kind == "hunk" ? Theme.purple
                            : (line.kind == "meta" ? Theme.text-dim
                            : (line.kind == "ctx" ? Theme.text-dim
                            : (line.kind == "add" ? #7ee787
                            : (line.kind == "del" ? #ffa198
                            : Theme.text))));
                        selection-background-color: #58a6ff44;
                        vertical-alignment: center;
                    }
                }

                // 截断提示
                if truncated: Rectangle {
                    y: shown * root.line-h;
                    width: 100%;
                    height: root.trunc-h;
                    background: Theme.card;
                    Text {
                        x: 8px;
                        text: "… 已截断：仅显示前 " + root.max-render-lines
                            + " 行（共 " + file.lines.length + " 行）";
                        color: Theme.mid;
                        font-family: "Consolas";
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
