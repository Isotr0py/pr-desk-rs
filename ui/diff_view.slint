// PR Desk — Diff 查看器组件（GitHub 级观感，GPLv3）
//
// 设计说明：
// - 纯 Slint 表达式不支持数组 fold，文件头的增删行数由隐藏的零尺寸计数
//   repeater 在 init 时累加得到。因此集成方必须用「整体替换 files 模型」
//   的方式更新（set_files(ModelRc::new(...))），不要原地修改某一行，
//   否则计数会重复累加。
// - 折叠状态以数据为准（DiffFile.expanded），点击头部只发 file_toggled(i)，
//   由 Rust 侧翻转后重建模型。
// - 每个文件最多渲染 max-render-lines 行，超出显示截断提示。
// - DiffLine 结构没有真实行号字段，行号列暂以「文件内行序号」代替。
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";

export struct DiffLine {
    kind: string,   // add / del / hunk / meta / ctx
    text: string,
}

export struct DiffFile {
    path: string,
    lines: [DiffLine],
    expanded: bool,
}

export component DiffView inherits Rectangle {
    in property <[DiffFile]> files: [];
    // 前 N 个文件默认展开——供 Rust 侧构建模型时读取（Slint 侧不消费）
    in-out property <int> expanded_count_init: 3;
    callback file_toggled(int);

    // 单文件渲染行数上限
    in property <int> max_render_lines: 2000;

    property <length> header-h: 32px;
    property <length> line-h: 20px;
    property <length> trunc-h: 26px;
    // 行号列宽（GitHub 风格 gutter）
    property <length> gutter-w: 48px;

    background: Theme.bg;
    clip: true;

    // ── 空状态：居中 SVG 图标 + 提示文案 ──
    if root.files.length == 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            height: 32px;
            Image {
                source: @image-url("icons/file.svg");
                width: 30px;
                height: 30px;
                x: (parent.width - self.width) / 2;
                image-fit: contain;
                colorize: Theme.text_faint;
            }
        }
        Text {
            text: I18n.diff_empty_title;
            font-size: Theme.fs_md;
            color: Theme.text_dim;
            horizontal-alignment: center;
        }
        Text {
            text: I18n.diff_empty_hint;
            font-size: Theme.fs_xs;
            color: Theme.text_faint;
            horizontal-alignment: center;
        }
    }

    ListView {
        width: 100%;
        height: 100%;

        for file[fi] in root.files: file-block := Rectangle {
            property <int> adds: 0;
            property <int> dels: 0;
            property <int> shown: min(file.lines.length, root.max-render-lines);
            property <bool> truncated: file.lines.length > root.max-render-lines;
            property <length> body-h: file.expanded
                ? shown * root.line-h + (truncated ? root.trunc-h : 0px)
                : 0px;

            height: root.header-h + body-h;
            background: Theme.bg;
            clip: true;

            // 折叠/展开高度过渡
            animate height { duration: 120ms; easing: ease-in-out; }

            // 隐藏计数器：随委托重建重新累加（前提：模型整体替换）
            for line in file.lines: Rectangle {
                width: 0px;
                height: 0px;
                visible: false;
                init => {
                    if line.kind == "add" {
                        adds += 1;
                    }
                    if line.kind == "del" {
                        dels += 1;
                    }
                }
            }

            // ── 文件头：surface2 底 + 上下 hairline，左箭头+文件名，右 +N/-N ──
            header := Rectangle {
                y: 0px;
                width: 100%;
                height: root.header-h;
                background: Theme.surface2;

                // 上 / 下发丝分隔线
                Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.hairline; }
                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.hairline; }

                // hover 罩层
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.hover;
                    opacity: header-touch.has-hover ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }

                header-touch := TouchArea {
                    clicked => { root.file_toggled(fi); }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 8px;

                    Rectangle {
                        width: 14px;
                        Image {
                            source: file.expanded
                                ? @image-url("icons/chevron-down.svg")
                                : @image-url("icons/chevron-right.svg");
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            colorize: Theme.text_dim;
                        }
                    }
                    Text {
                        text: file.path;
                        color: Theme.text;
                        font-family: "Consolas";
                        font-size: Theme.fs_md;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "+" + adds;
                        color: Theme.good;
                        font-family: "Consolas";
                        font-size: Theme.fs_xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "-" + dels;
                        color: Theme.bad;
                        font-family: "Consolas";
                        font-size: Theme.fs_xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: file.expanded ? I18n.diff_collapse : I18n.diff_expand;
                        color: Theme.text_faint;
                        font-size: Theme.fs_xs;
                        vertical-alignment: center;
                    }
                }
            }

            // ── 行区（高度随折叠动画，内容裁剪） ──
            body := Rectangle {
                y: root.header-h;
                width: 100%;
                height: parent.height - root.header-h;
                clip: true;
                opacity: file.expanded ? 1 : 0;
                animate opacity { duration: 120ms; }

                for line[li] in file.lines: Rectangle {
                    y: li * root.line-h;
                    width: 100%;
                    height: root.line-h;
                    visible: li < root.max-render-lines;
                    background: line.kind == "add" ? Theme.green_bg
                        : (line.kind == "del" ? Theme.red_bg
                        : (line.kind == "hunk" ? Theme.accent.with-alpha(0.08)
                        : transparent));

                    // 行号列：48px 宽、右对齐、略深底色
                    Rectangle {
                        x: 0px;
                        width: root.gutter-w;
                        height: 100%;
                        background: Theme.surface2;
                        Text {
                            x: 0px;
                            width: parent.width - 8px;
                            height: 100%;
                            text: line.kind == "hunk" ? "..." : "\{li + 1}";
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: Theme.text_faint;
                            font-family: "Consolas";
                            font-size: Theme.fs_xs;
                        }
                        // 行号与代码之间的分隔线
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            height: 100%;
                            background: Theme.hairline;
                        }
                    }

                    // read-only TextInput：行内文本可选中复制
                    TextInput {
                        x: root.gutter-w + 8px;
                        width: parent.width - root.gutter-w - 16px;
                        height: parent.height;
                        read-only: true;
                        single-line: true;
                        enabled: true;
                        text: line.text;
                        font-family: "Consolas";
                        font-size: Theme.fs_sm;
                        color: line.kind == "hunk" ? Theme.text_dim
                            : (line.kind == "meta" ? Theme.text_dim
                            : Theme.text);
                        selection-background-color: Theme.accent.with-alpha(0.28);
                        vertical-alignment: center;
                    }
                }

                // 截断提示
                if truncated: Rectangle {
                    y: shown * root.line-h;
                    width: 100%;
                    height: root.trunc-h;
                    background: Theme.surface2;
                    Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.hairline; }
                    Text {
                        x: root.gutter-w + 8px;
                        height: 100%;
                        text: I18n.diff_truncated_p1 + root.max-render-lines
                            + I18n.diff_truncated_p2 + file.lines.length + I18n.diff_truncated_p3;
                        color: Theme.text_dim;
                        font-family: "Consolas";
                        font-size: Theme.fs_xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
