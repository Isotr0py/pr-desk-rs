// PR Desk — Diff 查看器组件（GitHub 级观感，GPLv3）
//
// 设计说明：
// - 模型是「摊平」的 DiffRow 列表：每个文件一个 header 行，展开时跟若干内容行
//   （+ 可能的截断提示行），折叠的文件只有 header 行。外层一个 ListView 纵向
//   虚拟化（视口外不实例化委托），替代旧的「每文件一块、块内全量行」结构。
// - 折叠状态以数据为准（header 行 DiffRow.expanded），点击只发 file_toggled(file_idx)，
//   由 Rust 侧翻转后重建模型（行内容在折叠时不在 UI 模型里，UI 无法自行展开）。
// - 行号是真行号（Rust 侧 diffview::numbered_lines 解析 hunk 头算出）：
//   add/ctx 用 new 侧、del 用 old 侧；lineno = 0 的行（meta/hunk）不显示行号。
// - 横向滚动是单一外层 Flickable 包整个 ListView（GitHub 风格整表横滚，gutter 随内容
//   滚动）；content-width 由最长行文本（max_text，Rust 侧选出）的测量宽决定。
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";

// 摊平后的 diff 行：header（文件头）/ 内容行 / 截断提示行 三态
export struct DiffRow {
    is_header: bool,
    is_trunc: bool,     // 截断提示行（仅显示前 shown 行，共 total 行）
    file_idx: int,      // 所属文件下标（file_toggled 回传用）
    // ── header 行字段 ──
    path: string,
    adds: int,
    dels: int,
    expanded: bool,
    // ── 内容行字段 ──
    kind: string,       // add / del / hunk / meta / ctx
    text: string,
    lineno: int,        // 真实行号；0 = 无行号（meta/hunk）
    // ── 截断提示行字段 ──
    shown: int,
    total: int,
}

export component DiffView inherits Rectangle {
    in property <[DiffRow]> rows: [];
    callback file_toggled(int);   // 参数为 file_idx（不是模型行下标）

    // PageUp/PageDown 翻页（外层 FocusScope 调用；ListView 自己不认键盘）
    public function page_scroll(dir: int) {
        if (dir > 0) {
            lv.content-y = max(lv.height - lv.content-height, lv.content-y - lv.height * 0.9);
        } else {
            lv.content-y = min(0px, lv.content-y + lv.height * 0.9);
        }
    }

    property <length> header-h: 32px;
    property <length> line-h: 20px;
    property <length> trunc-h: 26px;
    // 行号列宽（GitHub 风格 gutter）
    property <length> gutter-w: 48px;
    // 最长内容行（Rust 侧按显示宽度挑出传入）：测量其像素宽以决定横向滚动区域
    in property <string> max_text: "";

    // 换 diff（开新 PR / 重新拉取）时回最左，避免带着上一个 diff 的滚动位置
    changed rows => { hf.content-x = 0px; }

    background: Theme.bg;
    clip: true;

    // ── 空状态：居中 SVG 图标 + 提示文案 ──
    if root.rows.length == 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            height: 32px;
            Image {
                source: @image-url("icons/file.svg");
                width: 30px;
                height: 30px;
                x: (parent.width - self.width) / 2;
                image-fit: contain;
                colorize: Theme.text_faint;
            }
        }
        Text {
            text: I18n.diff_empty_title;
            font-size: Theme.fs_md;
            color: Theme.text_dim;
            horizontal-alignment: center;
        }
        Text {
            text: I18n.diff_empty_hint;
            font-size: Theme.fs_xs;
            color: Theme.text_faint;
            horizontal-alignment: center;
        }
    }

    // 单一横向 Flickable 包整个 ListView：GitHub 风格整屏同步横滚（gutter 随内容滚动）。
    // content-width 由最长行文本（root.max_text）的测量宽给出。
    hf := Flickable {
        width: 100%;
        height: 100%;
        content-height: self.height;
        content-width: max(self.width, root.gutter-w + measure.preferred-width + 12px);

        // 测量用文本：不能用 visible: false（不参与布局计量，preferred-width 恒 0），
        // 用 opacity: 0 保持不可见但正常计量；字号/字体必须与行内 TextInput 完全一致
        measure := Text {
            opacity: 0;
            text: root.max_text;
            font-family: Theme.mono_font;
            font-size: Theme.fs_sm;
        }

    lv := ListView {
        width: hf.content-width;
        height: hf.height;

        for it in root.rows: row-rect := Rectangle {
            height: it.is_header ? root.header-h : (it.is_trunc ? root.trunc-h : root.line-h);
            background: it.is_header ? Theme.surface2
                : (it.is_trunc ? Theme.surface2
                : (it.kind == "add" ? Theme.green_bg
                : (it.kind == "del" ? Theme.red_bg
                : (it.kind == "hunk" ? Theme.accent.with-alpha(0.08)
                : transparent))));

            // ── 文件头：上下 hairline，左箭头+文件名，右 +N/-N ──
            if it.is_header: Rectangle {
                width: 100%;
                height: 100%;

                Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.hairline; }
                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.hairline; }

                // hover 罩层
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.hover;
                    opacity: header-touch.has-hover ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }

                header-touch := TouchArea {
                    clicked => { root.file_toggled(it.file_idx); }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 8px;

                    Rectangle {
                        width: 14px;
                        Image {
                            source: it.expanded
                                ? @image-url("icons/chevron-down.svg")
                                : @image-url("icons/chevron-right.svg");
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            colorize: Theme.text_dim;
                        }
                    }
                    Text {
                        text: it.path;
                        color: Theme.text;
                        font-family: Theme.mono_font;
                        font-size: Theme.fs_md;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "+" + it.adds;
                        color: Theme.good;
                        font-family: Theme.mono_font;
                        font-size: Theme.fs_xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "-" + it.dels;
                        color: Theme.bad;
                        font-family: Theme.mono_font;
                        font-size: Theme.fs_xs;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: it.expanded ? I18n.diff_collapse : I18n.diff_expand;
                        color: Theme.text_faint;
                        font-size: Theme.fs_xs;
                        vertical-alignment: center;
                    }
                }
            }

            // ── 截断提示行 ──
            if it.is_trunc: Rectangle {
                width: 100%;
                height: 100%;
                Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.hairline; }
                Text {
                    x: root.gutter-w + 8px;
                    height: 100%;
                    text: I18n.diff_truncated_p1 + it.shown
                        + I18n.diff_truncated_p2 + it.total + I18n.diff_truncated_p3;
                    color: Theme.text_dim;
                    font-family: Theme.mono_font;
                    font-size: Theme.fs_xs;
                    vertical-alignment: center;
                }
            }

            // ── 内容行：gutter 固定 + 内容区独立横向 Flickable ──
            if !it.is_header && !it.is_trunc: Rectangle {
                width: 100%;
                height: 100%;

                // 行号列：48px 宽、右对齐、略深底色
                Rectangle {
                    x: 0px;
                    width: root.gutter-w;
                    height: 100%;
                    background: Theme.surface2;
                    Text {
                        x: 0px;
                        width: parent.width - 8px;
                        height: 100%;
                        text: it.kind == "hunk" ? "…" : (it.lineno > 0 ? "\{it.lineno}" : "");
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: Theme.text_faint;
                        font-family: Theme.mono_font;
                        font-size: Theme.fs_xs;
                    }
                    // 行号与代码之间的分隔线
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Theme.hairline;
                    }
                }

                // 内容区：行宽 = 内容区全宽（外层 hf 的 content-width ≥ 最长行宽），
                // 横向滚动由外层统一负责，行内不再需要 Flickable。
                // read-only TextInput：行内文本可选中复制
                TextInput {
                    x: root.gutter-w;
                    y: 0px;
                    width: parent.width - root.gutter-w;
                    height: 100%;
                    read-only: true;
                    single-line: true;
                    enabled: true;
                    text: it.text;
                    font-family: Theme.mono_font;
                    font-size: Theme.fs_sm;
                    color: it.kind == "hunk" ? Theme.text_dim
                        : (it.kind == "meta" ? Theme.text_dim
                        : Theme.text);
                    selection-background-color: Theme.accent.with-alpha(0.28);
                    vertical-alignment: center;
                }
            }
        }
    }
    }
}
