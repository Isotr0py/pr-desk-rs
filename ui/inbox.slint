// PR Desk — Inbox 通知列表（GitHub Notifications）
// 28px 紧凑行：未读蓝点 + repo（dim）+ 标题（未读加粗）+ kind 徽章 + reason（dim）+ 相对时间（dim 右对齐）。
// 顶部工具栏：全部已读 / 只看未读开关。键盘：j/k/↑↓ 移动，Enter 打开浏览器，Esc 取消选中。
// 样式全部走 Theme 令牌；空态用 components.slint 的 EmptyState。
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";
import { EmptyState, Avatar, MarkdownBlocks } from "components.slint";
import { ScrollView, ListView } from "std-widgets.slint";
import { ConvoEntry, FileChange } from "detail_panel.slint";
import { DiffView, DiffRow } from "diff_view.slint";

// 单行通知数据（updated 已是相对时间文本，Rust 侧换算；url 是可直接打开的 HTML URL）
export struct NotifRow {
    id: string,         // GitHub thread id（标记已读用）
    repo: string,       // repository.full_name
    title: string,
    kind: string,       // subject.type 原值：PullRequest / Issue / Release / Discussion / CheckSuite…（逻辑判断用）
    kind_label: string, // kind 的本地化显示文本（Rust 侧映射，未知值回退原串）
    reason: string,     // 本地化后的原因文本（review_requested → 审查请求 / Review requested…）
    updated: string,    // 相对时间，如 "2h"
    unread: bool,
    url: string,        // HTML URL（subject.url 由 Rust 侧转换）
    added: bool,        // PR 已在本地库（「+ 预评审」→「已加入」反馈）
    state: string,      // open / closed / merged（GraphQL 批量补的；空 = 未知/非 PR·Issue）
}

// ── kind 徽章：固定宽度 + 按类型着色（kind=原始类型决定色调，label=本地化显示文本）──
component KindBadge inherits Rectangle {
    in property <string> kind;
    in property <string> label;

    property <color> tone: root.kind == "PullRequest" ? Theme.accent
        : root.kind == "Issue" ? Theme.purple
        : root.kind == "Release" ? Theme.good
        : Theme.mid;

    width: 82px;   // 固定宽度，保证 PullRequest/Issue 等徽章对齐
    height: 18px;
    border-radius: 9px;
    background: root.tone.with-alpha(0.12);

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: Theme.fs_xs;
        font-weight: 500;
        color: root.tone;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── 工具栏小按钮：22px 高、描边、hover 微亮 ──
component ToolButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;   // 确认态红字（两步确认用）
    callback clicked();

    height: 22px;
    width: layout.preferred-width;
    border-radius: Theme.r_sm;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            font-size: Theme.fs_xs;
            color: root.danger ? Theme.bad : (ta.has-hover ? Theme.text : Theme.text_dim);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── 表头列宽拖拽手柄：8px 宽热区，拖动列分界线调整该列（Title 弹性吸收）──
// dragged 回调收到的是鼠标在表头坐标系下的绝对 x——用手柄自身 x + 相对位移算出。
component InboxColHandle inherits Rectangle {
    callback dragged(length);

    // 拖拽期间「左列 + 右列」宽度之和不变，每次事件先暂存再分配
    in-out property <length> pair-total;

    width: 8px;

    // 常显细分隔线（居中 1px），hover/拖拽时整根手柄显示 accent 色条
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        height: 12px;
        y: (parent.height - self.height) / 2;
        background: ta.has-hover || ta.pressed ? Theme.accent : Theme.text_faint;
    }
    background: ta.pressed ? Theme.accent.with-alpha(0.25) : transparent;

    ta := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(root.x + self.mouse-x);
            }
        }
    }
}

// ── 表头行：列标签 + 拖拽手柄，底部 hairline ──
// 与 NotifRowItem 共用同一套列坐标公式（InboxCols），保证任何宽度下逐像素对齐。
component InboxHeader inherits Rectangle {
    height: 26px;

    // 列 x 坐标（与 NotifRowItem 相同）
    property <length> x-dot: InboxCols.pad-l;
    property <length> x-repo: x-dot + InboxCols.dot + 8px;
    property <length> x-state: x-repo + InboxCols.repo + 8px;
    property <length> x-title: x-state + InboxCols.state + 4px;
    property <length> x-kind: root.width - InboxCols.pad-r - InboxCols.time - 8px - InboxCols.reason - 8px - InboxCols.kind;
    property <length> x-reason: x-kind + InboxCols.kind + 8px;
    property <length> x-time: x-reason + InboxCols.reason + 8px;

    Text { x: root.x-repo; height: 100%; text: I18n.inbox_col_repo; font-size: Theme.fs_xs; font-weight: 500; color: Theme.text_dim; vertical-alignment: center; }
    Text { x: root.x-title; height: 100%; text: I18n.inbox_col_title; font-size: Theme.fs_xs; font-weight: 500; color: Theme.text_dim; vertical-alignment: center; }
    Text { x: root.x-kind; width: InboxCols.kind; height: 100%; text: I18n.inbox_col_type; font-size: Theme.fs_xs; font-weight: 500; color: Theme.text_dim; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: root.x-reason; width: InboxCols.reason; height: 100%; text: I18n.inbox_col_reason; font-size: Theme.fs_xs; font-weight: 500; color: Theme.text_dim; vertical-alignment: center; }
    Text { x: root.x-time; width: InboxCols.time; height: 100%; text: I18n.inbox_col_time; font-size: Theme.fs_xs; font-weight: 500; color: Theme.text_dim; horizontal-alignment: right; vertical-alignment: center; }

    // 列宽拖拽手柄（Title 弹性吸收）
    // Repo | Title：Repo 变宽，Title 吸收
    InboxColHandle {
        x: root.x-title - 7px;
        height: parent.height;
        dragged(hx) => { InboxCols.repo = min(400px, max(80px, hx - 3px - root.x-repo)); }
    }
    // Title | Kind：Kind 变宽，Title 吸收
    InboxColHandle {
        x: root.x-kind - 7px;
        height: parent.height;
        dragged(hx) => { InboxCols.kind = min(160px, max(60px, InboxCols.kind + root.x-kind - 3px - hx)); }
    }
    // Kind | Reason
    InboxColHandle {
        x: root.x-reason - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = InboxCols.kind + InboxCols.reason;
            InboxCols.kind = min(self.pair-total - 60px, max(60px, hx - 3px - root.x-kind));
            InboxCols.reason = self.pair-total - InboxCols.kind;
        }
    }
    // Reason | Time
    InboxColHandle {
        x: root.x-time - 7px;
        height: parent.height;
        dragged(hx) => {
            self.pair-total = InboxCols.reason + InboxCols.time;
            InboxCols.reason = min(self.pair-total - 32px, max(60px, hx - 3px - root.x-reason));
            InboxCols.time = self.pair-total - InboxCols.reason;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 开关胶囊：开 = accent tint 底 + accent 字，关 = 透明底 hover 加深，无描边 ──
component TogglePill inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked();

    height: 22px;
    width: layout.preferred-width;
    border-radius: 11px;
    background: root.on ? Theme.accent.with-alpha(0.12) : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        if root.on: Rectangle {
            width: 10px;
            Image {
                source: @image-url("icons/check.svg");
                width: 9px;
                height: 9px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: Theme.accent;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.fs_xs;
            font-weight: root.on ? 600 : 400;
            color: root.on ? Theme.accent : Theme.text_dim;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Inbox 列宽契约（表头与数据行共用）。in-out：表头拖拽手柄可改列宽。
//   dot 8px / repo 180px / state 12px / title 弹性 / kind 82px / reason 110px / time 40px
global InboxCols {
    in-out property <length> dot: 8px;
    in-out property <length> repo: 180px;
    out property <length> state: 12px;
    in-out property <length> kind: 82px;
    in-out property <length> reason: 110px;
    in-out property <length> time: 40px;
    out property <length> pad-l: 10px;
    out property <length> pad-r: 10px;
}

// ── 状态点（GitHub 配色：open 绿 / merged 紫 / closed 红）──
component StateDot inherits Rectangle {
    in property <string> state;

    property <color> tone: root.state == "open" ? Theme.good
        : root.state == "merged" ? Theme.purple
        : Theme.bad;   // closed

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.tone;
    visible: root.state != "";
}

// ── 单行通知（28px）：选中 sel 底 + 左侧 accent 竖条；hover 用 Theme.hover；行底 hairline ──
// 列坐标与 InboxHeader 共用同一套公式（绝对定位），保证任何宽度下逐像素对齐。
component NotifRowItem inherits Rectangle {
    in property <NotifRow> notif;
    in property <bool> selected: false;
    callback clicked();
    callback add_review();

    property <color> fg: root.selected ? Theme.sel_text : Theme.text;
    property <color> fg-dim: root.selected ? Theme.sel_text.with-alpha(0.75) : Theme.text_dim;

    // 列 x 坐标（与 InboxHeader 共用同一套公式）
    property <length> x-dot: InboxCols.pad-l;
    property <length> x-repo: x-dot + InboxCols.dot + 8px;
    property <length> x-state: x-repo + InboxCols.repo + 8px;
    property <length> x-title: x-state + InboxCols.state + 4px;
    property <length> x-kind: root.width - InboxCols.pad-r - InboxCols.time - 8px - InboxCols.reason - 8px - InboxCols.kind;
    property <length> x-reason: x-kind + InboxCols.kind + 8px;
    property <length> x-time: x-reason + InboxCols.reason + 8px;

    height: 28px * Theme.fs_scale;
    background: root.selected ? Theme.sel
        : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: root.selected ? 150ms : 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // 选中指示条：左侧 2px accent 竖条
    Rectangle {
        x: 0;
        y: 0;
        width: 2px;
        height: parent.height;
        background: Theme.accent;
        visible: root.selected;
    }

    // 未读蓝点（已读时占位保持对齐）
    Rectangle {
        x: root.x-dot;
        width: InboxCols.dot;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: root.notif.unread ? Theme.accent : transparent;
    }

    Text {
        x: root.x-repo;
        width: InboxCols.repo;
        height: parent.height;
        text: root.notif.repo;
        color: root.fg-dim;
        font-size: Theme.fs_xs;
        overflow: elide;
        vertical-alignment: center;
    }

    // PR/Issue 状态点（open/closed/merged；未知不显示）
    StateDot {
        x: root.x-state + 2px;
        y: (parent.height - self.height) / 2;
        state: root.notif.state;
    }

    Text {
        x: root.x-title;
        width: root.x-kind - 8px - root.x-title;
        height: parent.height;
        text: root.notif.title;
        // closed/merged 的行整体压暗（同 GitHub 通知的已完结视觉）
        property <bool> done: root.notif.state == "closed" || root.notif.state == "merged";
        color: self.done ? root.fg-dim : root.fg;
        font-size: Theme.fs_sm;
        font-weight: root.notif.unread && !self.done ? 700 : 400;
        overflow: elide;
        vertical-alignment: center;
    }

    if root.notif.kind != "": KindBadge {
        x: root.x-kind;
        y: (parent.height - self.height) / 2;
        kind: root.notif.kind;
        label: root.notif.kind_label;
    }

    Text {
        x: root.x-reason;
        width: InboxCols.reason;
        height: parent.height;
        text: root.notif.reason;
        color: root.fg-dim;
        font-size: Theme.fs_xs;
        overflow: elide;
        vertical-alignment: center;
    }

    // 已加入本地库的持久反馈（dim 小字，叠在 reason 列右侧）
    if root.notif.added: Text {
        x: root.x-reason;
        width: InboxCols.reason;
        height: parent.height;
        text: I18n.inbox_added;
        color: root.fg-dim;
        font-size: Theme.fs_xs;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: root.x-time;
        width: InboxCols.time;
        height: parent.height;
        text: root.notif.updated;
        color: root.fg-dim;
        font-size: Theme.fs_xs;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // hover 快捷操作：+ 预评审（仅 PullRequest 且未加入时）。
    // 常驻元素 + visible 切换，可见性并入按钮自身 hover，防覆盖层抖动（同 PrRowItem）。
    actions-overlay := Rectangle {
        x: parent.width - self.width - 4px;
        y: 3px;
        width: 76px;
        height: parent.height - 6px;
        visible: root.notif.kind == "PullRequest" && !root.notif.added
            && (ta.has-hover || add-ta.has-hover);
        border-radius: Theme.r_sm;
        background: root.selected ? Theme.sel : Theme.card;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Theme.r_sm;
            background: add-ta.has-hover ? Theme.hover : transparent;
            add-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.add_review(); }
            }
            Text {
                text: I18n.inbox_add_review;
                font-size: Theme.fs_xs;
                color: root.selected ? root.fg : Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 行底 hairline
    Rectangle {
        x: 10px;
        y: parent.height - 1px;
        width: parent.width - 10px;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 通知列表 ──
// needs_token：未配置 GitHub token 时显示提示空态（通知 API 需要鉴权）。
// 单击 / Enter：选中 + 展开右侧预览（row_activated）；预览已开时再按 Enter：打开浏览器；
// Esc：预览开着 → 关预览，否则取消选中。
export component InboxView inherits FocusScope {
    in property <[NotifRow]> rows: [];
    // 仓库过滤：repos 由 Rust 侧按当前通知去重给出；"" = 全部
    in property <[string]> repos: [];
    in-out property <string> repo_filter: "";
    in property <bool> has_more: false;        // 还有下一页通知可加载
    in property <bool> loading_more: false;    // 「加载更多」进行中
    in property <bool> needs_token: false;
    in property <bool> loading: false;   // 首次/手动拉取进行中（空态只在非 loading 时显示，防闪现误导）
    in property <bool> detail_open: false;  // 右侧预览面板是否展开（Enter/Esc 语义依赖它）
    in-out property <bool> unread_only: false;  // 只看未读（false = 连已读一起拉）
    in-out property <int> selected_index: -1;
    // 弹窗/首启引导打开时锁键盘：key-pressed 全部 reject 放行给外层（外层负责 Esc 关弹窗）
    in property <bool> keys_locked: false;
    // 「全部已读」两步确认：true = 确认态（3s 超时自动还原），确认态再点才真正执行
    property <bool> mar_confirm: false;

    // 仓库过滤变化（Rust 侧重建行模型）：选中下标随之失效，清掉防止选中错行
    changed repo_filter => { root.selected_index = -1; }

    callback row_activated(int);    // 单击 / Enter：选中 + 展开预览（传 rows 下标）
    callback row_add_review(int);   // 「+ 预评审」：加入本地库（传 rows 下标）
    callback open_browser();        // 预览已开时按 Enter：浏览器打开当前详情
    callback close_detail();        // 预览已开时按 Esc：关预览
    callback mark_all_read();       // 「全部已读」：PUT /notifications 后刷新
    callback filter_toggled(bool);  // 「只看未读」开关变化（传新值）
    callback load_more();           // 「加载更多」：拉下一页通知追加

    function move_selection(delta: int) {
        if (root.rows.length == 0) { return; }
        if (root.selected_index < 0 || root.selected_index >= root.rows.length) {
            root.selected_index = delta > 0 ? 0 : root.rows.length - 1;
            return;
        }
        root.selected_index = Math.min(root.rows.length - 1, Math.max(0, root.selected_index + delta));
    }

    // PageUp/PageDown 翻页滚动（由外层 FocusScope 调用；滚动容器自己不认键盘）。
    // 注意桥接：滚动容器在 if 作用域里，id 外部不可见——page_scroll 只累加
    // page_req 计数，真正的滚动在容器内部的 changed 里（那里看得到 self）。
    in-out property <int> page_req: 0;
    public function page_scroll(dir: int) { root.page_req = root.page_req + dir; }

    // 键盘导航：j/k 或 ↑/↓ 移动，Enter 展开预览 / 打开浏览器，Esc 关预览 / 取消选中
    key-pressed(event) => {
        if (root.keys_locked) { return reject; }
        if (event.text == "j" || event.text == Key.DownArrow) {
            root.move_selection(1);
            return accept;
        }
        if (event.text == "k" || event.text == Key.UpArrow) {
            root.move_selection(-1);
            return accept;
        }
        if (event.text == Key.Return) {
            if (root.detail_open) {
                root.open_browser();
            } else if (root.selected_index >= 0 && root.selected_index < root.rows.length) {
                root.row_activated(root.selected_index);
            }
            return accept;
        }
        if (event.text == Key.Escape) {
            if (root.detail_open) {
                root.close_detail();
            } else {
                root.selected_index = -1;
            }
            return accept;
        }
        reject
    }

    Rectangle {
        background: Theme.bg;

        // 注意：这里不能设 alignment: start——非 stretch 对齐会让子元素全部退回
        // preferred 尺寸，ListView 的 vertical-stretch 失效后只渲染约两行高。
        VerticalLayout {

            // ── 工具栏：26px，底部 hairline ──
            Rectangle {
                height: 26px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: I18n.inbox_title;
                        font-size: Theme.fs_xs;
                        font-weight: 600;
                        color: Theme.text_dim;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 仓库过滤下拉（vllm-omni 刷屏救星；行按 repo_filter 条件显示）
                    repo-btn := Rectangle {
                        height: 22px;
                        width: repo-btn-row.preferred-width;
                        border-radius: Theme.r_sm;
                        background: repo-ta.has-hover ? Theme.hover : Theme.surface2;

                        repo-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { repo-popup.show(); }
                        }
                        repo-btn-row := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 5px;
                            Image {
                                source: @image-url("icons/filter.svg");
                                width: 11px;
                                height: 11px;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                                colorize: root.repo_filter != "" ? Theme.accent : Theme.text_dim;
                            }
                            Text {
                                text: root.repo_filter == "" ? I18n.inbox_filter_all : root.repo_filter;
                                font-size: Theme.fs_xs;
                                color: root.repo_filter != "" ? Theme.accent : Theme.text_dim;
                                vertical-alignment: center;
                            }
                            Image {
                                source: @image-url("icons/chevron-down.svg");
                                width: 9px;
                                height: 9px;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                                colorize: Theme.text_faint;
                            }
                        }

                        repo-popup := PopupWindow {
                            // 右缘对齐按钮右缘（按钮贴工具栏右端，x:0 会溢出窗口右缘）；
                            // 高度 clamp 到窗口内，超出部分 Flickable 滚动
                            x: parent.width - max(200px, repo-btn.width);
                            y: parent.height + 4px;
                            width: max(200px, repo-btn.width);
                            height: min((root.repos.length + 1) * 26px + 8px, max(120px, root.height - 60px));
                            close-policy: close-on-click-outside;

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: Theme.r_lg;
                                background: Theme.card;
                                border-width: 1px;
                                border-color: Theme.hairline;

                                Flickable {
                                    x: 0;
                                    y: 0;
                                    width: 100%;
                                    height: 100%;
                                    content-width: self.width;
                                    content-height: (root.repos.length + 1) * 26px + 8px;

                                    VerticalLayout {
                                        x: 0;
                                        y: 4px;
                                        width: 100%;
                                        spacing: 0;

                                        // 「全部仓库」置顶项
                                        Rectangle {
                                            height: 26px;
                                            background: root.repo_filter == "" ? Theme.sel
                                                : (all-ta.has-hover ? Theme.hover : Theme.card);
                                            all-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.repo_filter = ""; repo-popup.close(); }
                                            }
                                            Text {
                                                x: 24px;
                                                width: parent.width - 32px;
                                                height: 100%;
                                                text: I18n.inbox_filter_all;
                                                font-size: Theme.fs_sm;
                                                color: root.repo_filter == "" ? Theme.sel_text : Theme.text;
                                                vertical-alignment: center;
                                            }
                                            Image {
                                                visible: root.repo_filter == "";
                                                x: 8px;
                                                y: (parent.height - 10px) / 2;
                                                width: 10px;
                                                height: 10px;
                                                source: @image-url("icons/check.svg");
                                                image-fit: contain;
                                                colorize: Theme.sel_text;
                                            }
                                        }
                                        for p in root.repos: Rectangle {
                                            height: 26px;
                                            background: p == root.repo_filter ? Theme.sel
                                                : (rp-ta.has-hover ? Theme.hover : Theme.card);
                                            rp-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.repo_filter = p; repo-popup.close(); }
                                            }
                                            Text {
                                                x: 24px;
                                                width: parent.width - 32px;
                                                height: 100%;
                                                text: p;
                                                font-size: Theme.fs_sm;
                                                color: p == root.repo_filter ? Theme.sel_text : Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Image {
                                                visible: p == root.repo_filter;
                                                x: 8px;
                                                y: (parent.height - 10px) / 2;
                                                width: 10px;
                                                height: 10px;
                                                source: @image-url("icons/check.svg");
                                                image-fit: contain;
                                                colorize: Theme.sel_text;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // 「全部已读」两步确认：第一次点变确认态（3s 超时还原），确认态再点才真正执行
                    mar-timer := Timer {
                        interval: 3s;
                        running: root.mar_confirm;
                        triggered => { root.mar_confirm = false; }
                    }
                    ToolButton {
                        label: root.mar_confirm ? I18n.inbox_mark_all_read_confirm : I18n.inbox_mark_all_read;
                        danger: root.mar_confirm;
                        clicked => {
                            if (root.mar_confirm) {
                                root.mar_confirm = false;
                                root.mark_all_read();
                            } else {
                                root.mar_confirm = true;
                            }
                        }
                    }
                    TogglePill {
                        label: I18n.inbox_unread_only;
                        on: root.unread_only;
                        clicked => {
                            root.unread_only = !root.unread_only;
                            root.filter_toggled(root.unread_only);
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.hairline;
                }
            }

            if root.needs_token: EmptyState {
                vertical-stretch: 1;
                icon_img: @image-url("icons/key.svg");
                title: I18n.inbox_needs_token_title;
                hint: I18n.inbox_needs_token_hint;
            }

            // 首次加载中：转圈 + 「加载中…」（避免 rows 尚未回送时闪「通知为空」误导空态）
            if !root.needs_token && root.loading && root.rows.length == 0: Rectangle {
                vertical-stretch: 1;

                // 转圈指示：Timer 驱动逐帧切换 4 帧旋转 SVG（复用 detail_panel 的 spin 模式）
                property <int> spin_idx: 0;
                Timer {
                    interval: 130ms;
                    running: true;
                    triggered => { spin_idx = spin_idx >= 3 ? 0 : spin_idx + 1; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            width: 16px;
                            height: 16px;
                            source: spin_idx == 0 ? @image-url("icons/spin-0.svg")
                                : spin_idx == 1 ? @image-url("icons/spin-1.svg")
                                : spin_idx == 2 ? @image-url("icons/spin-2.svg")
                                : @image-url("icons/spin-3.svg");
                            image-fit: contain;
                            colorize: Theme.text_dim;
                        }
                    }
                    Text {
                        text: I18n.inbox_loading;
                        color: Theme.text_dim;
                        font-size: Theme.fs_md;
                        horizontal-alignment: center;
                    }
                }
            }

            if !root.needs_token && !root.loading && root.rows.length == 0: EmptyState {
                vertical-stretch: 1;
                icon_img: @image-url("icons/inbox.svg");
                title: I18n.inbox_empty_title;
                hint: I18n.inbox_empty_hint;
            }

            if !root.needs_token && root.rows.length > 0: InboxHeader {}

            // 行列表：ListView 虚拟化（行高固定，视口外不实例化）。
            // 仓库过滤在 Rust 侧做（模型预过滤），这里拿到的 rows 已是过滤后的。
            if !root.needs_token && root.rows.length > 0: lv := ListView {
                vertical-stretch: 1;

                // PageUp/PageDown：page_req 计数桥接（if 作用域里 id 外部不可见、
                // changed 又只能盯本地属性——mirror 绑定把外层计数引进来）
                property <int> last_page_req: 0;
                property <int> page_req_mirror: root.page_req;
                changed page_req_mirror => {
                    let dir = page_req_mirror - self.last_page_req;
                    self.last_page_req = page_req_mirror;
                    if (dir > 0) {
                        self.content-y = max(self.height - self.content-height, self.content-y - self.height * 0.9);
                    } else if (dir < 0) {
                        self.content-y = min(0px, self.content-y + self.height * 0.9);
                    }
                }

                for r[i] in root.rows: NotifRowItem {
                    notif: r;
                    selected: i == root.selected_index;
                    clicked => {
                        root.selected_index = i;
                        root.row_activated(i);
                    }
                    add_review => { root.row_add_review(i); }
                }
            }

            // 分页：「加载更多」常驻底部（GitHub 通知每页 50 条；没有下一页时隐藏）
            if !root.needs_token && root.rows.length > 0 && root.has_more: Rectangle {
                height: 40px;
                Rectangle {
                    width: load-more-row.preferred-width + 24px;
                    height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 13px;
                    background: !root.loading_more && load-more-ta.has-hover ? Theme.hover : Theme.surface2;
                    animate background { duration: 100ms; }

                    load-more-ta := TouchArea {
                        mouse-cursor: root.loading_more ? default : pointer;
                        clicked => { if (!root.loading_more) { root.load_more(); } }
                    }
                    load-more-row := HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.loading_more ? I18n.inbox_loading : I18n.inbox_load_more;
                            font-size: Theme.fs_sm;
                            color: root.loading_more ? Theme.text_faint : Theme.text_dim;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// ── 状态徽章（open 绿 / merged 紫 / closed 红；预览面板用）──
component StateBadge inherits Rectangle {
    in property <string> state;

    property <color> tone: root.state == "open" ? Theme.good
        : root.state == "merged" ? Theme.purple
        : Theme.bad;
    property <string> label: root.state == "open" ? I18n.inbox_state_open
        : root.state == "merged" ? I18n.inbox_state_merged
        : I18n.inbox_state_closed;

    height: 18px;
    width: badge-text.preferred-width + 16px;
    border-radius: 9px;
    background: root.tone.with-alpha(0.12);

    badge-text := Text {
        height: 100%;
        text: root.label;
        font-size: Theme.fs_xs;
        font-weight: 500;
        color: root.tone;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ── 小号幽灵按钮（面板操作行用）：透明底 hover 加深，active 态 accent tint 底 ──
component OutlineBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> tint: Theme.accent;
    callback clicked();

    height: 26px;
    width: layout.preferred-width;
    border-radius: Theme.r_md;
    background: root.active ? root.tint.with-alpha(0.12)
        : (ta.has-hover ? Theme.surface2 : transparent);
    animate background { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: Theme.fs_sm;
            color: root.active ? root.tint : (ta.has-hover ? Theme.text : Theme.text_dim);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── 通知详情预览面板（右侧检查器，结构参考 DetailPanel，只保留 会话/Files/Diff 三个标签页）──
// visible=false 时宽度为 0 不占位；打开时从 0 动画展开到 panel_width。
// Issue 类型没有 Files/Diff：标签页只显示「会话」。
export component NotifPreview inherits Rectangle {
    in property <length> panel_width: 420px;

    in property <string> title: "";
    in property <string> kind: "";        // PullRequest / Issue / …（原始值；决定标签页与徽章色调）
    in property <string> kind_label: "";  // kind 的本地化显示文本（空 = 回退显示 kind 原值）
    in property <string> state: "";       // open / closed / merged（空 = 未知/不适用）
    in property <bool> added: false;      // 已在本地库（按钮变「已加入」）
    in property <bool> loading: false;    // 详情拉取中

    in property <[ConvoEntry]> convo_entries: [];
    in property <[FileChange]> files: [];
    in property <[DiffRow]> diff_files: [];
    // diff 最长内容行（DiffView 测量像素宽以定横向滚动区域）
    in property <string> diff_max_text: "";

    callback close();
    callback open_browser();
    callback add_review();
    callback diff_file_toggled(int);

    property <bool> is_pr: root.kind == "PullRequest";
    property <[string]> tabs: root.is_pr ? [I18n.tab_conversation, I18n.tab_files, I18n.tab_diff] : [I18n.tab_conversation];
    in-out property <int> current_tab: 0;

    width: root.visible ? root.panel_width : 0px;
    clip: true;
    background: Theme.card;
    // 不开宽度动画：动画期间换行文本逐帧重排会触发 femtovg 叠影（同 detail_panel）

    // 左缘 hairline
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: 100%;
        background: Theme.hairline;
    }

    VerticalLayout {
        // ── 头部：标题 + 关闭 ×，kind 徽章 + 操作按钮行 ──
        Rectangle {
            background: Theme.card;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        horizontal-stretch: 1;
                        // 不套固定高度+clip：换行超出时 femtovg 会渲染出叠影（同 detail_panel 标题）
                        // read-only TextInput：标题可选中复制（视觉同 Text）
                        TextInput {
                            width: parent.width;
                            height: self.preferred-height;
                            read-only: true;
                            enabled: true;
                            text: root.title == "" ? I18n.inbox_not_selected : root.title;
                            color: Theme.text;
                            font-size: Theme.fs_lg;
                            // 400：femtovg 对换行加粗的雅黑文本会叠影（detail_panel 标题同款规避）
                            font-weight: 400;
                            wrap: word-wrap;
                            selection-background-color: Theme.accent.with-alpha(0.28);
                        }
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.r_sm;
                        background: close_ta.has-hover ? Theme.hover : transparent;
                        animate background { duration: 100ms; }
                        close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                        Image {
                            source: @image-url("icons/x.svg");
                            width: 11px;
                            height: 11px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            colorize: close_ta.has-hover ? Theme.text : Theme.text_dim;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if root.kind != "": KindBadge {
                        kind: root.kind;
                        label: root.kind_label != "" ? root.kind_label : root.kind;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.state != "": StateBadge {
                        state: root.state;
                        y: (parent.height - self.height) / 2;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    OutlineBtn {
                        label: I18n.inbox_open_browser;
                        clicked => { root.open_browser(); }
                    }
                    if root.is_pr: OutlineBtn {
                        label: root.added ? I18n.inbox_added : I18n.inbox_add_review;
                        active: root.added;
                        tint: Theme.good;
                        clicked => { if (!root.added) { root.add_review(); } }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 标签页分段控件（同 DetailPanel 风格）──
        Rectangle {
            height: 40px;
            background: Theme.card;

            Rectangle {
                x: 12px;
                y: (parent.height - self.height) / 2;
                height: 26px;
                width: tabs_layout.preferred-width;
                border-radius: Theme.r_md;
                background: Theme.surface2;
                clip: true;

                tabs_layout := HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for tab[i] in root.tabs: Rectangle {
                        property <bool> current: root.current_tab == i;
                        border-radius: Theme.r_sm;
                        width: tab_t.preferred-width + 20px;
                        background: self.current ? Theme.card
                            : (tab_ta.has-hover ? Theme.hover : transparent);
                        animate background { duration: 100ms; }

                        tab_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.current_tab = i; }
                        }
                        tab_t := Text {
                            text: tab;
                            width: 100%;
                            height: 100%;
                            font-size: Theme.fs_sm;
                            font-weight: parent.current ? 600 : 400;
                            color: parent.current ? Theme.text
                                : (tab_ta.has-hover ? Theme.text : Theme.text_dim);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 内容区 ──
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            // 会话：时间线（24px 头像 + 2px 竖线）
            // Flickable + VerticalLayout：Markdown 块换行后的高度随宽度变化，
            // ListView 会缓存委托高度导致条目重叠，这里整树重排更可靠
            if root.current_tab == 0: Rectangle {
                if root.convo_entries.length > 0: Flickable {
                    content-width: self.width;
                    content-height: convo_layout.preferred-height;

                    convo_layout := VerticalLayout {
                        width: 100%;
                        alignment: start;

                        for e[i] in root.convo_entries: entry_box := Rectangle {
                        height: entry_layout.preferred-height + 16px;

                        Rectangle {
                            x: 16px + 11px;
                            y: 0;
                            width: 2px;
                            height: 100%;
                            background: Theme.hairline;
                        }

                        entry_layout := HorizontalLayout {
                            x: 16px;
                            y: 8px;
                            width: parent.width - 32px;
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 24px;
                                Avatar {
                                    login: e.author;
                                    size: 24px;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: e.author;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: e.time;
                                        font-size: Theme.fs_xs;
                                        color: Theme.text_faint;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // 正文：有解析块 → Markdown 渲染；否则回退纯文本（换行，可选中复制）
                                // 宽度必须从 entry_box（entry_layout 之外）显式推算，
                                // 绑 parent.width 会形成 layout-cache 绑定循环
                                if e.blocks.length == 0: TextInput {
                                    read-only: true;
                                    enabled: true;
                                    text: e.text;
                                    width: entry_box.width - 66px;
                                    height: self.preferred-height;
                                    font-size: Theme.fs_md;
                                    color: Theme.text_dim;
                                    wrap: word-wrap;
                                    selection-background-color: Theme.accent.with-alpha(0.28);
                                }
                                if e.blocks.length > 0: MarkdownBlocks {
                                    blocks: e.blocks;
                                    w: entry_box.width - 66px;
                                }
                            }
                        }
                    }
                    }
                }
                if root.convo_entries.length == 0 && !root.loading: EmptyState {
                    icon_img: @image-url("icons/comment.svg");
                    title: I18n.convo_empty_title;
                    hint: I18n.inbox_convo_empty_hint;
                }
            }

            // Files：文件名 + 增删数字（仅 PR 有此标签页）
            if root.current_tab == 1 && root.is_pr: Rectangle {
                if root.files.length > 0: ListView {
                    for f[i] in root.files: Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: f.path;
                                font-family: Theme.mono_font;
                                font-size: Theme.fs_xs;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "+" + f.adds;
                                font-family: Theme.mono_font;
                                font-size: Theme.fs_xs;
                                color: Theme.good;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "-" + f.dels;
                                font-family: Theme.mono_font;
                                font-size: Theme.fs_xs;
                                color: Theme.bad;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            x: 16px;
                            y: parent.height - 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.files.length == 0 && !root.loading: EmptyState {
                    icon_img: @image-url("icons/file.svg");
                    title: I18n.files_empty_title;
                    hint: I18n.files_empty_hint;
                }
            }

            // Diff：嵌入真实 DiffView（彩色渲染 + 按文件折叠）
            if root.current_tab == 2 && root.is_pr: DiffView {
                rows: root.diff_files;
                max_text: root.diff_max_text;
                file_toggled(i) => { root.diff_file_toggled(i); }
            }

            // 加载中遮罩提示
            if root.loading: Rectangle {
                background: Theme.bg.with-alpha(0.7);
                Text {
                    text: I18n.inbox_loading;
                    color: Theme.text_dim;
                    font-size: Theme.fs_md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
