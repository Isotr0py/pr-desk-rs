// PR Desk — 常驻右侧详情面板（macOS 检查器质感）
//
// 布局用法：放进主区 HorizontalLayout 作为最右子元素（不要像抽屉那样做顶层覆盖）。
// visible=false 时宽度为 0 不占位（直接用内置 visible 属性，由集成方绑定 open 状态），
// 打开时宽度从 0 动画展开到 panel-width。
//
// 设计契约：全部颜色/字号/圆角取自 theme.slint 的 Theme 令牌（浅色/深色双主题）。
import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar } from "components.slint";
import { DiffView, DiffFile } from "diff_view.slint";

// 会话时间线条目：kind = "commit" / "review" / "comment"
export struct ConvoEntry {
    kind: string,
    author: string,
    time: string,   // 相对时间，如 "2h"
    text: string,   // 内容摘要
}

// CI 检查项：conclusion = "success" / "failure" / "pending" / 其他（灰显原文）
export struct CheckRun {
    name: string,
    conclusion: string,
}

// 文件变更条目
export struct FileChange {
    path: string,
    adds: int,
    dels: int,
}

// OCR 行级评论：severity = critical / high / medium / low / 其他（灰显）
export struct OcrComment {
    severity: string,
    category: string,
    location: string,   // 如 "src/foo.rs:42-58"（无行号时仅路径）
    content: string,    // 评论正文（可换行）
}

// 状态胶囊：Open 绿 / Merged 紫 / Closed 红，有色浅底 + 同色深字
component StateBadge inherits Rectangle {
    in property <string> state: "open";   // open / merged / closed

    property <color> tone: root.state == "merged" ? Theme.purple
        : root.state == "closed" ? Theme.bad
        : Theme.good;

    height: 20px;
    width: badge_layout.preferred-width;
    border-radius: 10px;
    background: root.tone.with-alpha(0.14);

    badge_layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        Text {
            text: "●";
            font-size: 7px;
            color: root.tone;
            vertical-alignment: center;
        }
        Text {
            text: root.state == "merged" ? "已合并"
                : root.state == "closed" ? "已关闭" : "Open";
            font-size: Theme.fs_xs;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// CI 徽章：成功绿 / 失败红 / 进行中黄
component CiBadge inherits Rectangle {
    in property <string> ci: "";   // success / failure / pending / 其他

    property <color> tone: root.ci == "success" ? Theme.good
        : root.ci == "failure" ? Theme.bad
        : Theme.mid;

    height: 20px;
    width: badge_layout.preferred-width;
    border-radius: 10px;
    background: root.tone.with-alpha(0.14);

    badge_layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.ci == "success" ? "✓" : root.ci == "failure" ? "✗" : "●";
            font-size: 9px;
            color: root.tone;
            vertical-alignment: center;
        }
        Text {
            text: root.ci == "success" ? "CI 通过"
                : root.ci == "failure" ? "CI 失败" : "CI 进行中";
            font-size: Theme.fs_xs;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 行级评论 severity 徽章：critical 红 / high 橙 / medium 黄 / low 灰
//（Theme 无橙色令牌，high 由 Theme.bad 与 Theme.mid 混色得到，仍派生自主题）
component SeverityBadge inherits Rectangle {
    in property <string> severity: "other";

    property <color> tone: root.severity == "critical" ? Theme.bad
        : root.severity == "high" ? Theme.bad.mix(Theme.mid, 0.5)
        : root.severity == "medium" ? Theme.mid
        : Theme.text_faint;

    height: 18px;
    width: badge_layout.preferred-width;
    border-radius: 9px;
    background: root.tone.with-alpha(0.14);

    badge_layout := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        alignment: center;
        Text {
            text: root.severity == "critical" ? "严重"
                : root.severity == "high" ? "高"
                : root.severity == "medium" ? "中"
                : root.severity == "low" ? "低"
                : root.severity;
            font-size: Theme.fs_xs;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 小号描边按钮：hover 淡底，active 时描边与文字着 tint 色
component OutlineBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> tint: Theme.accent;
    callback clicked();

    height: 26px;
    width: layout.preferred-width;
    border-radius: Theme.r_md;
    border-width: 1px;
    border-color: root.active ? root.tint : Theme.border;
    background: root.active ? root.tint.with-alpha(0.12)
        : (ta.has-hover ? Theme.hover : #00000000);

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: Theme.fs_sm;
            color: root.active ? root.tint : (ta.has-hover ? Theme.text : Theme.text_dim);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 空状态占位：图标 + 标题 + 提示，居中
component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> heading;
    in property <string> hint;

    VerticalLayout {
        padding: 24px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.icon;
            font-size: 26px;
            color: Theme.text_faint;
            horizontal-alignment: center;
        }
        Text {
            text: root.heading;
            font-size: Theme.fs_md;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            font-size: Theme.fs_sm;
            color: Theme.text_dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component DetailPanel inherits Rectangle {
    // 显示/隐藏：直接绑定内置 visible；false 时宽度为 0 不占布局
    in property <length> panel_width: 420px;

    // ── detail 字段 ──
    in property <string> title: "";
    in property <string> author: "";
    in property <image> avatar;
    in property <string> state: "open";     // open / merged / closed
    in property <string> ci: "";            // success / failure / pending / ""（空不显示 CI 徽章）
    in property <string> opened: "";        // 创建相对时间，如 "3d"
    in property <string> updated: "";       // 更新相对时间，如 "2h"
    in property <string> branches: "";      // 分支信息，如 "feature/x → main"
    in property <string> body: "";          // 评审文本（空串 → 空状态）
    in property <int> priority: 0;          // 0 未排 / 1 高 / 2 中 / 3 低
    in property <bool> pinned: false;
    in property <bool> on_board: false;

    // ── 标签页与数据 ──
    in property <[string]> tabs: ["评审", "会话", "Checks", "Files", "Diff"];
    in-out property <int> current_tab: 0;
    in property <[ConvoEntry]> convo_entries: [];
    in property <[CheckRun]> check_runs: [];
    in property <[FileChange]> files: [];
    // Diff 标签页：嵌入真实 DiffView（模型由集成方提供，整体替换）
    in property <[DiffFile]> diff_files: [];
    callback diff_file_toggled(int);

    // ── 评审标签页（LLM 预评审）──
    callback action_run_review();           // 点击「开始预评审 / 重试评审」
    in property <string> review_status: "";        // "" 未评审 / "running" / "done" / "failed"
    in property <string> review_progress: "";      // running 时的进度文本
    in property <bool> review_has: false;          // 是否已有评审报告
    in property <float> review_score: 0;
    in property <[string]> review_dimension_lines: [];  // 如 "正确性风险  8/10"
    in property <string> review_summary: "";
    in property <[string]> review_flagged: [];          // 如 "src/foo.py — 具体问题"
    in property <string> review_reviewed_at: "";        // 评审时间
    in property <[OcrComment]> review_comments: [];     // OCR 行级评论（已按 severity 分节排序）

    callback close();
    callback action_board();                // 看板下拉按钮（下拉菜单由集成方弹出）
    callback action_set_priority(int);
    callback action_toggle_pin();
    callback tab_changed(int);              // current_tab 已在内部同步，此回调供集成方持久化

    width: root.visible ? root.panel_width : 0px;
    clip: true;
    background: Theme.card;

    animate width { duration: 150ms; easing: ease-out-quad; }

    // 左缘 hairline
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: 100%;
        background: Theme.hairline;
    }

    VerticalLayout {
        // ── 头部卡片区：标题 / 徽章+作者行 / 操作行 ──
        Rectangle {
            background: Theme.card;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 10px;

                // 标题（15px/600，最多两行截断）+ 关闭按钮
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;   // 两行 15px 标题的高度
                        clip: true;
                        Text {
                            width: parent.width;
                            text: root.title == "" ? "未选择 PR" : root.title;
                            color: Theme.text;
                            font-size: Theme.fs_lg;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.r_sm;
                        background: close_ta.has-hover ? Theme.hover : #00000000;
                        animate background { duration: 100ms; }
                        close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                        Text {
                            text: "×";
                            width: 100%;
                            height: 100%;
                            font-size: Theme.fs_lg;
                            color: close_ta.has-hover ? Theme.text : Theme.text_dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // 徽章行：状态胶囊 + CI 徽章 ｜ 作者头像 + 名字 + 相对时间
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    StateBadge { state: root.state; }
                    if root.ci != "": CiBadge { ci: root.ci; }
                    Rectangle {
                        width: 16px;
                        height: 20px;
                        Avatar {
                            x: 0;
                            y: 2px;
                            login: root.author;
                            img: root.avatar;
                            size: 16px;
                        }
                    }
                    Text {
                        text: root.author == "" ? "—" : root.author;
                        color: Theme.text;
                        font-size: Theme.fs_sm;
                        font-weight: 600;
                        max-width: 140px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "· " + root.opened;
                        color: Theme.text_faint;
                        font-size: Theme.fs_xs;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // 操作行：置顶 / 看板 + 右侧优先级分段
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    OutlineBtn {
                        label: root.pinned ? "📌 已置顶" : "📌 置顶";
                        tint: Theme.mid;
                        active: root.pinned;
                        clicked => { root.action_toggle_pin(); }
                    }
                    OutlineBtn {
                        label: root.on_board ? "看板 ▼" : "加入看板 ▼";
                        active: root.on_board;
                        clicked => { root.action_board(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 优先级分段控件 1/2/3（active 时按优先级着色）
                    Rectangle {
                        width: seg.preferred-width;
                        height: 26px;
                        border-radius: Theme.r_md;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface2;
                        clip: true;
                        seg := HorizontalLayout {
                            spacing: 0;
                            for lbl[i] in ["1", "2", "3"]: Rectangle {
                                property <color> tint: i == 0 ? Theme.bad
                                    : i == 1 ? Theme.mid : Theme.accent;
                                property <bool> seg_active: root.priority == i + 1;

                                width: 30px;
                                background: self.seg_active ? self.tint.with-alpha(0.18)
                                    : (seg_ta.has-hover ? Theme.hover : #00000000);
                                animate background { duration: 100ms; }

                                seg_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action_set_priority(i + 1); }
                                }
                                Text {
                                    text: lbl;
                                    width: 100%;
                                    height: 100%;
                                    font-size: Theme.fs_sm;
                                    font-weight: parent.seg_active ? 700 : 400;
                                    color: parent.seg_active ? parent.tint : Theme.text_dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                // 分段间分隔线
                                if i > 0: Rectangle {
                                    x: 0;
                                    y: 5px;
                                    width: 1px;
                                    height: parent.height - 10px;
                                    background: Theme.border;
                                }
                            }
                        }
                    }
                }
            }

            // 头部底 hairline
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 标签页：macOS 分段控件（当前段 card 色底 + 细边框）──
        Rectangle {
            height: 40px;
            background: Theme.card;

            Rectangle {
                x: 12px;
                y: (parent.height - self.height) / 2;
                height: 26px;
                width: tabs_layout.preferred-width;
                border-radius: Theme.r_md;
                border-width: 1px;
                border-color: Theme.hairline;
                background: Theme.surface2;
                clip: true;

                tabs_layout := HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for tab[i] in root.tabs: Rectangle {
                        property <bool> current: root.current_tab == i;
                        border-radius: Theme.r_sm;
                        width: tab_t.preferred-width + 20px;
                        background: self.current ? Theme.card
                            : (tab_ta.has-hover ? Theme.hover : #00000000);
                        border-width: self.current ? 1px : 0;
                        border-color: Theme.border;
                        animate background { duration: 100ms; }

                        tab_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current_tab = i;
                                root.tab_changed(i);
                            }
                        }
                        tab_t := Text {
                            text: tab;
                            width: 100%;
                            height: 100%;
                            font-size: Theme.fs_sm;
                            font-weight: parent.current ? 600 : 400;
                            color: parent.current ? Theme.text
                                : (tab_ta.has-hover ? Theme.text : Theme.text_dim);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 内容区 ──
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            // 评审：LLM 预评审报告（分数徽章 / 各维度 / 总结 / 风险文件），整体可滚动
            if root.current_tab == 0: Rectangle {
                // 转圈字符：Timer 驱动逐帧切换（仅 running 时转动）
                property <int> spin_idx: 0;
                Timer {
                    interval: 130ms;
                    running: root.review_status == "running";
                    triggered => { spin_idx = spin_idx >= 3 ? 0 : spin_idx + 1; }
                }
                // 分数着色：>=8 绿 / >=6 黄 / <6 红
                property <color> score_tone: root.review_score >= 8 ? Theme.good
                    : root.review_score >= 6 ? Theme.mid : Theme.bad;

                ScrollView {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: start;

                        // ── 顶部操作行：开始预评审按钮 + 进度/失败提示 ──
                        Rectangle {
                            height: 30px;

                            run_btn := Rectangle {
                                x: 0;
                                y: 0;
                                width: btn_layout.preferred-width;
                                height: 30px;
                                border-radius: Theme.r_md;
                                background: root.review_status == "running"
                                    ? Theme.surface2
                                    : (btn_ta.has-hover ? Theme.accent.darker(1.08) : Theme.accent);
                                animate background { duration: 100ms; }

                                btn_layout := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.review_status == "running" ? "评审中…"
                                            : root.review_status == "failed" ? "重试评审"
                                            : "开始预评审";
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: root.review_status == "running" ? Theme.text_dim : #ffffff;
                                        vertical-alignment: center;
                                    }
                                }
                                btn_ta := TouchArea {
                                    mouse-cursor: root.review_status == "running" ? default : pointer;
                                    clicked => {
                                        if (root.review_status != "running") { root.action_run_review(); }
                                    }
                                }
                            }

                            // running：转圈 + 进度文本（常驻，visible 切换）
                            Text {
                                x: run_btn.width + 10px;
                                y: 0;
                                height: 30px;
                                visible: root.review_status == "running";
                                text: (spin_idx == 0 ? "◐" : spin_idx == 1 ? "◓"
                                    : spin_idx == 2 ? "◑" : "◒") + "  " + root.review_progress;
                                font-size: Theme.fs_sm;
                                color: Theme.text_dim;
                                vertical-alignment: center;
                            }
                            // failed：失败提示（常驻，visible 切换）
                            Text {
                                x: run_btn.width + 10px;
                                y: 0;
                                height: 30px;
                                visible: root.review_status == "failed";
                                text: "上次评审失败，点击按钮重试";
                                font-size: Theme.fs_sm;
                                color: Theme.bad;
                                vertical-alignment: center;
                            }
                        }

                        // ── 报告卡片 ──
                        if root.review_has: Rectangle {
                            border-radius: Theme.r_md;
                            border-width: 1px;
                            border-color: Theme.hairline;
                            background: Theme.card;
                            height: report_col.preferred-height;

                            report_col := VerticalLayout {
                                padding: 14px;
                                spacing: 12px;
                                alignment: start;

                                // 分数行：大号圆形徽章 + 标签 + 评审时间
                                Rectangle {
                                    height: 64px;

                                    Rectangle {
                                        x: 0;
                                        y: 0;
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 32px;
                                        border-width: 2px;
                                        border-color: score_tone;
                                        background: score_tone.with-alpha(0.14);
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "" + round(root.review_score * 10) / 10;
                                            font-size: Theme.fs_xl;
                                            font-weight: 700;
                                            color: score_tone;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        x: 76px;
                                        y: 14px;
                                        width: parent.width - 76px;
                                        text: "综合评分（/10）";
                                        font-size: Theme.fs_md;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        x: 76px;
                                        y: 36px;
                                        width: parent.width - 76px;
                                        text: root.review_reviewed_at == ""
                                            ? "评审时间未知"
                                            : "评审时间 " + root.review_reviewed_at;
                                        font-size: Theme.fs_xs;
                                        color: Theme.text_faint;
                                        overflow: elide;
                                    }
                                }

                                // 各维度评分
                                if root.review_dimension_lines.length > 0: VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Text {
                                        text: "各维度评分";
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    for line[i] in root.review_dimension_lines: Rectangle {
                                        height: 22px;
                                        Text {
                                            x: 0;
                                            y: 0;
                                            width: 16px;
                                            height: 100%;
                                            text: "●";
                                            font-size: 8px;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            x: 16px;
                                            y: 0;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text: line;
                                            font-size: Theme.fs_sm;
                                            color: Theme.text;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 评审总结
                                if root.review_summary != "": VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Text {
                                        text: "评审总结";
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    Text {
                                        text: root.review_summary;
                                        font-size: Theme.fs_md;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                }

                                // 风险文件列表
                                if root.review_flagged.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "风险文件";
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    for f[i] in root.review_flagged: Rectangle {
                                        height: f_txt.preferred-height + 2px;
                                        Text {
                                            x: 0;
                                            y: 0;
                                            width: 16px;
                                            text: "⚠";
                                            font-size: Theme.fs_xs;
                                            color: Theme.mid;
                                        }
                                        f_txt := Text {
                                            x: 18px;
                                            y: 0;
                                            width: parent.width - 18px;
                                            text: f;
                                            font-size: Theme.fs_sm;
                                            font-weight: 500;
                                            color: Theme.text;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // 行级评论（OCR）：已按 severity 分节排序，组头在 severity 变化处出现
                                if root.review_comments.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "行级评论";
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    for c[i] in root.review_comments: VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        // 分节组头：首条或 severity 与上一条不同
                                        if i == 0 || root.review_comments[i - 1].severity != c.severity: Text {
                                            text: c.severity == "critical" ? "Critical"
                                                : c.severity == "high" ? "High"
                                                : c.severity == "medium" ? "Medium"
                                                : c.severity == "low" ? "Low"
                                                : "其他";
                                            font-size: Theme.fs_xs;
                                            font-weight: 700;
                                            color: c.severity == "critical" ? Theme.bad
                                                : c.severity == "high" ? Theme.bad.mix(Theme.mid, 0.5)
                                                : c.severity == "medium" ? Theme.mid
                                                : Theme.text_faint;
                                        }

                                        // 评论卡片：徽章 + 类别 + 位置 + 正文（hover 覆盖层常驻，visible 切换）
                                        comment_card := Rectangle {
                                            border-radius: Theme.r_md;
                                            border-width: 1px;
                                            border-color: Theme.hairline;
                                            background: Theme.surface2;
                                            height: card_col.preferred-height;

                                            Rectangle {
                                                border-radius: Theme.r_md;
                                                background: Theme.hover;
                                                visible: card_ta.has-hover;
                                            }
                                            card_ta := TouchArea {}

                                            card_col := VerticalLayout {
                                                padding: 10px;
                                                spacing: 4px;
                                                alignment: start;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    SeverityBadge { severity: c.severity; }
                                                    Text {
                                                        text: c.category;
                                                        font-size: Theme.fs_xs;
                                                        color: Theme.text_dim;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: c.location;
                                                        font-family: "Consolas";
                                                        font-size: Theme.fs_xs;
                                                        color: Theme.text_faint;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                }
                                                Text {
                                                    text: c.content;
                                                    font-size: Theme.fs_sm;
                                                    color: Theme.text;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── 空状态：无报告且非 running ──
                        if !root.review_has && root.review_status != "running": Rectangle {
                            height: 240px;
                            EmptyState {
                                icon: "◆";
                                heading: "暂无评审报告";
                                hint: "点击上方「开始预评审」，LLM 将对该 PR 生成结构化评审报告";
                            }
                        }
                    }
                }
            }

            // 会话：时间线（24px 圆形头像 + 2px 竖向时间线贯穿）
            if root.current_tab == 1: Rectangle {
                if root.convo_entries.length > 0: ListView {
                    for e[i] in root.convo_entries: Rectangle {
                        height: entry_layout.preferred-height + 16px;

                        // 贯穿的时间线（对齐头像圆心）
                        Rectangle {
                            x: 16px + 11px;
                            y: 0;
                            width: 2px;
                            height: 100%;
                            background: Theme.hairline;
                        }

                        entry_layout := HorizontalLayout {
                            x: 16px;
                            y: 8px;
                            width: parent.width - 32px;
                            spacing: 10px;
                            alignment: start;

                            // 头像列（固定 24px，不随行高拉伸）
                            Rectangle {
                                width: 24px;
                                Avatar {
                                    login: e.author;
                                    size: 24px;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: e.author;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: e.time;
                                        font-size: Theme.fs_xs;
                                        color: Theme.text_faint;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text {
                                    text: e.text;
                                    font-size: Theme.fs_md;
                                    color: Theme.text_dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
                if root.convo_entries.length == 0: EmptyState {
                    icon: "💬";
                    heading: "暂无会话记录";
                    hint: "提交、评审与评论活动将显示在这里";
                }
            }

            // Checks：状态圆点 + 名称 + 结论（失败红字）
            if root.current_tab == 2: Rectangle {
                if root.check_runs.length > 0: ListView {
                    for c[i] in root.check_runs: check_row := Rectangle {
                        property <color> tone: c.conclusion == "success" ? Theme.good
                            : c.conclusion == "failure" ? Theme.bad
                            : c.conclusion == "pending" ? Theme.mid
                            : Theme.text_faint;
                        height: 32px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            Rectangle {
                                width: 16px;
                                Text {
                                    text: c.conclusion == "success" ? "✓"
                                        : c.conclusion == "failure" ? "✗"
                                        : c.conclusion == "pending" ? "◐" : "○";
                                    width: 100%;
                                    height: 100%;
                                    font-size: Theme.fs_sm;
                                    color: check_row.tone;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: c.name;
                                font-size: Theme.fs_sm;
                                color: c.conclusion == "failure" ? Theme.bad : Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: c.conclusion == "success" ? "通过"
                                    : c.conclusion == "failure" ? "失败"
                                    : c.conclusion == "pending" ? "进行中"
                                    : (c.conclusion == "" ? "—" : c.conclusion);
                                font-size: Theme.fs_xs;
                                color: check_row.tone;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            x: 16px;
                            y: parent.height - 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.check_runs.length == 0: EmptyState {
                    icon: "✓";
                    heading: "暂无 Checks";
                    hint: "这个 PR 还没有关联的 CI 检查记录";
                }
            }

            // Files：文件名 + 增删数字 + 迷你增删比例条
            if root.current_tab == 3: Rectangle {
                if root.files.length > 0: ListView {
                    for f[i] in root.files: file_row := Rectangle {
                        property <float> add_frac: (f.adds + f.dels) > 0
                            ? f.adds * 1.0 / (f.adds + f.dels) : 0;
                        height: 30px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: f.path;
                                font-family: "Consolas";
                                font-size: Theme.fs_xs;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "+" + f.adds;
                                font-family: "Consolas";
                                font-size: Theme.fs_xs;
                                color: Theme.good;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "-" + f.dels;
                                font-family: "Consolas";
                                font-size: Theme.fs_xs;
                                color: Theme.bad;
                                vertical-alignment: center;
                            }
                            // 迷你增删比例条（绿=新增，红=删除）
                            Rectangle {
                                width: 48px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 48px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.hairline;
                                    clip: true;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * file_row.add_frac;
                                        height: 100%;
                                        background: Theme.good;
                                    }
                                    Rectangle {
                                        x: parent.width * file_row.add_frac;
                                        width: parent.width * ( 1 - file_row.add_frac );
                                        height: 100%;
                                        background: Theme.bad;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 16px;
                            y: parent.height - 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.files.length == 0: EmptyState {
                    icon: "📄";
                    heading: "暂无文件变更";
                    hint: "Diff 文件列表将显示在这里";
                }
            }

            // Diff：嵌入真实 DiffView（彩色渲染 + 按文件折叠）
            if root.current_tab == 4: DiffView {
                files: root.diff_files;
                file_toggled(i) => { root.diff_file_toggled(i); }
            }

            if root.current_tab < 0 || root.current_tab > 4: EmptyState {
                icon: "🚧";
                heading: "即将推出";
                hint: "这个标签页还没有实现";
            }
        }

        // ── 底部评论输入占位（只读模式，灰显禁用）──
        Rectangle {
            height: 50px;
            background: Theme.card;
            opacity: 0.65;

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.r_md;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg;
                    comment_input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        enabled: false;
                        font-size: Theme.fs_sm;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if comment_input.text == "": Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: "只读模式，评论功能后续开放";
                        color: Theme.text_faint;
                        font-size: Theme.fs_sm;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 52px;
                    border-radius: Theme.r_md;
                    background: Theme.surface2;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: "发送";
                        width: 100%;
                        height: 100%;
                        font-size: Theme.fs_sm;
                        color: Theme.text_faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
