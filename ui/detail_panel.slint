// PR Desk — 常驻右侧详情面板（macOS 检查器质感）
//
// 布局用法：放进主区 HorizontalLayout 作为最右子元素（不要像抽屉那样做顶层覆盖）。
// visible=false 时宽度为 0 不占位（直接用内置 visible 属性，由集成方绑定 open 状态），
// 打开时宽度从 0 动画展开到 panel-width。左缘 1px hairline 上有 8px 拖拽手柄，
// 按住左拖加宽面板（clamp 320px ~ max_panel_width，集成方传入窗口宽度的 60%）。
//
// 设计契约：全部颜色/字号/圆角取自 theme.slint 的 Theme 令牌（浅色/深色双主题）。
import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";
import { Avatar, MarkdownBlocks, MdBlock } from "components.slint";
import { DiffView, DiffFile } from "diff_view.slint";

// 会话时间线条目：kind = "commit" / "review" / "comment"
export struct ConvoEntry {
    kind: string,
    author: string,
    time: string,   // 相对时间，如 "2h"
    text: string,   // 内容摘要（blocks 为空时的回退显示）
    blocks: [MdBlock],  // Rust 端解析出的 Markdown 块；空数组 → 回退渲染 text
}

// CI 检查项：conclusion = "success" / "failure" / "pending" / 其他（灰显原文）
export struct CheckRun {
    name: string,
    conclusion: string,
}

// 文件变更条目
export struct FileChange {
    path: string,
    adds: int,
    dels: int,
}

// OCR 行级评论：severity = critical / high / medium / low / 其他（灰显）
export struct OcrComment {
    severity: string,
    category: string,
    location: string,   // 如 "src/foo.rs:42-58"（无行号时仅路径）
    content: string,    // 评论正文（可换行）
}

// 评审维度分数：label = 中文维度名，score = 0~10 一位小数
export struct DimScore {
    label: string,
    score: float,
}

// 状态胶囊：Open 绿 / Merged 紫 / Closed 红，有色浅底 + 同色深字
component StateBadge inherits Rectangle {
    in property <string> state: "open";   // open / merged / closed

    property <color> tone: root.state == "merged" ? Theme.purple
        : root.state == "closed" ? Theme.bad
        : Theme.good;

    height: 20px;
    width: badge_layout.preferred-width;
    border-radius: 10px;
    background: root.tone.with-alpha(0.12);

    badge_layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        Rectangle {
            width: 6px;
            Image {
                source: @image-url("icons/dot.svg");
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: root.tone;
            }
        }
        Text {
            text: root.state == "merged" ? I18n.state_merged
                : root.state == "closed" ? I18n.state_closed : I18n.state_open;
            font-size: Theme.fs_xs;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// CI 徽章：成功绿 / 失败红 / 进行中黄
component CiBadge inherits Rectangle {
    in property <string> ci: "";   // success / failure / pending / 其他

    property <color> tone: root.ci == "success" ? Theme.good
        : root.ci == "failure" ? Theme.bad
        : Theme.mid;

    height: 20px;
    width: badge_layout.preferred-width;
    border-radius: 10px;
    background: root.tone.with-alpha(0.12);

    badge_layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        Rectangle {
            width: 10px;
            Image {
                source: root.ci == "success" ? @image-url("icons/check.svg")
                    : root.ci == "failure" ? @image-url("icons/x.svg")
                    : @image-url("icons/dot.svg");
                width: root.ci == "pending" || (root.ci != "success" && root.ci != "failure") ? 6px : 10px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: root.tone;
            }
        }
        Text {
            text: root.ci == "success" ? I18n.ci_success
                : root.ci == "failure" ? I18n.ci_failure : I18n.ci_pending;
            font-size: Theme.fs_xs;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 行级评论 severity 徽章：critical 红 / high 橙 / medium 黄 / low 灰
//（Theme 无橙色令牌，high 由 Theme.bad 与 Theme.mid 混色得到，仍派生自主题）
component SeverityBadge inherits Rectangle {
    in property <string> severity: "other";

    property <color> tone: root.severity == "critical" ? Theme.bad
        : root.severity == "high" ? Theme.bad.mix(Theme.mid, 0.5)
        : root.severity == "medium" ? Theme.mid
        : Theme.text_faint;

    height: 18px;
    width: badge_layout.preferred-width;
    border-radius: 9px;
    background: root.tone.with-alpha(0.12);

    badge_layout := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        alignment: center;
        Text {
            text: root.severity == "critical" ? I18n.severity_critical
                : root.severity == "high" ? I18n.severity_high
                : root.severity == "medium" ? I18n.severity_medium
                : root.severity == "low" ? I18n.severity_low
                : root.severity;
            font-size: Theme.fs_xs;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 小号无边框按钮：hover 淡底，active 时 tint 浅底 + 文字着 tint 色
// icon / trailing：前置/后置内嵌 SVG 图标（colorize 随文字色），规避字形缺失豆腐块
component OutlineBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <image> trailing;
    in property <bool> active: false;
    in property <color> tint: Theme.accent;
    callback clicked();

    property <color> fg: root.active ? root.tint : (ta.has-hover ? Theme.text : Theme.text_dim);

    height: 26px;
    width: layout.preferred-width;
    border-radius: Theme.r_md;
    background: root.active ? root.tint.with-alpha(0.12)
        : (ta.has-hover ? Theme.hover : #00000000);

    animate background { duration: 100ms; }

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        if root.icon.width > 0: Rectangle {
            width: 11px;
            Image {
                source: root.icon;
                width: 11px;
                height: 11px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: root.fg;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.fs_sm;
            color: root.fg;
            vertical-alignment: center;
        }
        if root.trailing.width > 0: Rectangle {
            width: 10px;
            Image {
                source: root.trailing;
                width: 10px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: root.fg;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 空状态占位：图标 + 标题 + 提示，居中
// icon_img 优先（内嵌 SVG，规避 emoji 字形缺失豆腐块）；未传时回退 icon 文字字形
component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <image> icon_img;
    in property <string> heading;
    in property <string> hint;

    VerticalLayout {
        padding: 24px;
        spacing: 6px;
        alignment: center;
        if root.icon_img.width > 0: Rectangle {
            height: 26px;
            Image {
                source: root.icon_img;
                width: 26px;
                height: 26px;
                x: (parent.width - self.width) / 2;
                image-fit: contain;
                colorize: Theme.text_faint;
            }
        }
        if root.icon_img.width == 0: Text {
            text: root.icon;
            font-size: 26px;
            color: Theme.text_faint;
            horizontal-alignment: center;
        }
        Text {
            text: root.heading;
            font-size: Theme.fs_md;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            font-size: Theme.fs_sm;
            color: Theme.text_dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component DetailPanel inherits Rectangle {
    // 显示/隐藏：直接绑定内置 visible；false 时宽度为 0 不占布局
    in-out property <length> panel_width: 420px;
    // 拖拽宽度上限（集成方传窗口宽度 * 0.6）；下限固定 320px
    in property <length> max_panel_width: 10000px;

    // ── detail 字段 ──
    in property <string> title: "";
    in property <string> author: "";
    in property <image> avatar;
    in property <string> state: "open";     // open / merged / closed
    in property <string> ci: "";            // success / failure / pending / ""（空不显示 CI 徽章）
    in property <string> opened: "";        // 创建相对时间，如 "3d"
    in property <string> updated: "";       // 更新相对时间，如 "2h"
    in property <string> branches: "";      // 分支信息，如 "feature/x -> main"
    in property <string> body: "";          // 评审文本（空串 → 空状态）
    in property <int> priority: 0;          // 0 未排 / 1 高 / 2 中 / 3 低
    in property <bool> pinned: false;
    in property <bool> on_board: false;

    // ── 标签页与数据 ──
    in property <[string]> tabs: [I18n.tab_review, I18n.tab_conversation, I18n.tab_checks, I18n.tab_files, I18n.tab_diff];
    in-out property <int> current_tab: 0;
    in property <[ConvoEntry]> convo_entries: [];
    in property <[CheckRun]> check_runs: [];
    in property <[FileChange]> files: [];
    // Diff 标签页：嵌入真实 DiffView（模型由集成方提供，整体替换）
    in property <[DiffFile]> diff_files: [];
    callback diff_file_toggled(int);

    // ── 评审标签页（LLM 预评审）──
    callback action_run_review();           // 点击「开始预评审 / 重试评审」
    callback action_copy_review();          // 复制评审报告（Markdown 进剪贴板）
    in property <string> review_status: "";        // "" 未评审 / "running" / "done" / "failed"
    in property <string> review_progress: "";      // running 时的进度文本
    in property <bool> review_has: false;          // 是否已有评审报告
    in property <float> review_score: 0;
    in property <[DimScore]> review_dimensions: [];   // 各维度评分（进度条行）
    in property <string> review_size_line: "";        // 体量行，如 "XL（+990/-114，24 个文件）"，空不显示
    in property <string> review_summary: "";          // 摘要纯文本回退（blocks 为空时显示）
    in property <[MdBlock]> review_summary_blocks: [];  // 摘要 Markdown 块（优先）
    in property <[string]> review_flagged: [];          // 如 "src/foo.py — 具体问题"
    in property <string> review_reviewed_at: "";        // 评审时间
    in property <[OcrComment]> review_comments: [];     // OCR 行级评论（已按 severity 分节排序）

    callback close();
    callback action_board();                // 看板下拉按钮（下拉菜单由集成方弹出）
    callback action_set_priority(int);
    callback action_toggle_pin();
    callback tab_changed(int);              // current_tab 已在内部同步，此回调供集成方持久化

    width: root.visible ? root.panel_width : 0px;
    clip: true;
    background: Theme.card;

    // 不开宽度动画：动画期间换行文本逐帧重排，femtovg 会出现双份字形叠印的渲染残留
    //（标题在面板打开时叠影的根因；拖拽改宽本来就靠 pressed 时 0ms，不受影响）

    // 左缘 hairline
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: 100%;
        background: drag_handle.has-hover || drag_handle.pressed ? Theme.accent : Theme.hairline;
    }

    VerticalLayout {
        // ── 头部卡片区：标题 / 徽章+作者行 / 操作行 ──
        Rectangle {
            background: Theme.card;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

                // 标题（15px，随面板宽度自然换行增高）+ 关闭按钮。
                // 不要给标题套固定高度+clip 的壳：换行文本超出壳高时 femtovg 渲染出叠影
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            width: parent.width;
                            text: root.title == "" ? I18n.detail_no_pr_selected : root.title;
                            color: Theme.text;
                            font-size: Theme.fs_lg;
                            // 400：femtovg 对换行加粗的雅黑文本会叠影
                            font-weight: 400;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: Theme.r_sm;
                        background: close_ta.has-hover ? Theme.hover : #00000000;
                        animate background { duration: 100ms; }
                        close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                        Image {
                            source: @image-url("icons/x.svg");
                            width: 11px;
                            height: 11px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            colorize: close_ta.has-hover ? Theme.text : Theme.text_dim;
                        }
                    }
                }

                // 徽章行：状态胶囊 + CI 徽章 ｜ 作者头像 + 名字 + 相对时间
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    StateBadge { state: root.state; }
                    if root.ci != "": CiBadge { ci: root.ci; }
                    Rectangle {
                        width: 16px;
                        height: 20px;
                        Avatar {
                            x: 0;
                            y: 2px;
                            login: root.author;
                            img: root.avatar;
                            size: 16px;
                        }
                    }
                    Text {
                        text: root.author == "" ? "—" : root.author;
                        color: Theme.text;
                        font-size: Theme.fs_sm;
                        font-weight: 600;
                        max-width: 140px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "· " + root.opened;
                        color: Theme.text_faint;
                        font-size: Theme.fs_xs;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // 操作行：置顶 / 看板 + 右侧优先级分段
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    OutlineBtn {
                        label: root.pinned ? I18n.detail_pinned : I18n.detail_pin;
                        icon: @image-url("icons/pin.svg");
                        tint: Theme.mid;
                        active: root.pinned;
                        clicked => { root.action_toggle_pin(); }
                    }
                    OutlineBtn {
                        label: root.on_board ? I18n.detail_board : I18n.detail_add_board;
                        trailing: @image-url("icons/chevron-down.svg");
                        active: root.on_board;
                        clicked => { root.action_board(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 优先级分段控件 1/2/3（active 时按优先级着色）
                    Rectangle {
                        width: seg.preferred-width;
                        height: 26px;
                        border-radius: Theme.r_md;
                        background: Theme.surface2;
                        clip: true;
                        seg := HorizontalLayout {
                            spacing: 0;
                            for lbl[i] in ["1", "2", "3"]: Rectangle {
                                property <color> tint: i == 0 ? Theme.bad
                                    : i == 1 ? Theme.mid : Theme.accent;
                                property <bool> seg_active: root.priority == i + 1;

                                width: 30px;
                                background: self.seg_active ? self.tint.with-alpha(0.18)
                                    : (seg_ta.has-hover ? Theme.hover : #00000000);
                                animate background { duration: 100ms; }

                                seg_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action_set_priority(i + 1); }
                                }
                                Text {
                                    text: lbl;
                                    width: 100%;
                                    height: 100%;
                                    font-size: Theme.fs_sm;
                                    font-weight: parent.seg_active ? 700 : 400;
                                    color: parent.seg_active ? parent.tint : Theme.text_dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                // 分段间分隔线
                                if i > 0: Rectangle {
                                    x: 0;
                                    y: 5px;
                                    width: 1px;
                                    height: parent.height - 10px;
                                    background: Theme.hairline;
                                }
                            }
                        }
                    }
                }
            }

            // 头部底 hairline
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 标签页：macOS 分段控件（当前段 card 色底 + 细边框）──
        Rectangle {
            height: 40px;
            background: Theme.card;

            Rectangle {
                x: 12px;
                y: (parent.height - self.height) / 2;
                height: 26px;
                width: tabs_layout.preferred-width;
                border-radius: Theme.r_md;
                background: Theme.surface2;
                clip: true;

                tabs_layout := HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for tab[i] in root.tabs: Rectangle {
                        property <bool> current: root.current_tab == i;
                        border-radius: Theme.r_sm;
                        width: tab_t.preferred-width + 20px;
                        background: self.current ? Theme.card
                            : (tab_ta.has-hover ? Theme.hover : #00000000);
                        animate background { duration: 100ms; }

                        tab_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current_tab = i;
                                root.tab_changed(i);
                            }
                        }
                        tab_t := Text {
                            text: tab;
                            width: 100%;
                            height: 100%;
                            font-size: Theme.fs_sm;
                            font-weight: parent.current ? 600 : 400;
                            color: parent.current ? Theme.text
                                : (tab_ta.has-hover ? Theme.text : Theme.text_dim);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 内容区 ──
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            // 评审：LLM 预评审报告（分数胶囊 / 维度进度条 / 体量行 / 总结 / 风险文件），整体可滚动
            if root.current_tab == 0: Rectangle {
                // 转圈指示：Timer 驱动逐帧切换 4 帧旋转 SVG（Slint 无元素旋转属性，故用帧切换；仅 running 时转动）
                property <int> spin_idx: 0;
                Timer {
                    interval: 130ms;
                    running: root.review_status == "running";
                    triggered => { spin_idx = spin_idx >= 3 ? 0 : spin_idx + 1; }
                }
                // 分数着色：>=8 绿 / >=6 黄 / <6 红
                property <color> score_tone: root.review_score >= 8 ? Theme.good
                    : root.review_score >= 6 ? Theme.mid : Theme.bad;

                // 切换 PR 或新报告落库（reviewed_at 变化）时滚动位置归零，
                // 避免残留旧偏移把顶部操作行/评分区滚出视野
                property <string> watched_key: root.title + "|" + root.review_reviewed_at;
                changed watched_key => { review_scroll.content-y = 0px; }

                review_scroll := ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;

                        // ── 顶部操作行：开始预评审按钮 + 进度/失败提示 ──
                        Rectangle {
                            height: 30px;

                            run_btn := Rectangle {
                                x: 0;
                                y: 0;
                                width: btn_layout.preferred-width;
                                height: 30px;
                                border-radius: Theme.r_md;
                                background: root.review_status == "running"
                                    ? Theme.surface2
                                    : (btn_ta.has-hover ? Theme.accent.darker(1.08) : Theme.accent);
                                animate background { duration: 100ms; }

                                btn_layout := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.review_status == "running" ? I18n.review_running
                                            : root.review_status == "failed" ? I18n.review_retry
                                            : I18n.review_start;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: root.review_status == "running" ? Theme.text_dim : #ffffff;
                                        vertical-alignment: center;
                                    }
                                }
                                btn_ta := TouchArea {
                                    mouse-cursor: root.review_status == "running" ? default : pointer;
                                    clicked => {
                                        if (root.review_status != "running") { root.action_run_review(); }
                                    }
                                }
                            }

                            // 复制评审报告（Markdown 全文进剪贴板，可直接粘到 GitHub 评论）
                            if root.review_has: Rectangle {
                                x: parent.width - 32px;
                                y: 0;
                                width: 32px;
                                height: 30px;
                                border-radius: Theme.r_md;
                                background: copy_ta.has-hover ? Theme.hover : transparent;
                                animate background { duration: 100ms; }
                                copy_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action_copy_review(); }
                                }
                                Image {
                                    source: @image-url("icons/copy.svg");
                                    width: 15px;
                                    height: 15px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                    colorize: copy_ta.has-hover ? Theme.text : Theme.text_dim;
                                }
                                // hover tooltip（该操作行无 clip，可直接溢出）
                                if copy_ta.has-hover: Rectangle {
                                    x: parent.width - self.width;
                                    y: parent.height + 6px;
                                    width: tip.preferred-width + 14px;
                                    height: 22px;
                                    border-radius: Theme.r_md;
                                    background: Theme.card;
                                    border-width: 1px;
                                    border-color: Theme.hairline;
                                    tip := Text {
                                        text: I18n.review_copy_tip;
                                        font-size: Theme.fs_xs;
                                        color: Theme.text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // running：转圈 SVG（帧动画）+ 进度文本（常驻，visible 切换）
                            Rectangle {
                                x: run_btn.width + 10px;
                                y: 0;
                                height: 30px;
                                width: spin_img.width + 6px + spin_txt.preferred-width;
                                visible: root.review_status == "running";
                                spin_img := Image {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: 14px;
                                    height: 14px;
                                    source: spin_idx == 0 ? @image-url("icons/spin-0.svg")
                                        : spin_idx == 1 ? @image-url("icons/spin-1.svg")
                                        : spin_idx == 2 ? @image-url("icons/spin-2.svg")
                                        : @image-url("icons/spin-3.svg");
                                    image-fit: contain;
                                    colorize: Theme.text_dim;
                                }
                                spin_txt := Text {
                                    x: spin_img.width + 6px;
                                    y: 0;
                                    height: 100%;
                                    text: root.review_progress;
                                    font-size: Theme.fs_sm;
                                    color: Theme.text_dim;
                                    vertical-alignment: center;
                                }
                            }
                            // failed：失败提示（常驻，visible 切换）
                            Text {
                                x: run_btn.width + 10px;
                                y: 0;
                                height: 30px;
                                visible: root.review_status == "failed";
                                text: I18n.review_failed_hint;
                                font-size: Theme.fs_sm;
                                color: Theme.bad;
                                vertical-alignment: center;
                            }
                        }

                        // ── 报告卡片 ──
                        if root.review_has: report_card := Rectangle {
                            border-radius: Theme.r_lg;
                            background: Theme.card;
                            height: report_col.preferred-height;

                            report_col := VerticalLayout {
                                padding: 16px;
                                spacing: 12px;
                                alignment: start;

                                // 综合评分行：标签 + 彩色分数胶囊（>=8 绿 / >=6 黄 / <6 红）+ 右侧评审时间
                                Rectangle {
                                    height: 26px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Text {
                                            text: I18n.review_score_label;
                                            font-size: Theme.fs_md;
                                            font-weight: 600;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: pill_layout.preferred-width;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: score_tone.with-alpha(0.12);
                                            pill_layout := HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                Text {
                                                    text: "" + round(root.review_score * 10) / 10;
                                                    font-size: Theme.fs_sm;
                                                    font-weight: 700;
                                                    color: score_tone;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.review_reviewed_at == ""
                                                ? I18n.review_time_unknown
                                                : I18n.review_time_prefix + root.review_reviewed_at;
                                            font-size: Theme.fs_xs;
                                            color: Theme.text_faint;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 各维度评分：维度名 + 进度条（score/10 比例填充）+ 右侧一位小数
                                if root.review_dimensions.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: I18n.review_dimensions;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    for d[i] in root.review_dimensions: Rectangle {
                                        height: 22px;
                                        Text {
                                            x: 0;
                                            y: 0;
                                            width: 120px;
                                            height: 100%;
                                            text: d.label;
                                            font-size: Theme.fs_sm;
                                            color: Theme.text_dim;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        // 进度条：surface2 底 + accent 填充（宽度按 score/10 比例，显式定位）
                                        dim_bar := Rectangle {
                                            x: 128px;
                                            y: 7px;
                                            width: parent.width - 128px - 52px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: Theme.surface2;
                                            clip: true;
                                            Rectangle {
                                                x: 0;
                                                y: 0;
                                                height: 100%;
                                                width: max(0px, min(parent.width, parent.width * (d.score / 10)));
                                                border-radius: 4px;
                                                background: Theme.accent;
                                            }
                                        }
                                        Text {
                                            x: parent.width - 48px;
                                            y: 0;
                                            width: 48px;
                                            height: 100%;
                                            text: "" + round(d.score * 10) / 10;
                                            font-size: Theme.fs_sm;
                                            font-weight: 600;
                                            color: Theme.text;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 体量行：XL（+990/-114，24 个文件），空串不显示
                                if root.review_size_line != "": Text {
                                    text: I18n.review_size_prefix + root.review_size_line;
                                    font-size: Theme.fs_sm;
                                    color: Theme.text_dim;
                                }

                                // 评审总结：Markdown 块渲染（行内 code 等），为空时回退纯文本
                                if root.review_summary_blocks.length > 0 || root.review_summary != "": VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Text {
                                        text: I18n.review_summary_title;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    if root.review_summary_blocks.length > 0: MarkdownBlocks {
                                        blocks: root.review_summary_blocks;
                                        // 宽度锚定 root.width（绑定 panel_width，与内容布局无关），
                                        // 绑 report_card.width 会形成 layout-cache 绑定循环
                                        w: max(0px, root.width - 64px);
                                    }
                                    if root.review_summary_blocks.length == 0 && root.review_summary != "": Text {
                                        text: root.review_summary;
                                        width: max(0px, root.width - 64px);
                                        font-size: Theme.fs_md;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                }

                                // 风险文件列表
                                if root.review_flagged.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: I18n.review_flagged_title;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    for f[i] in root.review_flagged: Rectangle {
                                        height: f_txt.preferred-height + 2px;
                                        Image {
                                            x: 0;
                                            y: 2px;
                                            width: 12px;
                                            height: 12px;
                                            source: @image-url("icons/warning.svg");
                                            image-fit: contain;
                                            colorize: Theme.mid;
                                        }
                                        f_txt := Text {
                                            x: 18px;
                                            y: 0;
                                            width: parent.width - 18px;
                                            text: f;
                                            font-size: Theme.fs_sm;
                                            font-weight: 500;
                                            color: Theme.text;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // 行级评论（OCR）：已按 severity 分节排序，组头在 severity 变化处出现
                                if root.review_comments.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: I18n.review_comments_title;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text_dim;
                                    }
                                    for c[i] in root.review_comments: VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        // 分节组头：首条或 severity 与上一条不同
                                        if i == 0 || root.review_comments[i - 1].severity != c.severity: Text {
                                            text: c.severity == "critical" ? I18n.severity_critical
                                                : c.severity == "high" ? I18n.severity_high
                                                : c.severity == "medium" ? I18n.severity_medium
                                                : c.severity == "low" ? I18n.severity_low
                                                : I18n.severity_other;
                                            font-size: Theme.fs_xs;
                                            font-weight: 700;
                                            color: c.severity == "critical" ? Theme.bad
                                                : c.severity == "high" ? Theme.bad.mix(Theme.mid, 0.5)
                                                : c.severity == "medium" ? Theme.mid
                                                : Theme.text_faint;
                                        }

                                        // 评论卡片：徽章 + 类别 + 位置 + 正文（hover 覆盖层常驻，visible 切换）
                                        comment_card := Rectangle {
                                            border-radius: Theme.r_md;
                                            background: Theme.surface2;
                                            height: card_col.preferred-height;

                                            Rectangle {
                                                border-radius: Theme.r_md;
                                                background: Theme.hover;
                                                visible: card_ta.has-hover;
                                            }
                                            card_ta := TouchArea {}

                                            card_col := VerticalLayout {
                                                padding: 12px;
                                                spacing: 4px;
                                                alignment: start;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;
                                                    SeverityBadge { severity: c.severity; }
                                                    Text {
                                                        text: c.category;
                                                        font-size: Theme.fs_xs;
                                                        color: Theme.text_dim;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: c.location;
                                                        font-family: "Consolas";
                                                        font-size: Theme.fs_xs;
                                                        color: Theme.text_faint;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                }
                                                Text {
                                                    text: c.content;
                                                    font-size: Theme.fs_sm;
                                                    color: Theme.text;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── 空状态：无报告且非 running ──
                        if !root.review_has && root.review_status != "running": Rectangle {
                            height: 240px;
                            EmptyState {
                                icon_img: @image-url("icons/diamond.svg");
                                heading: I18n.review_empty_title;
                                hint: I18n.review_empty_hint;
                            }
                        }
                    }
                }
            }

            // 会话：时间线（24px 圆形头像 + 2px 竖向时间线贯穿）
            // Flickable + VerticalLayout：Markdown 块换行后的高度随宽度变化，
            // ListView 会缓存委托高度导致条目重叠，这里整树重排更可靠
            if root.current_tab == 1: Rectangle {
                if root.convo_entries.length > 0: Flickable {
                    content-width: self.width;
                    content-height: convo_layout.preferred-height;

                    convo_layout := VerticalLayout {
                        width: 100%;
                        alignment: start;

                        for e[i] in root.convo_entries: entry_box := Rectangle {
                        height: entry_layout.preferred-height + 16px;

                        // 贯穿的时间线（对齐头像圆心）
                        Rectangle {
                            x: 16px + 11px;
                            y: 0;
                            width: 2px;
                            height: 100%;
                            background: Theme.hairline;
                        }

                        entry_layout := HorizontalLayout {
                            x: 16px;
                            y: 8px;
                            width: parent.width - 32px;
                            spacing: 10px;
                            alignment: start;

                            // 头像列（固定 24px，不随行高拉伸）
                            Rectangle {
                                width: 24px;
                                Avatar {
                                    login: e.author;
                                    size: 24px;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: e.author;
                                        font-size: Theme.fs_sm;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: e.time;
                                        font-size: Theme.fs_xs;
                                        color: Theme.text_faint;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // 正文：有解析块 → Markdown 渲染；否则回退纯文本（换行）
                                // 宽度必须从 entry_box（entry_layout 之外）显式推算，
                                // 绑 parent.width 会形成 layout-cache 绑定循环
                                if e.blocks.length == 0: Text {
                                    text: e.text;
                                    width: entry_box.width - 66px;
                                    font-size: Theme.fs_md;
                                    color: Theme.text_dim;
                                    wrap: word-wrap;
                                }
                                if e.blocks.length > 0: MarkdownBlocks {
                                    blocks: e.blocks;
                                    w: entry_box.width - 66px;
                                }
                            }
                        }
                    }
                    }
                }
                if root.convo_entries.length == 0: EmptyState {
                    icon_img: @image-url("icons/comment.svg");
                    heading: I18n.convo_empty_title;
                    hint: I18n.convo_empty_hint;
                }
            }

            // Checks：状态圆点 + 名称 + 结论（失败红字）
            if root.current_tab == 2: Rectangle {
                if root.check_runs.length > 0: ListView {
                    for c[i] in root.check_runs: check_row := Rectangle {
                        property <color> tone: c.conclusion == "success" ? Theme.good
                            : c.conclusion == "failure" ? Theme.bad
                            : c.conclusion == "pending" ? Theme.mid
                            : Theme.text_faint;
                        height: 32px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            Rectangle {
                                width: 16px;
                                Image {
                                    source: c.conclusion == "success" ? @image-url("icons/check.svg")
                                        : c.conclusion == "failure" ? @image-url("icons/x.svg")
                                        : c.conclusion == "pending" ? @image-url("icons/pending.svg")
                                        : @image-url("icons/circle.svg");
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    image-fit: contain;
                                    colorize: check_row.tone;
                                }
                            }
                            Text {
                                text: c.name;
                                font-size: Theme.fs_sm;
                                color: c.conclusion == "failure" ? Theme.bad : Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: c.conclusion == "success" ? I18n.check_success
                                    : c.conclusion == "failure" ? I18n.check_failure
                                    : c.conclusion == "pending" ? I18n.check_pending
                                    : (c.conclusion == "" ? "—" : c.conclusion);
                                font-size: Theme.fs_xs;
                                color: check_row.tone;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            x: 16px;
                            y: parent.height - 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.check_runs.length == 0: EmptyState {
                    icon_img: @image-url("icons/check.svg");
                    heading: I18n.checks_empty_title;
                    hint: I18n.checks_empty_hint;
                }
            }

            // Files：文件名 + 增删数字 + 迷你增删比例条
            if root.current_tab == 3: Rectangle {
                if root.files.length > 0: ListView {
                    for f[i] in root.files: file_row := Rectangle {
                        property <float> add_frac: (f.adds + f.dels) > 0
                            ? f.adds * 1.0 / (f.adds + f.dels) : 0;
                        height: 30px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: f.path;
                                font-family: "Consolas";
                                font-size: Theme.fs_xs;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "+" + f.adds;
                                font-family: "Consolas";
                                font-size: Theme.fs_xs;
                                color: Theme.good;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "-" + f.dels;
                                font-family: "Consolas";
                                font-size: Theme.fs_xs;
                                color: Theme.bad;
                                vertical-alignment: center;
                            }
                            // 迷你增删比例条（绿=新增，红=删除）
                            Rectangle {
                                width: 48px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 48px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.hairline;
                                    clip: true;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * file_row.add_frac;
                                        height: 100%;
                                        background: Theme.good;
                                    }
                                    Rectangle {
                                        x: parent.width * file_row.add_frac;
                                        width: parent.width * ( 1 - file_row.add_frac );
                                        height: 100%;
                                        background: Theme.bad;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: 16px;
                            y: parent.height - 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.files.length == 0: EmptyState {
                    icon_img: @image-url("icons/file.svg");
                    heading: I18n.files_empty_title;
                    hint: I18n.files_empty_hint;
                }
            }

            // Diff：嵌入真实 DiffView（彩色渲染 + 按文件折叠）
            if root.current_tab == 4: DiffView {
                files: root.diff_files;
                file_toggled(i) => { root.diff_file_toggled(i); }
            }

            if root.current_tab < 0 || root.current_tab > 4: EmptyState {
                icon_img: @image-url("icons/warning.svg");
                heading: I18n.coming_soon_title;
                hint: I18n.coming_soon_hint;
            }
        }

        // ── 底部评论输入占位（只读模式，灰显禁用）──
        Rectangle {
            height: 50px;
            background: Theme.card;
            opacity: 0.65;

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.r_md;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg;
                    comment_input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        enabled: false;
                        font-size: Theme.fs_sm;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if comment_input.text == "": Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: I18n.comment_readonly_hint;
                        color: Theme.text_faint;
                        font-size: Theme.fs_sm;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 52px;
                    border-radius: Theme.r_md;
                    background: Theme.surface2;
                    Text {
                        text: I18n.send;
                        width: 100%;
                        height: 100%;
                        font-size: Theme.fs_sm;
                        color: Theme.text_faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 拖拽手柄：8px 热区骑在左缘 hairline 上（内容 padding-left 16px，不挡交互元素）。
    // 必须声明在内容之后：内容里的 ScrollView 会盖住下层 TouchArea，
    // 后置声明让手柄在事件分发中优先拿到左缘 8px 的指针事件。
    drag_handle := TouchArea {
        x: 0;
        y: 0;
        width: 8px;
        height: 100%;
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                // 面板右缘固定：新宽度 = 当前面板宽 − 指针在面板内的 x（往左拖变宽）。
                // 每个事件都从当前几何重算（ColHandle 同款手法），与面板移动解耦、无反馈漂移
                root.panel_width = min(root.max_panel_width,
                    max(320px, root.width - self.mouse-x));
            }
        }
    }
}
