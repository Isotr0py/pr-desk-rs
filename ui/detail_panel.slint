// PR Desk — 常驻右侧详情面板（取代抽屉 DetailDrawer；GitHub Dark 风格）
//
// 布局用法：放进主区 HorizontalLayout 作为最右子元素（不要像抽屉那样做顶层覆盖）。
// visible=false 时宽度为 0 不占位（直接用内置 visible 属性，由集成方绑定 open 状态），
// 打开时宽度从 0 动画展开到 panel-width。
//
// 依赖共享契约：theme.slint 的 Theme（含主题代理新增的 sel/sel_text/hover/hairline），
// components.slint 的 Avatar / StatusDot。不引用外部资源文件。
import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, StatusDot } from "components.slint";
import { DiffView, DiffFile } from "diff_view.slint";

// 会话时间线条目：kind = "commit" / "review" / "comment"
export struct ConvoEntry {
    kind: string,
    author: string,
    time: string,   // 相对时间，如 "2h"
    text: string,   // 内容摘要
}

// CI 检查项：conclusion = "success" / "failure" / "pending" / 其他（灰显原文）
export struct CheckRun {
    name: string,
    conclusion: string,
}

// 文件变更条目
export struct FileChange {
    path: string,
    adds: int,
    dels: int,
}

// 状态徽章：Open 绿 / 已合入 紫 / 已关闭 灰
component StateBadge inherits Rectangle {
    in property <string> state: "open";   // open / merged / closed

    property <color> tone: root.state == "merged" ? Theme.purple
        : root.state == "closed" ? #6e7681
        : Theme.good;

    height: 20px;
    width: badge_layout.preferred-width;
    border-radius: 10px;
    background: root.tone.with-alpha(0.15);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.45);

    badge_layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        Text {
            text: "●";
            font-size: 8px;
            color: root.tone;
            vertical-alignment: center;
        }
        Text {
            text: root.state == "merged" ? "已合入"
                : root.state == "closed" ? "已关闭" : "Open";
            font-size: 11px;
            font-weight: 700;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// CI 徽章：失败红 / 成功绿 / 进行中黄
component CiBadge inherits Rectangle {
    in property <string> ci: "";   // success / failure / pending / 其他

    property <color> tone: root.ci == "success" ? Theme.good
        : root.ci == "failure" ? Theme.bad
        : Theme.mid;

    height: 20px;
    width: badge_layout.preferred-width;
    border-radius: 10px;
    background: root.tone.with-alpha(0.12);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.4);

    badge_layout := HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.ci == "success" ? "✓" : root.ci == "failure" ? "✗" : "●";
            font-size: 10px;
            color: root.tone;
            vertical-alignment: center;
        }
        Text {
            text: root.ci == "success" ? "CI 通过"
                : root.ci == "failure" ? "CI 失败" : "CI 进行中";
            font-size: 11px;
            font-weight: 700;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// 幽灵操作按钮：hover 淡底（100ms），active 描边与文字着 tint 色
component ActionBtn inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.accent;
    in property <bool> active: false;
    callback clicked();

    width: t.preferred-width + 20px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? root.tint : Theme.border;
    background: root.active ? root.tint.transparentize(0.85)
        : (ta.has-hover ? Theme.hover : transparent);

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    t := Text {
        text: root.label;
        color: root.active ? root.tint : (ta.has-hover ? Theme.text : Theme.text_dim);
        font-size: 12px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 空状态占位：图标 + 标题 + 提示，居中
component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> heading;
    in property <string> hint;

    VerticalLayout {
        padding: 24px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.icon;
            font-size: 26px;
            color: Theme.purple;
            horizontal-alignment: center;
        }
        Text {
            text: root.heading;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            font-size: 12px;
            color: Theme.text_dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component DetailPanel inherits Rectangle {
    // 显示/隐藏：直接绑定内置 visible；false 时宽度为 0 不占布局
    in property <length> panel_width: 420px;

    // ── detail 字段 ──
    in property <string> title: "";
    in property <string> author: "";
    in property <image> avatar;
    in property <string> state: "open";     // open / merged / closed
    in property <string> ci: "";            // success / failure / pending / ""（空不显示 CI 徽章）
    in property <string> opened: "";        // 创建相对时间，如 "3d"
    in property <string> updated: "";       // 更新相对时间，如 "2h"
    in property <string> branches: "";      // 分支信息，如 "feature/x → main"
    in property <string> body: "";          // 评审文本（空串 → 空状态）
    in property <int> priority: 0;          // 0 未排 / 1 高 / 2 中 / 3 低
    in property <bool> pinned: false;
    in property <bool> on_board: false;

    // ── 标签页与数据 ──
    in property <[string]> tabs: ["评审", "会话", "Checks", "Files", "Diff"];
    in-out property <int> current_tab: 0;
    in property <[ConvoEntry]> convo_entries: [];
    in property <[CheckRun]> check_runs: [];
    in property <[FileChange]> files: [];
    // Diff 标签页：嵌入真实 DiffView（模型由集成方提供，整体替换）
    in property <[DiffFile]> diff_files: [];
    callback diff_file_toggled(int);

    callback close();
    callback action_board();                // 看板下拉按钮（下拉菜单由集成方弹出）
    callback action_set_priority(int);
    callback action_toggle_pin();
    callback tab_changed(int);              // current_tab 已在内部同步，此回调供集成方持久化

    width: root.visible ? root.panel_width : 0px;
    clip: true;
    background: Theme.card;

    animate width { duration: 150ms; easing: ease-out-quad; }

    // 左缘 hairline
    Rectangle {
        x: 0;
        y: 0;
        width: 1px;
        height: 100%;
        background: Theme.hairline;
    }

    VerticalLayout {
        // ── 头部：标题 + 作者行 + 元信息 + 操作行 ──
        Rectangle {
            background: Theme.card;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                // 标题（大号加粗，最多两行，超出裁剪）+ 关闭按钮
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: min(42px, title_t.preferred-height);
                        clip: true;
                        title_t := Text {
                            width: parent.width;
                            text: root.title == "" ? "未选择 PR" : root.title;
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: close_ta.has-hover ? Theme.hover : transparent;
                        animate background { duration: 100ms; }
                        close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close(); }
                        }
                        Text {
                            text: "✕";
                            font-size: 12px;
                            color: close_ta.has-hover ? Theme.text : Theme.text_dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // 作者行：Avatar + 名字 + 状态徽章 + CI 徽章
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Avatar {
                        login: root.author;
                        img: root.avatar;
                        size: 20px;
                    }
                    Text {
                        text: root.author == "" ? "—" : root.author;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        max-width: 150px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    StateBadge { state: root.state; }
                    if root.ci != "": CiBadge { ci: root.ci; }
                    Rectangle { horizontal-stretch: 1; }
                }

                // 元信息行：相对时间 + 分支（dim 小字）
                Text {
                    text: "opened " + root.opened + " · updated " + root.updated
                        + (root.branches != "" ? "  ·  " + root.branches : "");
                    color: Theme.text_dim;
                    font-size: 11px;
                    overflow: elide;
                }

                // 操作行：看板下拉样式按钮 + 优先级分段 + pin
                HorizontalLayout {
                    padding-top: 2px;
                    spacing: 8px;
                    alignment: center;
                    ActionBtn {
                        label: (root.on_board ? "▦ 看板" : "▦ 加入看板") + " ▾";
                        active: root.on_board;
                        clicked => { root.action_board(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "优先级";
                        color: Theme.text_dim;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    // 优先级分段控件 1/2/3（active 时按优先级着色）
                    Rectangle {
                        width: seg.preferred-width;
                        height: 26px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        seg := HorizontalLayout {
                            spacing: 0;
                            for lbl[i] in ["1", "2", "3"]: Rectangle {
                                property <color> tint: i == 0 ? Theme.bad
                                    : i == 1 ? Theme.mid : Theme.accent;
                                property <bool> seg_active: root.priority == i + 1;

                                width: 30px;
                                background: self.seg_active ? self.tint.transparentize(0.8)
                                    : (seg_ta.has-hover ? Theme.hover : transparent);
                                animate background { duration: 100ms; }

                                seg_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action_set_priority(i + 1); }
                                }
                                Text {
                                    text: lbl;
                                    font-size: 12px;
                                    font-weight: parent.seg_active ? 700 : 400;
                                    color: parent.seg_active ? parent.tint : Theme.text_dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                // 分段间分隔线
                                if i > 0: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 1px;
                                    height: 100%;
                                    background: Theme.border;
                                }
                            }
                        }
                    }
                    ActionBtn {
                        width: 30px;
                        label: "📌";
                        tint: Theme.mid;
                        active: root.pinned;
                        clicked => { root.action_toggle_pin(); }
                    }
                }
            }

            // 头部底 hairline
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 标签页：胶囊分段控件，当前页 accent 填充 ──
        Rectangle {
            height: 38px;
            background: Theme.card;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Rectangle {
                    height: 26px;
                    width: tabs_layout.preferred-width;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg;
                    tabs_layout := HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for tab[i] in root.tabs: Rectangle {
                            border-radius: 4px;
                            width: tab_t.preferred-width + 18px;
                            background: root.current_tab == i ? Theme.accent
                                : (tab_ta.has-hover ? Theme.hover : transparent);
                            animate background { duration: 150ms; }
                            tab_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.current_tab = i;
                                    root.tab_changed(i);
                                }
                            }
                            tab_t := Text {
                                text: tab;
                                font-size: 12px;
                                font-weight: root.current_tab == i ? 700 : 400;
                                color: root.current_tab == i ? #0d1117
                                    : (tab_ta.has-hover ? Theme.text : Theme.text_dim);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }
        }

        // ── 内容区 ──
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            // 评审：纯文本滚动展示
            if root.current_tab == 0: Rectangle {
                if root.body != "": ScrollView {
                    VerticalLayout {
                        padding: 14px;
                        alignment: start;
                        Text {
                            text: root.body;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.body == "": EmptyState {
                    icon: "✦";
                    heading: "暂无评审内容";
                    hint: "评审服务生成的摘要将显示在这里";
                }
            }

            // 会话：时间线条目（事件图标 + 头像 + 名字 + 相对时间 + 摘要）
            if root.current_tab == 1: Rectangle {
                if root.convo_entries.length > 0: ListView {
                    for e[i] in root.convo_entries: Rectangle {
                        height: entry_layout.preferred-height + 14px;
                        entry_layout := HorizontalLayout {
                            x: 14px;
                            y: 7px;
                            width: parent.width - 28px;
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: e.kind == "commit" ? "⎇"
                                    : e.kind == "review" ? "✔" : "💬";
                                color: e.kind == "commit" ? Theme.accent
                                    : e.kind == "review" ? Theme.good : Theme.purple;
                                font-size: 12px;
                                width: 14px;
                                height: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Avatar {
                                login: e.author;
                                size: 20px;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: e.author;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: e.time;
                                        font-size: 11px;
                                        color: Theme.text_dim;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text {
                                    text: e.text;
                                    font-size: 12px;
                                    color: Theme.text_dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Rectangle {
                            x: 14px;
                            y: parent.height - 1px;
                            width: parent.width - 14px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.convo_entries.length == 0: EmptyState {
                    icon: "💬";
                    heading: "暂无会话记录";
                    hint: "提交、评审与评论活动将显示在这里";
                }
            }

            // Checks：名称 + 状态点 + 结论
            if root.current_tab == 2: Rectangle {
                if root.check_runs.length > 0: ListView {
                    for c[i] in root.check_runs: Rectangle {
                        height: 28px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;
                            StatusDot { status: c.conclusion; }
                            Text {
                                text: c.name;
                                font-size: 12px;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: c.conclusion == "success" ? "通过"
                                    : c.conclusion == "failure" ? "失败"
                                    : c.conclusion == "pending" ? "进行中"
                                    : (c.conclusion == "" ? "—" : c.conclusion);
                                font-size: 11px;
                                color: c.conclusion == "success" ? Theme.good
                                    : c.conclusion == "failure" ? Theme.bad
                                    : c.conclusion == "pending" ? Theme.mid
                                    : Theme.text_dim;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            x: 14px;
                            y: parent.height - 1px;
                            width: parent.width - 14px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.check_runs.length == 0: EmptyState {
                    icon: "✓";
                    heading: "暂无 Checks";
                    hint: "这个 PR 还没有关联的 CI 检查记录";
                }
            }

            // Files：路径 + 增删数
            if root.current_tab == 3: Rectangle {
                if root.files.length > 0: ListView {
                    for f[i] in root.files: Rectangle {
                        height: 26px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: f.path;
                                font-family: "Consolas";
                                font-size: 11px;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "+" + f.adds;
                                font-family: "Consolas";
                                font-size: 11px;
                                color: Theme.good;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "-" + f.dels;
                                font-family: "Consolas";
                                font-size: 11px;
                                color: Theme.bad;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            x: 14px;
                            y: parent.height - 1px;
                            width: parent.width - 14px;
                            height: 1px;
                            background: Theme.hairline;
                        }
                    }
                }
                if root.files.length == 0: EmptyState {
                    icon: "📄";
                    heading: "暂无文件变更";
                    hint: "Diff 文件列表将显示在这里";
                }
            }

            // Diff：嵌入真实 DiffView（彩色渲染 + 按文件折叠）
            if root.current_tab == 4: DiffView {
                files: root.diff_files;
                file_toggled(i) => { root.diff_file_toggled(i); }
            }

            if root.current_tab < 0 || root.current_tab > 4: EmptyState {
                icon: "🚧";
                heading: "即将推出";
                hint: "这个标签页还没有实现";
            }
        }

        // ── 底部评论输入占位（只读模式，灰显禁用）──
        Rectangle {
            height: 50px;
            background: Theme.card;
            opacity: 0.65;

            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 1px;
                background: Theme.hairline;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 8px;
                alignment: center;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg;
                    comment_input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        enabled: false;
                        font-size: 12px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if comment_input.text == "": Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: "只读模式，评论功能后续开放";
                        color: Theme.text_dim;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 52px;
                    border-radius: 6px;
                    background: Theme.border.with-alpha(0.5);
                    Text {
                        text: "发送";
                        font-size: 12px;
                        color: Theme.text_dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
