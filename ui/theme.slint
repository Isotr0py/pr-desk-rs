// PR Desk 主题 — GitHub Dark 风格（PR Desk 基准）
// 用法：import { Theme } from "theme.slint";
export global Theme {
    out property <color> bg: #0d1117;
    out property <color> card: #161b22;
    out property <color> border: #30363d;
    out property <color> text: #e6edf3;
    out property <color> text_dim: #8b949e;
    out property <color> accent: #58a6ff;
    out property <color> good: #3fb950;
    out property <color> mid: #d29922;
    out property <color> bad: #f85149;
    out property <color> purple: #bc8cff;
    // 微交互与层次：选中蓝底 / 选中文字 / hover 微亮 / 一级分隔线
    out property <color> sel: #1f6feb;
    out property <color> sel_text: #ffffff;
    out property <color> hover: #ffffff10;
    out property <color> hairline: #21262d;
    // 语义底色（成功/失败 15% 透明度，用于行底/徽章底）
    out property <color> green_bg: #3fb95026;
    out property <color> red_bg: #f8514926;
}
