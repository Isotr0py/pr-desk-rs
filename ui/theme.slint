// PR Desk 主题令牌中心（浅色 / 深色双主题）
//
// 用法：
//   import { Theme } from "theme.slint";
//   颜色一律取 Theme.xxx；切换主题由外层设置 Theme.dark = true/false。
//   字号用 Theme.fs-*，圆角用 Theme.r-*，禁止在组件里写死色值。
export global Theme {
    // 主题开关：false = 浅色（默认），true = 深色
    in-out property <bool> dark: false;
    // 毛玻璃开关：Windows 11 DWM acrylic 成功启用后由 Rust 置 true，底色整体变半透明
    in-out property <bool> glass: false;

    // ── 颜色 ──────────────────────────────────────────────
    // 窗口底色 / 卡片面板 / 次级底（表头等）
    // glass 模式下底色半透明，让 DWM 的模糊背景透出来（卡片保持近不透明保证可读性）
    out property <color> bg: glass ? (dark ? #0d1117b8 : #f6f8fab8) : (dark ? #0d1117 : #f6f8fa);
    out property <color> card: glass ? (dark ? #161b22e0 : #ffffffe0) : (dark ? #161b22 : #ffffff);
    out property <color> surface2: glass ? (dark ? #21262dd0 : #eaeef2d0) : (dark ? #21262d : #eaeef2);
    // 边框与发丝级分隔线（极简风：边框仅用于输入框等必须圈定区域的地方，其余靠底色/hairline 分层）
    out property <color> border: dark ? #2d333b : #dfe5eb;
    out property <color> hairline: dark ? #21262d : #e6ebf0;
    // 文字三级层次：正文 / 次要 / 更弱
    out property <color> text: dark ? #e6edf3 : #1f2328;
    out property <color> text_dim: dark ? #8b949e : #59636e;
    out property <color> text_faint: dark ? #6e7681 : #8c959f;
    // 强调色与状态色
    out property <color> accent: dark ? #58a6ff : #0969da;
    out property <color> good: dark ? #3fb950 : #1a7f37;
    out property <color> mid: dark ? #d29922 : #9a6700;
    out property <color> bad: dark ? #f85149 : #d1242f;
    out property <color> purple: dark ? #bc8cff : #8250df;
    // 选中 / 悬停（极简选中 = accent 浅底 + accent 字；实心 accent 仅留给主按钮）
    out property <color> sel: dark ? #58a6ff24 : #0969da17;
    out property <color> sel_text: dark ? #58a6ff : #0969da;
    out property <color> hover: dark ? #ffffff10 : #00000008;
    // 语义底色（成功 / 失败 / 警告，用于徽章、行底）
    out property <color> green_bg: dark ? #3fb95026 : #1a7f3726;
    out property <color> red_bg: dark ? #f8514926 : #d1242f1a;
    out property <color> yellow_bg: dark ? #d2992226 : #9a670026;

    // ── 字号 ─────────────────────────────────────────────
    out property <length> fs_xs: 11px;
    out property <length> fs_sm: 12px;
    out property <length> fs_md: 13px;
    out property <length> fs_lg: 15px;
    out property <length> fs_xl: 18px;

    // ── 圆角（极简风整体更圆润）─────────────────────────────
    out property <length> r_sm: 6px;
    out property <length> r_md: 8px;
    out property <length> r_lg: 12px;
}
