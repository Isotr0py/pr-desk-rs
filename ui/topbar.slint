// PR Desk — 顶栏与状态栏（macOS 风格）
// TopBar：40px 高，应用名 / macOS 分段控件（滑块 150ms）/ 搜索框 / 图标按钮组（含主题切换）
// StatusBar：24px 高，左侧快捷键提示 · 右侧同步状态 / 配额 / 总数
// 依赖共享契约：theme.slint 的 global Theme（颜色 / 字号 fs_* / 圆角 r_* / dark 开关）
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";

// ── 图标按钮：28×28，hover 底色（120ms），悬停 tooltip ──
// 图标用内嵌 SVG（Image + colorize），不依赖字体字形，避免豆腐块。
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip: "";
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.r_md;
    background: ta.has-hover ? Theme.surface2 : transparent;
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: ta.has-hover ? Theme.text : Theme.text_dim;
    }

    if root.tooltip != "" && ta.has-hover: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 6px;
        width: tip.preferred-width + 14px;
        height: 22px;
        border-radius: Theme.r_md;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.hairline;
        tip := Text {
            text: root.tooltip;
            font-size: Theme.fs_xs;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ── 搜索框：26px 高，surface2 底胶囊形（圆角 = 高/2），无描边，右侧「/」快捷键提示 ──
component SearchBox inherits Rectangle {
    in-out property <string> text;
    callback focus_changed(bool);   // FocusScope 焦点变化（供集成方埋点/联动）
    public function focus_search() { fs.focus(); }   // 全局 / 快捷键调用它聚焦

    height: 26px;
    width: 240px;
    border-radius: self.height / 2;
    background: Theme.surface2;

    fs := FocusScope {
        changed has-focus => { root.focus_changed(self.has-focus); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                input.clear-focus();
                return accept;
            }
            reject
        }

        // 放大镜图标（SVG，避免字体缺字形）
        Image {
            source: @image-url("icons/search.svg");
            x: 10px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            colorize: Theme.text_faint;
        }

        input := TextInput {
            x: 28px;
            width: parent.width - 62px;
            height: parent.height;
            text <=> root.text;
            color: Theme.text;
            font-size: Theme.fs_md;
            vertical-alignment: center;
            single-line: true;
        }

        // 占位提示（无输入时）
        if root.text == "": Text {
            x: 28px;
            width: parent.width - 62px;
            height: parent.height;
            text: I18n.search_placeholder;
            font-size: Theme.fs_md;
            color: Theme.text_faint;
            vertical-alignment: center;
        }

        // 右侧快捷键提示「/」（无边框小胶囊，tint 底）
        Rectangle {
            x: parent.width - 30px;
            y: (parent.height - 18px) / 2;
            width: 20px;
            height: 18px;
            border-radius: self.height / 2;
            background: Theme.hover;
            Text {
                text: "/";
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ── 数据源切换器：数据库图标 + 当前档案名 + 下拉浮层 ──
// "local" 显示 I18n.source_local，其余档案名原样显示；当前项高亮 + 对勾。
// 下拉用 PopupWindow（独立浮层，不会被顶栏/列表裁切或遮挡）。
component SourceSwitcher inherits Rectangle {
    in property <[string]> profile_names: [];
    in-out property <string> active_profile: "local";
    callback switch_profile(string);

    function profile_label(n: string) -> string {
        n == "local" ? I18n.source_local : n
    }

    height: 26px;
    // 宽度 = 图标 12 + 文字 + chevron 10 + 间隙/内边距（显式坐标布局，见下）
    width: name-txt.preferred-width + 52px;
    border-radius: Theme.r_md;
    background: ta.has-hover ? Theme.hover : Theme.surface2;
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // 图标 / 文字 / chevron 全部显式坐标定位：HorizontalLayout 里 Image 的垂直居中
    // 在顶栏这条渲染路径下不可靠（实测图标偏上、下半被裁），绝对定位最稳
    Image {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("icons/database.svg");
        image-fit: contain;
        colorize: ta.has-hover ? Theme.text : Theme.text_dim;
    }
    name-txt := Text {
        x: 26px;
        height: 100%;
        text: root.profile_label(root.active_profile);
        font-size: Theme.fs_sm;
        color: Theme.text;
        vertical-alignment: center;
    }
    Image {
        x: parent.width - 18px;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        source: @image-url("icons/chevron-down.svg");
        image-fit: contain;
        colorize: Theme.text_faint;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(150px, root.width);
        height: root.profile_names.length * 26px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.r_lg;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.hairline;

            VerticalLayout {
                x: 0;
                y: 4px;
                width: 100%;
                spacing: 0;

                for p in root.profile_names: Rectangle {
                    height: 26px;
                    // 当前项优先给 sel 实底（hover 不得盖掉），非当前项给显式 card 底：
                    // PopupWindow 合成路径下 transparent 行底会出现「白纱」发淡
                    background: p == root.active_profile ? Theme.sel
                        : item-ta.has-hover ? Theme.hover : Theme.card;

                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active_profile = p;   // 即时反馈；Rust 拒绝时可回写纠正
                            root.switch_profile(p);
                            popup.close();
                        }
                    }
                    // 当前项对勾：用 visible 控制（colorize: transparent 在部分渲染路径下仍会画出残影）
                    Image {
                        visible: p == root.active_profile;
                        x: 8px;
                        y: (parent.height - 10px) / 2;
                        width: 10px;
                        height: 10px;
                        source: @image-url("icons/check.svg");
                        image-fit: contain;
                        colorize: Theme.sel_text;
                    }
                    Text {
                        x: 24px;
                        width: parent.width - 32px;
                        height: 100%;
                        text: root.profile_label(p);
                        font-size: Theme.fs_sm;
                        color: p == root.active_profile ? Theme.sel_text : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// ── 顶栏 ──
// view_mode: 0 = 列表，1 = Inbox。回调：refresh / sync / open_settings。
export component TopBar inherits Rectangle {
    in-out property <string> filter_text;
    in-out property <int> view_mode: 0;
    callback refresh();
    callback sync();
    callback open_settings();
    // ── 数据源档案（切换器在同步图标左边）──
    in property <[string]> profile_names: [];
    in-out property <string> active_profile: "local";
    callback switch_profile(string);
    // ── 排序 + 高分快筛（列表视图；排序走表头点击，见 PrListView/ListHeader）──
    in-out property <bool> high_score_only: false;   // true = 只看 ≥8.0
    callback high_score_toggled(bool);
    // 图标按钮 tooltip 文案（可覆盖）
    in property <string> refresh_tooltip: I18n.refresh_tooltip;
    in property <string> sync_tooltip: I18n.sync_tooltip;
    in property <string> settings_tooltip: I18n.settings_tooltip;
    // 供全局 / 快捷键调用：聚焦搜索框
    public function focus_search() { search.focus_search(); }

    height: 40px;
    background: Theme.card;

    property <length> seg-w: 64px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;

        // 左：应用名
        Text {
            text: I18n.app_name;
            color: Theme.text;
            font-size: Theme.fs_lg;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // 中：列表 / Inbox 分段控件（macOS 风格：surface2 轨道 + card 白块滑块，无描边）
        Rectangle {
            width: root.seg-w * 2 + 4px;
            height: 24px;
            border-radius: Theme.r_md;
            background: Theme.surface2;

            // 滑块：card 色白块，靠底色与轨道区分层次
            Rectangle {
                x: 2px + root.view_mode * root.seg-w;
                y: 2px;
                width: root.seg-w;
                height: parent.height - 4px;
                border-radius: Theme.r_sm;
                background: Theme.card;
                animate x { duration: 150ms; easing: ease-out; }
            }

            seg-list := TouchArea {
                x: 0;
                width: root.seg-w;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.view_mode = 0; }
            }
            Text {
                x: 0;
                width: root.seg-w;
                height: parent.height;
                text: I18n.tab_list;
                font-size: Theme.fs_sm;
                color: root.view_mode == 0 ? Theme.text
                    : seg-list.has-hover ? Theme.text : Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-inbox := TouchArea {
                x: root.seg-w;
                width: root.seg-w;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.view_mode = 1; }
            }
            Text {
                x: root.seg-w;
                width: root.seg-w;
                height: parent.height;
                text: I18n.tab_inbox;
                font-size: Theme.fs_sm;
                color: root.view_mode == 1 ? Theme.text
                    : seg-inbox.has-hover ? Theme.text : Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // 右：搜索 + 高分快筛 + 排序 + 刷新 / 同步 / 主题 / 设置
        search := SearchBox {
            text <=> root.filter_text;
        }
        // 高分快筛：只看评分 ≥8.0（文本胶囊，选中态 accent 底）
        Rectangle {
            height: 26px;
            width: hs-txt.preferred-width + 18px;
            border-radius: 13px;
            background: root.high_score_only ? Theme.sel : (hs-ta.has-hover ? Theme.hover : transparent);
            animate background { duration: 120ms; }
            hs-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.high_score_only = !root.high_score_only;
                    root.high_score_toggled(root.high_score_only);
                }
            }
            hs-txt := Text {
                height: 100%;
                text: "8+";
                font-size: Theme.fs_sm;
                font-weight: 600;
                color: root.high_score_only ? Theme.sel_text : Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if hs-ta.has-hover: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height + 6px;
                width: hs-tip.preferred-width + 14px;
                height: 22px;
                border-radius: Theme.r_md;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.hairline;
                hs-tip := Text {
                    text: I18n.high_score_tooltip;
                    font-size: Theme.fs_xs;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        IconButton {
            icon: @image-url("icons/refresh.svg");
            tooltip: root.refresh_tooltip;
            clicked => { root.refresh(); }
        }
        // 数据源切换器（本地 / 远程服务器档案）
        SourceSwitcher {
            profile_names: root.profile_names;
            active_profile <=> root.active_profile;
            switch_profile(n) => { root.switch_profile(n); }
        }
        IconButton {
            icon: @image-url("icons/sync.svg");
            tooltip: root.sync_tooltip;
            clicked => { root.sync(); }
        }
        IconButton {
            icon: @image-url("icons/theme.svg");
            tooltip: Theme.dark ? I18n.theme_tooltip_light : I18n.theme_tooltip_dark;
            clicked => { Theme.dark = !Theme.dark; }
        }
        IconButton {
            icon: @image-url("icons/settings.svg");
            tooltip: root.settings_tooltip;
            clicked => { root.open_settings(); }
        }
    }

    // 底部 hairline 分隔
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 状态栏 ──
export component StatusBar inherits Rectangle {
    in property <string> sync_text;    // 如「已同步 2m 前」
    in property <string> quota_text;   // 如「API 剩余 4,037」
    in property <int> total_count;     // PR 总数

    height: 24px;
    background: Theme.card;

    // 顶部 hairline 分隔
    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0;

        // 左：快捷键提示（· 分隔）
        Text {
            text: I18n.statusbar_hints;
            font-size: Theme.fs_xs;
            color: Theme.text_faint;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // 右：同步状态 · API 配额 · PR 总数（8px 间距 + 细分隔点）
        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.sync_text;
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
            Text {
                text: "·";
                font-size: Theme.fs_xs;
                color: Theme.text_faint;
                vertical-alignment: center;
            }
            Text {
                text: root.quota_text;
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
            Text {
                text: "·";
                font-size: Theme.fs_xs;
                color: Theme.text_faint;
                vertical-alignment: center;
            }
            Text {
                text: I18n.statusbar_total_pre + root.total_count + I18n.statusbar_total_post;
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
        }
    }
}
