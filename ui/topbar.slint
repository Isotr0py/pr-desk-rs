// PR Desk — 顶栏与状态栏（macOS 风格）
// TopBar：40px 高，应用名 / macOS 分段控件（滑块 150ms）/ 搜索框 / 图标按钮组（含主题切换）
// StatusBar：24px 高，左侧快捷键提示 · 右侧同步状态 / 配额 / 总数
// 依赖共享契约：theme.slint 的 global Theme（颜色 / 字号 fs_* / 圆角 r_* / dark 开关）
import { Theme } from "theme.slint";

// ── 图标按钮：28×28，hover 底色（120ms），悬停 tooltip ──
// 图标用内嵌 SVG（Image + colorize），不依赖字体字形，避免豆腐块。
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip: "";
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: Theme.r_md;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: ta.has-hover ? Theme.text : Theme.text_dim;
    }

    if root.tooltip != "" && ta.has-hover: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 6px;
        width: tip.preferred-width + 14px;
        height: 22px;
        border-radius: Theme.r_md;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        tip := Text {
            text: root.tooltip;
            font-size: Theme.fs_xs;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// ── 搜索框：26px 高，surface2 底，聚焦时 accent 描边，右侧「/」快捷键提示 ──
component SearchBox inherits Rectangle {
    in-out property <string> text;
    callback focus_changed(bool);   // FocusScope 焦点变化（供集成方埋点/联动）
    public function focus_search() { fs.focus(); }   // 全局 / 快捷键调用它聚焦

    height: 26px;
    width: 240px;
    border-radius: Theme.r_md;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.border;
    background: Theme.surface2;
    animate border-color { duration: 120ms; }

    fs := FocusScope {
        changed has-focus => { root.focus_changed(self.has-focus); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                input.clear-focus();
                return accept;
            }
            reject
        }

        // 放大镜图标（SVG，避免字体缺字形）
        Image {
            source: @image-url("icons/search.svg");
            x: 10px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            colorize: Theme.text_faint;
        }

        input := TextInput {
            x: 28px;
            width: parent.width - 62px;
            height: parent.height;
            text <=> root.text;
            color: Theme.text;
            font-size: Theme.fs_md;
            vertical-alignment: center;
            single-line: true;
        }

        // 占位提示（无输入时）
        if root.text == "": Text {
            x: 28px;
            width: parent.width - 62px;
            height: parent.height;
            text: "搜索 PR…";
            font-size: Theme.fs_md;
            color: Theme.text_faint;
            vertical-alignment: center;
        }

        // 右侧快捷键提示「/」
        Rectangle {
            x: parent.width - 30px;
            y: (parent.height - 18px) / 2;
            width: 20px;
            height: 18px;
            border-radius: Theme.r_sm;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.card;
            Text {
                text: "/";
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ── 顶栏 ──
// view_mode: 0 = 列表，1 = Inbox。回调：refresh / sync / open_settings。
export component TopBar inherits Rectangle {
    in-out property <string> filter_text;
    in-out property <int> view_mode: 0;
    callback refresh();
    callback sync();
    callback open_settings();
    // 图标按钮 tooltip 文案（可覆盖）
    in property <string> refresh_tooltip: "刷新 GitHub";
    in property <string> sync_tooltip: "同步服务器";
    in property <string> settings_tooltip: "设置";
    // 供全局 / 快捷键调用：聚焦搜索框
    public function focus_search() { search.focus_search(); }

    height: 40px;
    background: Theme.card;

    property <length> seg-w: 64px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        // 左：应用名
        Text {
            text: "PR Desk";
            color: Theme.text;
            font-size: Theme.fs_lg;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // 中：列表 / Inbox 分段控件（macOS 风格：surface2 轨道 + card 白块滑块）
        Rectangle {
            width: root.seg-w * 2 + 4px;
            height: 24px;
            border-radius: Theme.r_md;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface2;

            // 滑块：card 色白块 + 1px 描边模拟细微阴影
            Rectangle {
                x: 2px + root.view_mode * root.seg-w;
                y: 2px;
                width: root.seg-w;
                height: parent.height - 4px;
                border-radius: Theme.r_sm;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.border;
                animate x { duration: 150ms; easing: ease-out; }
            }

            seg-list := TouchArea {
                x: 0;
                width: root.seg-w;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.view_mode = 0; }
            }
            Text {
                x: 0;
                width: root.seg-w;
                height: parent.height;
                text: "列表";
                font-size: Theme.fs_sm;
                color: root.view_mode == 0 ? Theme.text
                    : seg-list.has-hover ? Theme.text : Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-inbox := TouchArea {
                x: root.seg-w;
                width: root.seg-w;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.view_mode = 1; }
            }
            Text {
                x: root.seg-w;
                width: root.seg-w;
                height: parent.height;
                text: "Inbox";
                font-size: Theme.fs_sm;
                color: root.view_mode == 1 ? Theme.text
                    : seg-inbox.has-hover ? Theme.text : Theme.text_dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // 右：搜索 + 刷新 / 同步 / 主题 / 设置
        search := SearchBox {
            text <=> root.filter_text;
        }
        IconButton {
            icon: @image-url("icons/refresh.svg");
            tooltip: root.refresh_tooltip;
            clicked => { root.refresh(); }
        }
        IconButton {
            icon: @image-url("icons/sync.svg");
            tooltip: root.sync_tooltip;
            clicked => { root.sync(); }
        }
        IconButton {
            icon: @image-url("icons/theme.svg");
            tooltip: Theme.dark ? "切换到浅色主题" : "切换到深色主题";
            clicked => { Theme.dark = !Theme.dark; }
        }
        IconButton {
            icon: @image-url("icons/settings.svg");
            tooltip: root.settings_tooltip;
            clicked => { root.open_settings(); }
        }
    }

    // 底部 hairline 分隔
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }
}

// ── 状态栏 ──
export component StatusBar inherits Rectangle {
    in property <string> sync_text;    // 如「已同步 2m 前」
    in property <string> quota_text;   // 如「API 剩余 4,037」
    in property <int> total_count;     // PR 总数

    height: 24px;
    background: Theme.card;

    // 顶部 hairline 分隔
    Rectangle {
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0;

        // 左：快捷键提示（· 分隔）
        Text {
            text: "j/k 移动 · Enter 详情 · p 置顶 · 1/2/3 优先级 · / 搜索 · Esc 返回";
            font-size: Theme.fs_xs;
            color: Theme.text_faint;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        // 右：同步状态 · API 配额 · PR 总数（8px 间距 + 细分隔点）
        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.sync_text;
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
            Text {
                text: "·";
                font-size: Theme.fs_xs;
                color: Theme.text_faint;
                vertical-alignment: center;
            }
            Text {
                text: root.quota_text;
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
            Text {
                text: "·";
                font-size: Theme.fs_xs;
                color: Theme.text_faint;
                vertical-alignment: center;
            }
            Text {
                text: "共 " + root.total_count + " 个 PR";
                font-size: Theme.fs_xs;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
        }
    }
}
